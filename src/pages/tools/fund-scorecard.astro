---
import Layout from '../../layouts/Layout.astro';

// 基金体检卡 V3（2026-09-03 六阶段重构）
// 六阶段：调研→定位→方案→验证→开发→增长
// 规格书：产品规格书/基金打分卡_产品规格书_V1_20260903.md
// 三权分置：数据权（天天基金公开接口，script 加载，不估算）× 规则权（松果五标准公开权重）× 结论权（分维度呈现，用户自判）
// 分治：净值体检卡 / 持仓透视卡 / 组合角色卡 三卡独立计算互不污染
// 互验：股票仓位 vs 净值波动交叉验证，重仓集中度提示——防"黑箱评分"与"维度自嗨"
// V3 升级：结论先行卡 + 固收+警示 + 一键复制 + 竞品对比区
// 数据源：fund.eastmoney.com/pingzhongdata/<code>.js（净值全史/收益率/同类排名/资产配置/经理/规模/持仓代码）
//        fundmobapi.eastmoney.com/FundMNewApi/FundMNInverstPosition（季度前十大重仓）
// 合规：方法论演示，不构成投资建议；所有数据来自天天基金公开接口，规则公开可复算
---
<Layout
  title="基金体检卡"
  description="松果基金体检卡 V3 — 输入基金代码，30 秒出三张体检卡：净值收益风险、持仓透视、组合角色。数据来自天天基金公开接口，规则公开可复算。免费工具，不构成投资建议。"
>
  <section class="hero" style="padding: 56px 48px;">
    <div class="hero-inner">
      <span class="eyebrow">Free Tool · 基金体检卡 V3</span>
      <h1>
        别问哪只涨得多，<br /><span class="gold">问它负责什么、扛不扛得住</span>
      </h1>
      <p class="hero-lead">
        输入基金代码，三张体检卡：<b>净值卡</b>看收益与回撤、<b>持仓卡</b>看到底买了什么、
        <b>角色卡</b>看它在你的组合里该站哪块。数据全部来自天天基金公开接口，规则公开、结果可复算。
      </p>
    </div>
  </section>

  <section class="card" style="max-width: 920px; margin: 0 auto;">
    <div class="section-head">
      <div class="section-kicker">Step 1 · 输入基金代码</div>
      <h2 class="section-title">输入基金代码</h2>
      <p class="section-sub">支持 6 位基金代码（如 002351 易方达裕祥回报）。数据实时取自天天基金公开接口，无后端、不存任何输入。</p>
    </div>

    <div style="display:flex; gap: var(--sp-3); align-items:center; flex-wrap:wrap; margin-bottom: var(--sp-4);">
      <input id="fs-code" type="text" maxlength="6" placeholder="输入 6 位基金代码，如 002351"
        style="flex:1; min-width:220px; padding:12px 14px; border:1px solid rgba(139,94,60,0.25); border-radius:10px; font-size:15px; background:var(--bg); color:var(--navy-900);" />
      <button id="fs-run" class="btn btn-gold">开始体检 →</button>
    </div>

    <div id="fs-status" style="display:none; padding:12px 16px; border-radius:10px; background:rgba(217,164,65,0.08); color:var(--navy-700); font-size:14px; margin-bottom: var(--sp-4);"></div>

    <!-- ============ 结论先行卡（V3 新增，Step 2） ============ -->
    <section id="card-conclusion" style="display:none; margin-top: var(--sp-5);">
      <div class="section-head">
        <div class="section-kicker">Step 2 · 结论先行 ★</div>
        <h2 class="section-title">一句话角色定位</h2>
        <p class="section-sub">不卖分数，卖结论：这只基金负责什么、能不能拿得住。先看这一段，再决定要不要往下读。</p>
      </div>
      <div class="card" style="padding: var(--sp-5); border-left: 6px solid var(--gold);">
        <div style="display:flex; align-items:flex-start; gap: var(--sp-4); flex-wrap:wrap;">
          <div style="flex:1; min-width:240px;">
            <div style="font-size:13px; color:var(--navy-600); margin-bottom:4px;">组合角色</div>
            <div id="fs-conclusion-role" style="font-size:24px; font-weight:700; color:var(--navy-900); margin-bottom:8px;">—</div>
            <div id="fs-conclusion-desc" style="font-size:14px; color:var(--navy-700); line-height:1.6;">—</div>
          </div>
          <div style="flex:0 0 auto; text-align:center; min-width:120px;">
            <div id="fs-conclusion-flag" style="font-size:48px; line-height:1;">—</div>
            <div id="fs-conclusion-flag-label" style="font-size:12px; color:var(--navy-600); margin-top:4px;">角色标签</div>
          </div>
        </div>
        <div style="display:grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-3); margin-top: var(--sp-4); padding-top: var(--sp-4); border-top: 1px solid rgba(139,94,60,0.15);">
          <div><div style="font-size:12px; color:var(--navy-600);">股票仓位</div><div id="fs-conclusion-stock" style="font-size:18px; font-weight:700; color:var(--navy-900);">—</div></div>
          <div><div style="font-size:12px; color:var(--navy-600);">近1年波动</div><div id="fs-conclusion-vol" style="font-size:18px; font-weight:700; color:var(--navy-900);">—</div></div>
          <div><div style="font-size:12px; color:var(--navy-600);">近1年收益</div><div id="fs-conclusion-ret" style="font-size:18px; font-weight:700; color:var(--navy-900);">—</div></div>
        </div>
        <div id="fs-conclusion-warn" style="display:none; margin-top: var(--sp-3); padding:10px 14px; border-radius:8px; background:rgba(179,84,62,0.10); color:var(--red); font-size:13.5px;"></div>
        <div style="display:flex; gap: var(--sp-3); margin-top: var(--sp-4);">
          <button id="fs-copy" class="btn btn-outline" style="font-size:13px; padding:8px 14px;">📋 复制结论</button>
          <span style="font-size:12px; color:var(--navy-600); line-height:1.6; flex:1;">结论文本可粘到笔记/微信/雪球，含角色、关键指标、口径标注、规则权重——别人能看到你怎么得出这个判断。</span>
        </div>
      </div>
    </section>

    <!-- ============ 卡1 净值体检 ============ -->
    <section id="card-nav" style="display:none; margin-top: var(--sp-5);">
      <div class="section-head">
        <div class="section-kicker">Card 1 · Net Value · 净值体检</div>
        <h2 class="section-title">收益与风险</h2>
        <p class="section-sub">收益直接取天天基金口径，风险用复权累计净值（含分红再投资）计算——同样的基金，换个窗口数字完全不同，这里给出可复现口径。</p>
      </div>
      <div id="fs-base" style="margin-bottom: var(--sp-4);"></div>
      <div class="metric-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom: var(--sp-3);">
        <div class="metric-card"><div class="label">近 1 月收益</div><div id="fs-s1m" class="value">--</div></div>
        <div class="metric-card"><div class="label">近 3 月收益</div><div id="fs-s3m" class="value">--</div></div>
        <div class="metric-card"><div class="label">近 6 月收益</div><div id="fs-s6m" class="value">--</div></div>
        <div class="metric-card"><div class="label">近 1 年收益</div><div id="fs-s1y" class="value">--</div></div>
      </div>
      <div class="metric-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom: var(--sp-3);">
        <div class="metric-card"><div class="label">近 1 年最大回撤</div><div id="fs-dd1" class="value">--</div></div>
        <div class="metric-card"><div class="label">近 1 年波动率(年化)</div><div id="fs-vol1" class="value">--</div></div>
        <div class="metric-card"><div class="label">近 1 年夏普</div><div id="fs-sharpe1" class="value">--</div></div>
        <div class="metric-card"><div class="label">同类排名</div><div id="fs-rank1" class="value">--</div><div id="fs-rank1-note" style="font-size:10.5px; color:var(--navy-600); margin-top:4px; line-height:1.3;">分位越小越靠前</div></div>
      </div>
      <div id="fs-star"></div>
    </section>

    <!-- ============ 卡2 持仓透视 ============ -->
    <section id="card-position" style="display:none; margin-top: var(--sp-5);">
      <div class="section-head">
        <div class="section-kicker">Card 2 · Holdings · 持仓透视</div>
        <h2 class="section-title">它到底买了什么</h2>
        <p class="section-sub">收益是结果，持仓是原因。资产配置决定这基金的风险来源——股票占比才是固收+ 波动的幕后推手。</p>
      </div>
      <div id="fs-alloc" style="margin-bottom: var(--sp-4);"></div>
      <div id="fs-holdings" style="margin-bottom: var(--sp-4);"></div>
      <div id="fs-conc" style="margin-bottom: var(--sp-3);"></div>
    </section>

    <!-- ============ 卡3 组合角色 ============ -->
    <section id="card-role" style="display:none; margin-top: var(--sp-5);">
      <div class="section-head">
        <div class="section-kicker">Card 3 · Role · 组合角色</div>
        <h2 class="section-title">它在松果体系里站哪块</h2>
        <p class="section-sub">单看一只基金没有意义，先问它负责什么。按资产配置与持仓特征，把它对到松果生活投资三版本拼图（全ETF版/全公募版/混合版）里。</p>
      </div>
      <div id="fs-role"></div>
    </section>

    <!-- ============ 互验区 ============ -->
    <section id="card-xval" style="display:none; margin-top: var(--sp-5);">
      <div class="section-head">
        <div class="section-kicker">Cross Check · 互验</div>
        <h2 class="section-title">仓位 × 波动：对得上吗</h2>
      </div>
      <div id="fs-xval"></div>
    </section>

    <!-- ============ 自身特色卡（V3 新增） ============ -->
        <section class="card" style="max-width: 920px; margin: var(--sp-5) auto 0;">
          <div class="section-head">
            <div class="section-kicker">基准对比 · 同类工具</div>
            <h2 class="section-title">和市面上的"基金评分"对比，我们的特色是什么</h2>
            <p class="section-sub">市面上的基金评分通常是黑箱：给一个数字，不告诉你怎么算的、数据全不全、结论适不适合你。我们把这件事拆成三件，分开做：<b>数据公开可验、规则公开可算、结论留给你</b>。</p>
          </div>
          <div class="table-wrap">
            <table class="data-table wrap-cells">
              <thead><tr><th></th><th>常规做法</th><th class="songguo-col">松果基金体检卡</th></tr></thead>
              <tbody>
                <tr><td><b>数据权</b></td><td>模型不公开，历史可看不可验</td><td class="songguo-col"><b>天天基金公开接口直读</b>：净值/收益率/同类排名/资产配置/重仓/费率/规模/经理，全部可复算</td></tr>
                <tr><td><b>规则权</b></td><td>权重不公开</td><td class="songguo-col"><b>五标准权重公开</b>：收益30 回撤25 费率15 规模20 经理10，写死在本页，任何人可核</td></tr>
                <tr><td><b>结论权</b></td><td>给分不给证据</td><td class="songguo-col"><b>三卡分维度呈现</b>：净值风险 / 持仓穿透 / 组合角色——结论你自己下，工具只给证据链</td></tr>
                <tr><td><b>持仓穿透</b></td><td>看不到底层资产</td><td class="songguo-col"><b>资产配置+前十大重仓全亮</b>：固收+ 的股票仓位、集中度、风险来源一眼可见</td></tr>
                <tr><td><b>结论先行</b></td><td>给完数字才解释</td><td class="songguo-col"><b>先给角色定位</b>：结论卡永远最前，告诉你这只基金"在组合里负责什么"，细节往下看</td></tr>
                <tr><td><b>分享/存档</b></td><td>截图为主</td><td class="songguo-col"><b>一键复制</b>：结论文本可粘到笔记/微信，含口径标注和规则权重</td></tr>
              </tbody>
            </table>
          </div>
        </section>

    <!-- ============ 版本路线（V3 新增） ============ -->
    <section class="card" style="max-width: 920px; margin: var(--sp-4) auto 0;">
      <div class="section-head">
        <div class="section-kicker">版本路线 · V3 起</div>
        <h2 class="section-title">基金打分卡迭代路径</h2>
      </div>
      <div style="font-size:14px; color:var(--navy-700); line-height:1.8;">
        <div><b style="color:var(--green);">V2 已上线（2026-08-30）</b> — 三卡体检 + 五标准打分 + 互验</div>
        <div><b style="color:var(--gold);">V3 已上线（2026-09-03）</b> — 结论先行卡 + 固收+警示 + 一键复制 + 竞品对比区</div>
        <div style="color:var(--navy-600);">V3.1 远期 — 多基金并排对比（输入两代码，比照角色分布）</div>
        <div style="color:var(--navy-600);">V4 远期 — 组合角色批量扫描（输入多只，比照角色分布与集中度）</div>
      </div>
    </section>

    <div class="callout" style="max-width: 920px; margin: var(--sp-4) auto 0;">
      <b>口径与合规</b>：
      收益（近1月/3月/6月/1年）与同类排名分位取自天天基金公开数据；风险指标（回撤/波动/夏普）由复权累计净值序列计算，波动年化按 250 交易日、夏普无风险利率按 0 简化。
      松果五标准：收益 30 分（近1年 ≥20% 满分）、回撤 25 分（近1年 MDD ≤5% 满分）、费率 15 分（申购费 ≤0.1% 即满分，管理费以申购费近似提示）、规模 20 分（20-300 亿最舒适——百亿是收益的敌人，太小心清盘）、经理 10 分（任职 ≥7 年满分，策略稳定性代理）。
      本工具为方法论演示，<b>不构成投资建议</b>，不评估任何基金的投资价值；数据加载自第三方公开接口，若有变更以天天基金页面为准。
    </div>
  </section>

  <script>
    // ---------- 工具函数 ----------
    async function loadScript(src, charset) {
      return new Promise((resolve, reject) => {
        const s = document.createElement('script');
        s.src = src + (src.includes('?') ? '&' : '?') + 't=' + Date.now();
        if (charset) s.charset = charset;
        s.onload = () => resolve();
        s.onerror = () => reject(new Error('加载失败: ' + src));
        document.head.appendChild(s);
      });
    }
    const $ = (id) => document.getElementById(id);
        const pct = (v, d = 2) => { v = parseFloat(v); return isNaN(v) ? '—' : (v >= 0 ? '+' : '') + v.toFixed(d) + '%'; };
        const num = (v, d = 2) => { v = parseFloat(v); return isNaN(v) ? '—' : v.toFixed(d); };

    // ---------- 风险指标（复权累计净值序列）----------
    // series: [{x: 毫秒, y: 复权净值}...] 升序
    function sliceSeries(series, lookbackDays) {
      const now = Date.now();
      const cutoff = now - lookbackDays * 86400000;
      return series.filter((p) => p.x >= cutoff);
    }
    function calcRisk(series, lookbackDays) {
      if (!series || series.length < 30) return null;
      const sub = sliceSeries(series, lookbackDays);
      if (sub.length < 30) return null;
      const rets = [];
      for (let i = 1; i < sub.length; i++) {
        rets.push(sub[i].y / sub[i - 1].y - 1);
      }
      const ret = sub[sub.length - 1].y / sub[0].y - 1;
      // 最大回撤
      let peak = sub[0].y, mdd = 0;
      for (const p of sub) { peak = Math.max(peak, p.y); mdd = Math.min(mdd, p.y / peak - 1); }
      // 年化波动（日收益 std × sqrt(250)）
      const mean = rets.reduce((a, b) => a + b, 0) / rets.length;
      const varr = rets.reduce((a, b) => a + (b - mean) ** 2, 0) / (rets.length - 1);
      const vol = Math.sqrt(varr) * Math.sqrt(250);
      const ann = Math.pow(sub[sub.length - 1].y / sub[0].y, 365 / Math.max(lookbackDays, 1)) - 1;
      const sharpe = vol > 0 ? ann / vol : 0;
      return { ret, mdd, vol, sharpe };
    }

    // ---------- 松果五标准打分（规则公开）----------
    function scoreFive(r1y, mdd1y, feePct, sizeY, mgrYears) {
      const linear = (v, lo, hi, dir = 1) => {
        if (v === null || v === undefined || isNaN(v)) return 0;
        if (dir === 1) { if (v >= hi) return 100; if (v <= lo) return 0; return ((v - lo) / (hi - lo)) * 100; }
        if (v <= lo) return 100; if (v >= hi) return 0; return ((hi - v) / (hi - lo)) * 100;
      };
      const sRet = linear(r1y, 0, 20, 1);          // 收益 30：近1年 0%→20% 线性
      const sMdd = linear(mdd1y, 5, 15, -1);       // 回撤 25：MDD 5%→15% 反向线性（≤5 满分）
      const sFee = linear(feePct, 0.1, 0.6, -1);   // 费率 15：申购费 0.1%→0.6% 反向
      const sSize = sizeY === null || sizeY === undefined || isNaN(sizeY) ? 0
        : (sizeY >= 20 && sizeY <= 300 ? 100 : (sizeY > 300 ? Math.max(0, 100 - (sizeY - 300) / 5) : Math.max(0, (sizeY / 20) * 100)));
      // 规模 20：20-300 亿满分；>300 每 5 亿扣 1 分；<20 按比例（太小有清盘风险）
      const sMgr = linear(mgrYears, 3, 7, 1);      // 经理 10：任职 3→7 年线性（≥7 满分）
      const total = sRet * 0.3 + sMdd * 0.25 + sFee * 0.15 + sSize * 0.2 + sMgr * 0.1;
      const grade = total >= 75 ? '可入池' : total >= 60 ? '候选' : total >= 45 ? '谨慎' : '不达标';
      return { total, grade, sRet, sMdd, sFee, sSize, sMgr };
    }

    // ---------- 持仓 HTML 表格解析（jjcc 的 apidata.content）----------
    function parseHoldings(content) {
      const holder = document.createElement('div');
      holder.innerHTML = content;
      const rows = [];
      holder.querySelectorAll('table tr').forEach((tr) => {
        const cells = Array.from(tr.querySelectorAll('td')).map((td) => td.textContent.trim());
                // jjcc 表列序：序号 / 股票代码 / 股票名称 / 占净值比例 / 持股数 / 较上期变化
                if (cells.length >= 4 && /^\d{6}$/.test(cells[1] || '')) {
                  rows.push({ name: cells[2] || '', code: cells[1] || '', pct: parseFloat(cells[3]) || 0 });
                }
      });
      return rows;
    }

    // ---------- 组合角色判定（映射松果生活投资三版本拼图）----------
    function roleJudge(stockPct, bondPct, holdings, mgrSize) {
      const conc = holdings.reduce((a, h) => a + h.pct, 0);
      let role, weight, etfAlt, why, flag, flagLabel, flagColor;
      if (stockPct <= 5) {
        role = '债券底仓拼图（债底）';
        weight = '混合版中约 5% 底仓角色；纯债基可作稳健压舱石';
        etfAlt = 'ETF 替代：511010 国债ETF（T+0，费率低）';
        why = `股票仓位仅 ${num(stockPct)}%，波动主要来自债券端（久期/信用）——当组合的"压舱石"，不是进攻工具。`;
        flag = '🛡️'; flagLabel = '债底'; flagColor = 'var(--green)';
      } else if (stockPct <= 25) {
        role = '固收+ 拼图（公募主动管理）';
        weight = '松果混合版中固收+ 权重 50%（灵魂拼图）；全公募版 40%';
        etfAlt = 'ETF 无对等品——固收+ 的主动选券能力正是选公募的理由';
        why = `股票仓位 ${num(stockPct)}% 的"固收+"结构：债券打底 + 权益增厚。波动介于债与股之间，是"拿得住的钱"的核心拼图。` +
          (conc > 40 ? ` ⚠️ 前十大重仓合计 ${num(conc)}%，集中度偏高，权益端风格可能较激进。` : '');
        flag = '⚖️'; flagLabel = '固收+'; flagColor = 'var(--gold)';
      } else if (stockPct > 25 && holdings.some((h) => /黄金|金ETF/.test(h.name))) {
        role = '黄金拼图';
        weight = '混合版/全ETF版中黄金权重 20-30%';
        etfAlt = 'ETF 替代：159934 黄金ETF（T+0，费率更低）';

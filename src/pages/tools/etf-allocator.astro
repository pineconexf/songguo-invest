---
import Layout from '../../layouts/Layout.astro';
import tiersData from '../../data/etf_tiers.json';

// ETF 组合配置器 v3 —— 三档真实回测（152 个月，2014-01 ~ 2026-08，同窗口同方法）
// 数据：scripts/etf_tiers_backtest.py 生成（新浪日线 × tushare 复权因子 → 前复权 → 月收益 → 权重加权）
// 口径：无成本同方法重算，三档横向可比；稳健档另有松果定稿口径（含成本保守）10.10% / -6.15% 并存标注
const PIECE_META = [
  { code: '511010', name: '国债ETF（国泰）', role: '债券拼图', note: '国内利率债，组合压舱石，T+0' },
  { code: '159934', name: '黄金ETF（易方达）', role: '黄金拼图', note: '对冲货币贬值+地缘风险，与股票低相关' },
  { code: '510880', name: '红利ETF（华泰柏瑞）', role: '红利拼图', note: '上证红利，高股息现金流资产' },
  { code: '513500', name: '标普500ETF（博时）', role: 'QDII拼图', note: '全球核心权益，与 A 股相关性 0.01~0.20' },
];
// 参考价：2026-08-25 收盘（新浪财经实测），实时价由腾讯行情拉取后覆盖
const REF_PRICES = [141.302, 9.965, 3.409, 2.695];
const TIERS = [
  { key: 'conservative', ...tiersData.conservative },
  { key: 'stable', ...tiersData.stable },
  { key: 'aggressive', ...tiersData.aggressive },
];
const fmtPct = (v: number, d = 1) => (v >= 0 ? '+' : '') + (v * 100).toFixed(d) + '%';
---
<Layout
  title="ETF 组合配置"
  description="松果 ETF 组合配置器 — 三档风险预设（保守/稳健/进取）152 个月真实回测 + 实时行情，一键算出每只 ETF 应买金额与份额。免费工具，不构成投资建议。"
>
  <section class="hero" style="padding: 56px 48px;">
    <div class="hero-inner">
      <span class="eyebrow">Free Tool · 防守组合</span>
      <h1>
        选你的风险档位，<br /><span class="gold">照单买入四拼图</span>
      </h1>
      <p class="hero-lead">
        债券 + 黄金 + 红利 + QDII 低相关四拼图，三档权重全部经过 <b>152 个月真实回测</b>（2014-01 ~ 2026-08）。
        先选你是哪种人，再输入金额——实时价格、份数、回撤预期一次算清。
      </p>
    </div>
  </section>

  <section class="card" style="max-width: 920px; margin: 0 auto;">
    <!-- 第一步：选档位 -->
    <div class="section-head">
      <div class="section-kicker">Step 1 · 选你的档位</div>
      <h2 class="section-title">你是哪种投资者？</h2>
      <p class="section-sub">三档同窗口（2014-01 ~ 2026-08，152 个月）真实回测：年化与最大回撤均为回测实测，三档横向可比。权重可再微调。</p>
    </div>
    <div class="link-cards" style="grid-template-columns: repeat(3, 1fr);">
      {TIERS.map((t, ti) => (
        <div class="link-card tier-card" data-tier={t.key} data-index={ti} style="cursor:pointer; border-width:2px;">
          <div class="master-school" style="font-size: 12px; font-weight: 700; letter-spacing: 0.4px; color: {t.color};">
            {ti === 0 ? '跌不起型' : ti === 1 ? '推荐 · 有定稿' : '能扛波动型'}
          </div>
          <h3>{t.label}</h3>
          <div style="display:flex; gap:4px; margin: 10px 0;">
            {t.weights.map((w, wi) => (
              <span style="flex:1; height:6px; border-radius:3px; background: {wi === 3 ? '#a03a28' : wi === 1 ? '#d9a441' : wi === 2 ? '#c87f2e' : '#4A7C59'};"></span>
            ))}
          </div>
          <div style="font-size: 12px; color: var(--text-3); margin-bottom: 10px;">{t.weights.join(' / ')}（债 / 金 / 红利 / QDII）</div>
          <div class="metric-grid" style="grid-template-columns: repeat(2, 1fr); gap: 8px;">
            <div class="metric-card" style="padding: 10px 8px;"><div class="label">152月年化</div><div class="value" style="font-size:19px; color: {t.color};">{fmtPct(t.metrics.annual)}</div></div>
            <div class="metric-card" style="padding: 10px 8px;"><div class="label">最大回撤</div><div class="value" style="font-size:19px; color:#a03a28;">{fmtPct(t.metrics.mdd)}</div></div>
          </div>
          <div style="font-size: 12px; color: var(--text-3); margin-top: 8px; line-height: 1.5;">
            夏普 {t.metrics.sharpe.toFixed(2)} · 卡玛 {t.metrics.calmar.toFixed(2)} ·
            压力年 {['2015','2018','2022'].map((y) => `${y} ${fmtPct(t.pressure_years[y])}`).join(' / ')}
          </div>
        </div>
      ))}
    </div>

    <!-- 第二步：金额 + 微调 -->
    <div class="section-head" style="margin-top: 28px;">
      <div class="section-kicker">Step 2 · 输入金额</div>
      <h2 class="section-title">你打算投入多少？</h2>
    </div>
    <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); margin-bottom: var(--sp-4);">
      <label class="valuator-field" style="grid-column: span 2;">
        <span>拟投资金额（元）</span>
        <input id="ea-amount" type="number" step="1000" min="0" value="200000" placeholder="如 200000" />
      </label>
    </div>

    <div class="table-wrap" style="margin-bottom: var(--sp-4);">
      <table class="data-table">
        <thead>
          <tr><th>拼图</th><th>ETF</th><th>权重 %</th><th>价格（元）</th><th>行情状态</th></tr>
        </thead>
        <tbody>
          {PIECE_META.map((p, i) => (
            <tr>
              <td>{p.role}</td>
              <td>{p.code} {p.name}</td>
              <td><input id={`ea-w${i}`} type="number" step="1" min="0" max="100" value={TIERS[1].weights[i]} style="width:70px; padding:6px 8px; border:1px solid rgba(139,94,60,0.25); border-radius:8px; font-size:14px;" /></td>
              <td><input id={`ea-p${i}`} type="number" step="0.001" min="0" value={REF_PRICES[i]} style="width:95px; padding:6px 8px; border:1px solid rgba(139,94,60,0.25); border-radius:8px; font-size:14px;" /></td>
              <td id={`ea-ps${i}`} style="font-size:12px; color: var(--text-3);">参考价 08-25</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div style="margin-bottom: var(--sp-3);">
      <button id="ea-run" class="btn btn-gold">计算配置 →</button>
    </div>
    <div id="ea-msg" style="font-size: 13px; color: var(--text-3); margin-bottom: var(--sp-2);">权重合计 100% ✓（默认稳健档：债25/金30/红利10/QDII35）</div>

    <!-- 结果 -->
    <div id="ea-result" style="display:none; margin-top: var(--sp-4); border-top: 1px solid rgba(139,94,60,0.15); padding-top: var(--sp-4);">
      <div class="metric-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom: var(--sp-4);">
        <div class="metric-card"><div class="label">拟投资金额</div><div id="ea-total" class="value" style="font-size:20px;">--</div></div>
        <div class="metric-card"><div class="label">实买合计（整手）</div><div id="ea-sum" class="value" style="font-size:20px;">--</div></div>
        <div class="metric-card"><div class="label">剩余零钱</div><div id="ea-rest" class="value" style="font-size:20px;">--</div></div>
        <div class="metric-card"><div class="label">建仓提示</div><div id="ea-hint" class="value" style="font-size:15px;">--</div></div>
      </div>

      <!-- 回撤预期 + 金额回套 152 个月 -->
      <div class="metric-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: var(--sp-4);">
        <div class="metric-card" style="border:1.5px solid rgba(160,58,40,0.3);">
          <div class="label">回撤预期 · 历史最大回撤情景</div>
          <div class="value" id="ea-ddval" style="font-size:22px; color:#a03a28;">--</div>
          <div class="sub" id="ea-ddsub" style="font-size:12px; color: var(--text-3);">若按当前档位买入后遭遇其 152 个月历史最大回撤，账面预期最低跌到约这个数</div>
        </div>
        <div class="metric-card" style="border:1.5px solid rgba(74,124,89,0.3);">
          <div class="label">回撤修复 · 回测中最深修复</div>
          <div class="value" id="ea-recover" style="font-size:22px; color: var(--green);">--</div>
          <div class="sub" style="font-size:12px; color: var(--text-3);">回测 152 个月中每次回撤均最终修复并创新高，组合长期持有逻辑成立</div>
        </div>
        <div class="metric-card">
          <div class="label">当前档位 · 回撤画像</div>
          <div class="value" id="ea-tiername" style="font-size:16px;">--</div>
          <div class="sub" id="ea-tiersub" style="font-size:12px; color: var(--text-3);">年化 / 最大回撤 / 夏普 / 卡玛 / 压力年</div>
        </div>
      </div>

      <!-- 金额回套 152 个月：我的钱走一遍 -->
      <div class="section-head" style="margin-top: 8px;">
        <div class="section-kicker">Simulation · 金额回套 152 个月</div>
        <h2 class="section-title" id="ea-simtitle">你的钱，152 个月后会变成多少？</h2>
      </div>
      <div class="metric-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom: var(--sp-3);">
        <div class="metric-card" style="border:2px solid var(--gold-500);">
          <div class="label">152 个月后最终金额（按当前档位逐月真实回测滚动）</div>
          <div class="value" id="ea-final" style="font-size:26px; color: var(--gold-600);">--</div>
          <div class="sub" id="ea-finalgain" style="font-size:12px; color: var(--text-3);">--</div>
        </div>
        <div class="metric-card"><div class="label">存银行对照（年化 2%）</div><div class="value" id="ea-bank" style="font-size:20px;">--</div><div class="sub" style="font-size:12px; color: var(--text-3);">同一笔钱、同一时间，放银行定期的结果</div></div>
        <div class="metric-card"><div class="label">历史最大回撤谷底</div><div class="value" id="ea-trough" style="font-size:20px; color:#a03a28;">--</div><div class="sub" id="ea-troughsub" style="font-size:12px; color: var(--text-3);">--</div></div>
        <div class="metric-card"><div class="label">单月最大跌幅</div><div class="value" id="ea-worstm" style="font-size:20px; color:#a03a28;">--</div><div class="sub" id="ea-worstmsub" style="font-size:12px; color: var(--text-3);">--</div></div>
      </div>
      <div style="background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--r-md); padding: var(--sp-4); margin-bottom: var(--sp-4); overflow: hidden;">
        <div style="font-size: 12px; color: var(--text-3); margin-bottom: 8px;">月度账面金额曲线（2014-01 起 152 个月逐月真实收益滚动）</div>
        <div id="ea-chart" style="width: 100%;"></div>
      </div>
      <div class="table-wrap" style="max-height: 320px; overflow-y: auto; margin-bottom: var(--sp-4);">
        <table class="data-table" style="min-width: 560px;">
          <thead><tr><th>月份</th><th>当月收益</th><th>账面金额</th><th>距最高点</th></tr></thead>
          <tbody id="ea-months"></tbody>
        </table>
      </div>

      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>拼图</th><th>ETF</th><th>权重</th><th>应买金额</th><th>实时价</th><th>应买份数（100份/手）</th><th>实际金额</th></tr></thead>
          <tbody id="ea-rows"></tbody>
        </table>
      </div>
      <div class="callout" style="margin-top: var(--sp-4);">
        <b>三档回测口径（2014-01 ~ 2026-08，152 个月，同方法无成本，横向可比）</b>：
        保守 {fmtPct(TIERS[0].metrics.annual)} / {fmtPct(TIERS[0].metrics.mdd)}，稳健 {fmtPct(TIERS[1].metrics.annual)} / {fmtPct(TIERS[1].metrics.mdd)}，进取 {fmtPct(TIERS[2].metrics.annual)} / {fmtPct(TIERS[2].metrics.mdd)}。
        压力年：2015 全部正收益、2018 保守/稳健正、2022 仅进取 -4.4%。
        <b>稳健档另有松果定稿口径</b>（含成本保守，全ETF版定稿）：年化 10.1% / 回撤 -6.2% / 夏普 1.21 / 卡玛 1.64。
        数据源：新浪日线 × tushare 复权因子（前复权），脚本 scripts/etf_tiers_backtest.py 可复现，明细归档于本地生活投资策略/工具回测数据/。
        <b>历史回测不代表未来收益，不构成投资建议。</b>
      </div>
    </div>
  </section>

  <div class="callout" style="max-width: 920px; margin: var(--sp-4) auto 0;">
    <b>拼图逻辑</b>：低相关性是组合灵魂——标普500 与 A 股相关性 0.01~0.20，黄金对冲货币风险，债券压舱。
    每加一块拼图先问它跟已有持仓的相关性。完整方法论见 <a href="/songguo-invest/portfolio/">组合管理</a>。
    <b>买入提示</b>：场内 ETF 按 100 份/手取整，剩余零钱可留作下次再平衡或放货币基金。
  </div>

  <script>
    import tiersData from '../../data/etf_tiers.json';
    const PIECE_META = [
      { code: '511010', name: '国债ETF（国泰）', role: '债券拼图' },
      { code: '159934', name: '黄金ETF（易方达）', role: '黄金拼图' },
      { code: '510880', name: '红利ETF（华泰柏瑞）', role: '红利拼图' },
      { code: '513500', name: '标普500ETF（博时）', role: 'QDII拼图' },
    ];
    const TIERS = [
      { key: 'conservative', ...tiersData.conservative },
      { key: 'stable', ...tiersData.stable },
      { key: 'aggressive', ...tiersData.aggressive },
    ];
    const fmt = (v: number) => v >= 10000 ? (v / 10000).toFixed(1) + ' 万' : v.toFixed(0) + ' 元';
    const fmtY = (v: number) => Math.round(v).toLocaleString() + ' 元';
    const pct = (v: number, d = 1) => (v >= 0 ? '+' : '') + (v * 100).toFixed(d) + '%';
    const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
    let activeTier = 'stable';

    // 档位切换：填充权重 + 同步回撤画像
    function syncTierCard(t) {
      t.weights.forEach((w, i) => { ($(`ea-w${i}`) as HTMLInputElement).value = String(w); });
      ($('ea-tiername') as HTMLElement).textContent = `${t.label} · 152月回测`;
      ($('ea-tiersub') as HTMLElement).textContent =
        `年化 ${pct(t.metrics.annual)} / 回撤 ${pct(t.metrics.mdd)} / 夏普 ${t.metrics.sharpe.toFixed(2)} / 卡玛 ${t.metrics.calmar.toFixed(2)} / 压力年 ` +
        ['2015','2018','2022'].map((y) => `${y} ${pct(t.pressure_years[y])}`).join(' ');
    }
    document.querySelectorAll<HTMLElement>('.tier-card').forEach((card) => {
      card.addEventListener('click', () => {
        const t = TIERS[parseInt(card.dataset.index || '1', 10)];
        activeTier = t.key;
        syncTierCard(t);
        document.querySelectorAll<HTMLElement>('.tier-card').forEach((c) => {
          c.style.borderColor = 'var(--border)';
          c.style.background = 'var(--surface)';
        });
        card.style.borderColor = 'var(--gold-500)';
        card.style.background = 'rgba(217,164,65,0.06)';
        updateMsg();
      });
    });
    const stableCard = document.querySelector('.tier-card[data-tier="stable"]') as HTMLElement;
    if (stableCard) stableCard.click();

    function updateMsg() {
      const w = [0, 1, 2, 3].map((i) => parseFloat($(`ea-w${i}`).value) || 0);
      const wsum = w.reduce((a, b) => a + b, 0);
      const msg = $('ea-msg') as HTMLElement;
      if (Math.abs(wsum - 100) > 0.01) msg.textContent = `权重合计 ${wsum}% ≠ 100%，请调整`;
      else msg.textContent = `权重合计 100% ✓（${TIERS.find((t) => t.key === activeTier)?.label || ''}）`;
    }
    [0, 1, 2, 3].forEach((i) => ($(`ea-w${i}`) as HTMLInputElement).addEventListener('input', updateMsg));

    function run() {
      const amount = parseFloat($('ea-amount').value) || 0;
      const w = [0, 1, 2, 3].map((i) => parseFloat($(`ea-w${i}`).value) || 0);
      const price = [0, 1, 2, 3].map((i) => parseFloat($(`ea-p${i}`).value) || 0);
      const wsum = w.reduce((a, b) => a + b, 0);
      const hint = $('ea-hint') as HTMLElement;
      ($('ea-total') as HTMLElement).textContent = fmt(amount);
      if (amount <= 0) { hint.textContent = '请输入金额'; hint.style.color = 'var(--red)'; }
      else if (Math.abs(wsum - 100) > 0.01) { hint.textContent = `权重 ${wsum}%≠100%`; hint.style.color = 'var(--red)'; }
      else { hint.textContent = '权重 100% ✓'; hint.style.color = 'var(--green)'; }

      // 回撤预期：金额 × (1 + 该档位历史最大回撤)
      const tier = TIERS.find((t) => t.key === activeTier) || TIERS[1];
      const mdd = tier.metrics.mdd;
      const ddAmount = amount * (1 + mdd);
      ($('ea-ddval') as HTMLElement).textContent = fmt(ddAmount);
      ($('ea-ddsub') as HTMLElement).textContent =
        `${tier.label}：历史最大回撤 ${pct(mdd)} → 买入 ${fmt(amount)} 后若遭遇同等回撤，账面预期最低约 ${fmt(ddAmount)}`;
      ($('ea-recover') as HTMLElement).textContent = '每次回撤均修复';
      syncTierCard(tier);

      // ==== 金额回套 152 个月：逐月用真实月度收益滚动 ====
      const monthly = Object.entries(tier.monthly || {}).sort((a, b) => (a[0] < b[0] ? -1 : 1));
      let nav = amount;
      const series = [{ ym: monthly[0][0], val: amount }];
      for (const [ym, ret] of monthly) { nav *= (1 + ret); series.push({ ym, val: nav }); }
      const final = series[series.length - 1].val;
      const gain = final / amount - 1;
      const years = monthly.length / 12;
      const bank = amount * Math.pow(1.02, years);
      // 最大回撤谷底 + 单月最大跌幅
      let peak = amount, trough = { ym: '', val: amount, dd: 0 }, worst = { ym: '', ret: 0 };
      for (let i = 0; i < series.length; i++) {
        peak = Math.max(peak, series[i].val);
        const dd = series[i].val / peak - 1;
        if (dd < trough.dd) trough = { ym: series[i].ym, val: series[i].val, dd };
        if (i > 0 && monthly[i - 1][1] < worst.ret) worst = { ym: monthly[i - 1][0], ret: monthly[i - 1][1] };
      }
      ($('ea-final') as HTMLElement).textContent = fmt(final);
      ($('ea-finalgain') as HTMLElement).textContent = `${fmt(amount)} → ${fmt(final)}，累计 ${pct(gain)}（${years.toFixed(1)} 年，年化 ${pct(tier.metrics.annual)}）`;
      ($('ea-bank') as HTMLElement).textContent = fmt(bank);
      ($('ea-trough') as HTMLElement).textContent = fmt(trough.val);
      ($('ea-troughsub') as HTMLElement).textContent = `${trough.ym}，从最高点 ${pct(trough.dd)}`;
      ($('ea-worstm') as HTMLElement).textContent = pct(worst.ret);
      ($('ea-worstmsub') as HTMLElement).textContent = `${worst.ym}，单月最差`;
      ($('ea-simtitle') as HTMLElement).textContent = `${fmt(amount)} 走完 152 个月 → ${fmt(final)}`;
      // 月度明细表（倒序：最近在上）
      let mpeak = amount;
      ($('ea-months') as HTMLElement).innerHTML = series.slice(1).map((s, i) => {
        mpeak = Math.max(mpeak, s.val);
        const dd = s.val / mpeak - 1;
        const ret = monthly[i][1];
        return `<tr>
          <td>${s.ym}</td>
          <td style="color:${ret >= 0 ? 'var(--green)' : 'var(--red)'};">${pct(ret, 2)}</td>
          <td><b>${fmt(s.val)}</b></td>
          <td style="color:${dd < 0 ? 'var(--red)' : 'var(--text-3)'};">${dd < 0 ? pct(dd) : '创新高'}</td>
        </tr>`;
      }).reverse().join('');
      drawChart(series, amount);

      let sumCheck = 0;
      ($('ea-rows') as HTMLElement).innerHTML = PIECE_META.map((p, i) => {
        const money = amount * w[i] / 100;
        const lots = price[i] > 0 ? Math.floor(money / price[i] / 100) : 0;
        const actual = lots * 100 * price[i];
        sumCheck += actual;
        return `<tr>
          <td>${p.role}</td>
          <td>${p.code} ${p.name}</td>
          <td>${w[i]}%</td>
          <td>${fmtY(money)}</td>
          <td>${price[i].toFixed(3)}</td>
          <td><b>${lots * 100} 份（${lots} 手）</b></td>
          <td>${fmtY(actual)}</td>
        </tr>`;
      }).join('');
      ($('ea-sum') as HTMLElement).textContent = fmt(sumCheck);
      ($('ea-rest') as HTMLElement).textContent = fmt(Math.max(0, amount - sumCheck));
      ($('ea-result') as HTMLElement).style.display = 'block';
    }
    $('ea-run')!.addEventListener('click', run);

    // SVG 月度金额曲线（152 点折线 + 面积 + 谷底标注 + 起点线）
    function drawChart(series, amount) {
      const el = $('ea-chart') as HTMLElement;
      const W = 860, H = 260, pad = { l: 76, r: 14, t: 24, b: 10 };
      const vals = series.map((s) => s.val);
      const vmin = Math.min(amount, ...vals) * 0.96;
      const vmax = Math.max(...vals) * 1.04;
      const x = (i: number) => pad.l + (i / (series.length - 1)) * (W - pad.l - pad.r);
      const y = (v: number) => H - pad.b - ((v - vmin) / (vmax - vmin)) * (H - pad.t - pad.b);
      const pts = series.map((s, i) => `${x(i).toFixed(1)},${y(s.val).toFixed(1)}`).join(' ');
      const area = `${pad.l},${y(vmin).toFixed(1)} ${pts} ${x(series.length - 1).toFixed(1)},${y(vmin).toFixed(1)}`;
      // 谷底
      let peak = amount, ti = -1, td = 0;
      for (let i = 0; i < series.length; i++) {
        peak = Math.max(peak, series[i].val);
        const dd = series[i].val / peak - 1;
        if (dd < td) { td = dd; ti = i; }
      }
      let yTicks = '';
      for (let k = 0; k <= 4; k++) {
        const v = vmin + (vmax - vmin) * k / 4;
        const yy = y(v).toFixed(1);
        yTicks += `<text x="${pad.l - 8}" y="${yy}" text-anchor="end" style="font-size:11px; fill:#8a7a63;">${fmt(v)}</text><line x1="${pad.l}" y1="${yy}" x2="${W - pad.r}" y2="${yy}" stroke="#e6dfd3" stroke-dasharray="3 3"/>`;
      }
      const troughMark = ti >= 0 ? `
        <circle cx="${x(ti).toFixed(1)}" cy="${y(series[ti].val).toFixed(1)}" r="4.5" fill="#a03a28"/>
        <text x="${Math.min(x(ti) + 8, W - 150)}" y="${(y(series[ti].val) - 10).toFixed(1)}" style="font-size:12px; fill:#a03a28; font-weight:700;">谷底 ${series[ti].ym} ${pct(td)}</text>` : '';
      const endMark = `<circle cx="${x(series.length - 1).toFixed(1)}" cy="${y(series[series.length - 1].val).toFixed(1)}" r="4" fill="#8B5E3C"/><text x="${x(series.length - 1) - 70}" y="${(y(series[series.length - 1].val) - 10).toFixed(1)}" style="font-size:12px; fill:#8B5E3C; font-weight:700;">${series[series.length - 1].ym} ${fmt(series[series.length - 1].val)}</text>`;
      el.innerHTML = `<svg viewBox="0 0 ${W} ${H}" style="width:100%; height:auto; display:block; font-family: inherit;">
        ${yTicks}
        <polygon points="${area}" fill="rgba(217,164,65,0.14)"/>
        <polyline points="${pts}" fill="none" stroke="#D9A441" stroke-width="2"/>
        <line x1="${pad.l}" y1="${y(amount).toFixed(1)}" x2="${W - pad.r}" y2="${y(amount).toFixed(1)}" stroke="#8a7a63" stroke-dasharray="4 4"/>
        <text x="${pad.l + 4}" y="${(y(amount) - 6).toFixed(1)}" style="font-size:11px; fill:#8a7a63;">起点 ${fmt(amount)}</text>
        ${troughMark}${endMark}
      </svg>`;
    }

    // 实时行情：页面加载自动拉取（腾讯 qt.gtimg.cn，返回 v_sh511010="..." 即合法 JS）
    // 成功 → 价格列标注"实时 HH:MM"；失败/被墙 → 保留参考价并标注"参考价 08-25"
    function loadQuote() {
      const codes = ['sh511010', 'sz159934', 'sh510880', 'sz513500'];
      const s = document.createElement('script');
      s.src = `https://qt.gtimg.cn/q=${codes.join(',')}&_t=${Date.now()}`;
      const timeout = setTimeout(() => {
        [0, 1, 2, 3].forEach((i) => {
          const st = $(`ea-ps${i}`) as HTMLElement;
          if (!st.textContent.includes('实时')) st.textContent = '参考价 08-25（行情超时）';
        });
      }, 6000);
      s.onload = () => {
        let got = 0;
        codes.forEach((c, i) => {
          const raw = (window as any)['v_' + c];
          if (!raw) return;
          const parts = raw.split('~');
          const px = parseFloat(parts[3]);
          if (!isNaN(px) && px > 0) {
            ($(`ea-p${i}`) as HTMLInputElement).value = px.toFixed(3);
            const st = $(`ea-ps${i}`) as HTMLElement;
            const qtime = (parts[30] || '').replace(/^(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})$/, '$1-$2-$3 $4:$5');
            st.textContent = qtime ? `实时 ${qtime.slice(5)}` : '实时行情 ✓';
            st.style.color = 'var(--green)';
            got++;
          }
        });
        clearTimeout(timeout);
        const msg = $('ea-msg') as HTMLElement;
        msg.textContent = got > 0 ? `权重合计 100% ✓ · 价格已自动更新为实时行情（${got}/4）` : msg.textContent;
      };
      s.onerror = () => {
        clearTimeout(timeout);
        [0, 1, 2, 3].forEach((i) => {
          const st = $(`ea-ps${i}`) as HTMLElement;
          if (!st.textContent.includes('实时')) st.textContent = '参考价 08-25';
        });
      };
      document.body.appendChild(s);
    }
    // 页面加载自动拉取；计算时若价格仍为参考价则再尝试一次
    loadQuote();
    ($('ea-run') as HTMLElement).addEventListener('click', () => {
      const needLive = [0, 1, 2, 3].some((i) => !($(`ea-ps${i}`) as HTMLElement).textContent.includes('实时'));
      if (needLive) loadQuote();
    });
  </script>
</Layout>

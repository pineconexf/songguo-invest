---
import Layout from '../layouts/Layout.astro';
import Chart from '../components/Chart.astro';
import vStd from '../data/version_standard.json';
import vPro from '../data/version_pro.json';
import mRet from '../data/monthly_returns.json';

const s = vStd.strategies;
const vProMetric = vPro.recommended.metrics;
const fmt = (v: number | null, digits = 2) => (v == null ? '—' : `${v > 0 ? '+' : ''}${v.toFixed(digits)}%`);

// 四策略净值序列（统一窗口 2016.03 起）
const navMonths = mRet.map((m) => `${m.ym.slice(0, 4)}-${m.ym.slice(4)}`);
const buildNav = (key: string) => {
  let nav = 1;
  return mRet.map((m) => {
    if (m[key] == null) return null;
    nav *= 1 + m[key] / 100;
    return +nav.toFixed(4);
  });
};
const navOption = {
  tooltip: { trigger: 'axis', valueFormatter: (v: number | null) => (v == null ? '-' : `${v.toFixed(2)} 倍`) },
  legend: { data: ['宏观择时', 'ETF 壳', '基金壳', '股票 V35'], top: 0, textStyle: { color: '#555' } },
  grid: { left: 56, right: 20, top: 42, bottom: 52 },
  xAxis: { type: 'category', data: navMonths, boundaryGap: false, axisLabel: { interval: 23, color: '#8a7a66' } },
  yAxis: { type: 'value', name: '净值（倍数）', nameTextStyle: { color: '#8a7a66' }, scale: true, axisLabel: { color: '#8a7a66' }, splitLine: { lineStyle: { color: '#f0e8d9' } } },
  dataZoom: [
    { type: 'inside', start: 0, end: 100 },
    { type: 'slider', height: 16, bottom: 8, start: 0, end: 100 },
  ],
  series: [
    { name: '宏观择时', type: 'line', data: buildNav('index'), smooth: true, symbol: 'none', lineStyle: { width: 1.5, color: '#d9a441' } },
    { name: 'ETF 壳', type: 'line', data: buildNav('etf'), smooth: true, symbol: 'none', lineStyle: { width: 1.5, color: '#4A7C59' } },
    { name: '基金壳', type: 'line', data: buildNav('fund'), smooth: true, symbol: 'none', lineStyle: { width: 1.5, color: '#8B5E3C' } },
    { name: '股票 V35', type: 'line', data: buildNav('stock'), smooth: true, symbol: 'none', lineStyle: { width: 2.5, color: '#a03a28' } },
  ],
};
---
<!--
  V5 首页 · 一个体系三个版本（2026-08-25）
  用户逻辑：先选版本（我适合哪个）→ 再看证据 → 再懂方法 → 放心行动
  第1幕 钩子     → 散户为什么亏？（痛点 + 一个体系三个版本的承诺）
  第2幕 版本     → 我该用哪个版本？（S/P/M 三卡，像手机选型号）
  第3幕 证据     → 数字是真的吗？（三类资产数据墙 + 125 个月脚印）
  第4幕 方法     → 怎么做到的？（三类资产分工，可解释非黑箱）
  第5幕 审计     → 是不是拟合出来的？（公开黑历史）
  第6幕 行动     → 我能带走什么？（免费工具 + 公众号）
  数据：统一窗口 2016.03-2026.07（125 个月），几何年化，全部真实回测
-->
<Layout
  title="首页"
  description="松果投资实验室 — 一个体系三个版本：Standard 三类资产 / Pro 最优组合 / Max 杠杆版。统一窗口 125 个月真实回测，回测测试数据全公开。"
>

  <!-- ============ 第1幕 · 钩子 ============ -->
  <section class="hero" id="hook">
    <div class="hero-inner">
      <span class="eyebrow reveal">一个体系 · 三个版本 · 125 个月真实回测</span>
      <h1 class="reveal">
        散户总亏钱，<br /><span class="gold">不是没有机会，是没有体系</span>
      </h1>
      <p class="hero-lead reveal">
        我们把专业机构的投资逻辑，做成了 <b>Standard / Pro / Max</b> 三个版本——
        从稳健的防守组合，到进击的个股选股，再到杠杆与期权。
        全部用 <b>125 个月真实回测</b>验证给你看。
      </p>
      <p class="slogan reveal">让普通投资者也能像机构那样享受体系化的稳健投资</p>
      <div class="hero-actions reveal">
        <a href="#versions" class="btn btn-gold">选你的版本 ↓</a>
        <a href="/songguo-invest/philosophy/" class="btn btn-ghost">先了解理念</a>
      </div>
    </div>
    <img src="/songguo-invest/mascot.png" alt="松果投资实验室吉祥物" class="hero-mascot" />
  </section>

  <!-- ============ 新手 · 三步上手 ============ -->
  <section class="card reveal">
    <div class="section-head">
      <div class="section-kicker">Start Here · 从这三步开始</div>
      <h2 class="section-title">新手别慌，三步就能上路</h2>
      <p class="section-sub">不用先搞懂全部。跟着这三步走，你就能把整套体系用起来。</p>
    </div>
    <div class="link-cards" style="grid-template-columns: repeat(3, 1fr);">
      <a href="/songguo-invest/strategies/#standard" class="link-card">
        <div class="master-school" style="color: var(--green, #4A7C59);">第 1 步</div>
        <h3>选你的版本</h3>
        <p>要么用下面「5 问快速适配」帮你选，要么直接看 S/P/M 三档挑一个。</p>
        <div class="master-desc" style="font-size: 13px; margin-top: 10px;">去选版本 ↓</div>
      </a>
      <a href="/songguo-invest/tools/" class="link-card">
        <div class="master-school" style="color: #c87f2e;">第 2 步</div>
        <h3>查你的标的</h3>
        <p>把你想买的股票或基金丢进免费工具：个股体检 / 估值 / 基金体检卡。</p>
        <div class="master-desc" style="font-size: 13px; margin-top: 10px;">去查标的 →</div>
      </a>
      <a href="/songguo-invest/tools/daily-insight/" class="link-card">
        <div class="master-school" style="color: #a03a28;">第 3 步</div>
        <h3>跟进每日解读</h3>
        <p>每天 3 分钟看市场全景 + 信号速查，在信息洪流里抓住关键。</p>
        <div class="master-desc" style="font-size: 13px; margin-top: 10px;">看今日解读 →</div>
      </a>
    </div>
  </section>

  <!-- ============ 第2幕 · 版本选择：我该用哪个 ============ -->
  <section class="card" id="versions">
    <div class="section-head">
      <div class="section-kicker">Versions · 像手机一样选版本</div>
      <h2 class="section-title">三个版本，从稳健到进取</h2>
      <p class="section-sub">
        同一个体系，三个档位。先选适合你的版本，再往下看它的真实数据。
      </p>
    </div>
    <div class="link-cards" style="grid-template-columns: repeat(3, 1fr);">
      <a href="/songguo-invest/strategies/#standard" class="link-card">
        <div class="master-school" style="color: var(--green, #4A7C59);">S · Standard · 稳健</div>
        <h3>Standard 版</h3>
        <p>防守 + 进攻 + 择时三类资产，按月调仓，适合大多数投资者。</p>
        <div class="metric-grid" style="grid-template-columns: repeat(2, 1fr); margin: 14px 0 0; gap: 8px;">
          <div class="metric-card" style="padding: 10px 8px;"><div class="label">防守年化</div><div class="value" style="font-size: 17px;">{fmt(s.fund.annual)}</div></div>
          <div class="metric-card" style="padding: 10px 8px;"><div class="label">防守回撤</div><div class="value" style="font-size: 17px; color: #a03a28;">{fmt(s.fund.mdd)}</div></div>
        </div>
        <div class="master-desc" style="font-size: 13px; margin-top: 10px;">看看三类资产 →</div>
      </a>
      <a href="/songguo-invest/strategies/#pro" class="link-card">
        <div class="master-school" style="color: #c87f2e;">P · Pro · 增强</div>
        <h3>Pro 版</h3>
        <p>网格扫描 222 个组合选出的最优配比：防守打底 + 进攻增厚，回撤砍半。</p>
        <div class="metric-grid" style="grid-template-columns: repeat(2, 1fr); margin: 14px 0 0; gap: 8px;">
          <div class="metric-card" style="padding: 10px 8px;"><div class="label">组合年化</div><div class="value" style="font-size: 17px;">{fmt(vProMetric?.annual ?? 15.40)}</div></div>
          <div class="metric-card" style="padding: 10px 8px;"><div class="label">组合回撤</div><div class="value" style="font-size: 17px; color: #a03a28;">{fmt(vProMetric?.mdd ?? -6.19)}</div></div>
        </div>
        <div class="master-desc" style="font-size: 13px; margin-top: 10px;">看推荐组合 →</div>
      </a>
      <a href="/songguo-invest/strategies/#max" class="link-card">
        <div class="master-school" style="color: #a03a28;">M · Max · 进取</div>
        <h3>Max 版</h3>
        <p>进攻腿加杠杆 + 防守腿期权对冲。只适合风险承受力极强的投资者。</p>
        <div class="metric-grid" style="grid-template-columns: repeat(2, 1fr); margin: 14px 0 0; gap: 8px;">
          <div class="metric-card" style="padding: 10px 8px;"><div class="label">V36 进攻腿（杠杆）</div><div class="value" style="font-size: 17px;">+36.12%</div></div>
          <div class="metric-card" style="padding: 10px 8px;"><div class="label">组合回撤</div><div class="value" style="font-size: 17px; color: #a03a28;">-28.58%</div></div>
        </div>
        <div class="master-desc" style="font-size: 13px; margin-top: 10px;">看杠杆映射 →</div>
      </a>
    </div>
    <div id="quickfit-card" style="margin-top: 24px; padding: var(--sp-4); background: var(--bg-soft, #FAF6EF); border: 1px solid var(--border); border-radius: 12px;">
      <div class="section-kicker">Quick Fit · 快速适配</div>
      <h3 style="margin: 4px 0 0; font-size: 20px;">不知道选哪个？答 5 问，我帮你选</h3>
      <p style="font-size: 14px; color: var(--muted-foreground, #777); margin: 8px 0 0;">每题 3～4 个选项，点完看结果。第 1 步和下面第 2 幕是同一件事的两种做法。</p>
      <div id="quickfit" style="display: flex; flex-direction: column; gap: 14px; margin-top: var(--sp-3);"></div>
      <div style="margin-top: var(--sp-4); display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
        <button id="qf-run" class="btn btn-gold" style="border:none;cursor:pointer;">看看我适合哪个版本</button>
        <div id="qf-result" class="callout" style="display:none; margin:0;"></div>
      </div>
    </div>
  </section>

  <!-- ============ 第3幕 · 证据：数字是真的吗 ============ -->
  <section class="card" id="evidence">
    <div class="section-head">
      <div class="section-kicker">Evidence · 真实证据</div>
      <h2 class="section-title">三类资产，125 个月，统一口径</h2>
      <p class="section-sub">
        以下数字统一窗口 {vStd.window.start}–{vStd.window.end}（{vStd.window.months} 个月），几何年化、月度再平衡、含成本。
        每个数字都可以在回测测试页逐月查到。
      </p>
    </div>
    <div class="metric-grid">
      <div class="metric-card reveal">
        <div class="label">防守 · ETF 壳</div>
        <div class="value gold">{fmt(s.etf.annual)}</div>
        <div class="sub">最大回撤 {fmt(s.etf.mdd)} · 夏普 {s.etf.sharpe.toFixed(2)}</div>
      </div>
      <div class="metric-card reveal">
        <div class="label">防守 · 基金壳</div>
        <div class="value gold">{fmt(s.fund.annual)}</div>
        <div class="sub">最大回撤 {fmt(s.fund.mdd)} · 夏普 {s.fund.sharpe.toFixed(2)}</div>
      </div>
      <div class="metric-card reveal">
        <div class="label">进攻 · 股票 V35</div>
        <div class="value gold">{fmt(s.stock.annual)}</div>
        <div class="sub">最大回撤 {fmt(s.stock.mdd)} · 夏普 {s.stock.sharpe.toFixed(2)}</div>
      </div>
      <div class="metric-card reveal">
        <div class="label">择时 · 宏观信号</div>
        <div class="value gold">{fmt(s.index.annual)}</div>
        <div class="sub">最大回撤 {fmt(s.index.mdd)} · 夏普 {s.index.sharpe.toFixed(2)}</div>
      </div>
    </div>
    <div class="callout" style="margin-top: 20px;">
      <b>双口径说明</b>：本站另有各策略详情页的官方口径（不同起点窗口，如个股 V35 2012 起 14 年 +32.96%）。
      统一窗口用于横向对比，官方口径用于策略详情，两个都真实，使用看标注。
    </div>
  </section>

  <!-- 净值脚印 -->
  <section class="card reveal">
    <div class="section-head">
      <div class="section-kicker">Track Record · 脚印</div>
      <h2 class="section-title">这不是几个数字，是 125 个月的脚印</h2>
      <p class="section-sub">
        起点 1.00，四条线代表四类资产/策略的净值。每一格都是真实的一个月——含 2018 阴跌、含 2022 熊市、含 2024 小微盘股灾。
        数据为历史回测，不构成投资建议。
      </p>
    </div>
    <Chart option={navOption} height="440px" />
    <div style="margin-top: var(--sp-3); text-align: center; display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <a href="/songguo-invest/strategies/monthly/" class="btn btn-gold">查看 125 个月回测测试 →</a>
      <a href="/songguo-invest/strategies/" class="btn btn-ghost">全部策略与版本</a>
    </div>
  </section>

  <!-- ============ 第4幕 · 方法：怎么做到的 ============ -->
  <section class="card reveal">
    <div class="section-head">
      <div class="section-kicker">Method · 可解释的方法</div>
      <h2 class="section-title">不是黑箱。三类资产各司其职。</h2>
      <p class="section-sub">
        松果体系不是单一押注，而是三类资产的分工协作——每类独立可验证，组合起来形成闭环。
      </p>
    </div>
    <div class="layer-stack">
      <a href="/songguo-invest/strategies/etf/" class="layer">
        <span class="layer-index">01</span>
        <span class="layer-name">防守组合</span>
        <span class="layer-desc">债 + 金 + 红利/QDII 低相关拼图，压舱石。ETF/基金两个壳二选一，回撤 5-6%。</span>
        <span class="layer-tag">回撤优先</span>
      </a>
      <a href="/songguo-invest/backtest/" class="layer">
        <span class="layer-index">02</span>
        <span class="layer-name">进攻选股</span>
        <span class="layer-desc">量化价值选股：质量门槛 + 低估值 + 中小盘，收益引擎，需要组合纪律。</span>
        <span class="layer-tag">V35</span>
      </a>
      <a href="/songguo-invest/macro/" class="layer">
        <span class="layer-index">03</span>
        <span class="layer-name">宏观择时</span>
        <span class="layer-desc">Shibor 流动性信号 × 中证500，宽松持有、收紧空仓，指数保险。</span>
        <span class="layer-tag">V1 常规版</span>
      </a>
      <a href="/songguo-invest/strategies/" class="layer">
        <span class="layer-index">S→M</span>
        <span class="layer-name">三版本演进</span>
        <span class="layer-desc">Standard 三类资产 → Pro 数据选最优组合 → Max 进攻加杠杆、防守用期权对冲。</span>
        <span class="layer-tag">S / P / M</span>
      </a>
    </div>
  </section>

  <!-- ============ 第5幕 · 审计：公开自己的黑历史 ============ -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Audit · 我们公开自己的黑历史</div>
      <h2 class="doubt-title">你可能会怀疑：回测是不是拟合出来的？</h2>
      <p class="section-sub">
        合理。所以我们把审计过程全部公开——<b>包括我们自己抓出来的错</b>。
        每条逐步点亮，读完你就知道这套数据经得起查。
      </p>
    </div>
    <div class="steps">
      <div class="step steps-step">
        <div class="num">1</div>
        <div class="body">
          <h3>含成本口径</h3>
          <p>佣金万 2.5 + 印花税 0.05% + 空仓月债券/黄金 ETF 切换成本，全部计入。成本每年约侵蚀 1.1-2.5 个百分点，真实摩擦不藏。</p>
        </div>
      </div>
      <div class="step steps-step">
        <div class="num">2</div>
        <div class="body">
          <h3>无未来函数</h3>
          <p>信号判定严格滞后对齐。2026 年 8 月独立审计曾发现旧版本含前视偏差（年化虚高至 40%+），已全体系重算——本站数据是<b>自曝问题后修正</b>的口径。</p>
        </div>
      </div>
      <div class="step steps-step">
        <div class="num">3</div>
        <div class="body">
          <h3>数据修复</h3>
          <p>审计中发现 6 个报告期底层数据量纲损坏（估值倍数被缩放 1 万倍），已修复并重跑，后续版本均为修复后数据。</p>
        </div>
      </div>
      <div class="step steps-step">
        <div class="num">4</div>
        <div class="body">
          <h3>保守方向原则</h3>
          <p>所有口径分歧一律按保守方向处理，<b>宁可低估收益，不虚增</b>。</p>
        </div>
      </div>
    </div>
    <div style="margin-top: var(--sp-4);">
      <a href="/songguo-invest/backtest/" class="btn btn-ghost">查看完整审计与逐月数据 →</a>
    </div>
  </section>

  <!-- ============ 第6幕 · 行动：你能带走什么 ============ -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Action · 你能带走什么</div>
      <h2 class="section-title">体系是公开的。工具是免费的。</h2>
      <p class="section-sub">
        体系公开、工具免费——深度的策略追踪与会员服务另设，丰俭由人。你带走三样东西：选版本的方法、验证策略的数据、以及一套不用拍脑袋的投资体系。
      </p>
      <div style="display: flex; flex-wrap: wrap; gap: 10px; margin-top: var(--sp-4);">
        <span style="background: var(--gold-100); border: 1px solid var(--gold-500); color: #5c4a1e; border-radius: 999px; padding: 6px 14px; font-size: 13px; font-weight: 600;">① 选版本的方法</span>
        <span style="background: var(--gold-100); border: 1px solid var(--gold-500); color: #5c4a1e; border-radius: 999px; padding: 6px 14px; font-size: 13px; font-weight: 600;">② 验证策略的数据</span>
        <span style="background: var(--gold-100); border: 1px solid var(--gold-500); color: #5c4a1e; border-radius: 999px; padding: 6px 14px; font-size: 13px; font-weight: 600;">③ 一套不用拍脑袋的体系</span>
      </div>
    </div>
    <div class="link-cards">
      <a href="/songguo-invest/strategies/" class="link-card action-card">
        <h3><span class="gold">策略体系</span> · 三个版本任你选</h3>
        <p>Standard 稳健 / Pro 增强 / Max 进取——每版都有完整方法论与回测数据。</p>
      </a>
      <a href="/songguo-invest/strategies/monthly/" class="link-card action-card">
        <h3><span class="gold">回测测试</span> · 125 个月逐月可查</h3>
        <p>月度收益、累计净值、滚动回撤全公开，每个时点都能下钻核实。</p>
      </a>
      <a href="/songguo-invest/tools/" class="link-card action-card">
        <h3><span class="gold">免费工具</span> · 配套策略使用</h3>
        <p>个股体检、估值计算、复利计算、ETF 配置、基金打分、宏观信号均已上线。</p>
      </a>
    </div>
    <div class="callout" style="margin-top: var(--sp-5);">
      <b>每周一篇深度文章</b>：关注公众号「松果商业笔记」，把体系拆成每周一篇讲给你听。
      观点用本站数据佐证，不荐股、不喊单。
    </div>
  </section>

  <div class="callout">
    <b>免责声明</b>：本站全部数据为历史回测结果（含成本口径），不代表未来收益，
    不构成任何投资建议，亦不构成对任何证券或产品的推荐。投资有风险，入市需谨慎。
  </div>

  <script>
    import '../scripts/charts.ts';
    import '../scripts/scroll-narrative.ts';
  </script>
  <script is:inline>
    const QF = [
      { q: '这笔钱，你能放多久不动？', o: [['6 个月以内', 1], ['6 个月～2 年', 2], ['3 年以上', 3]] },
      { q: '最大能接受这笔钱缩水多少？', o: [['10% 以内', 1], ['25% 以内', 2], ['40% 以内', 3], ['超过 40% 也能扛', 4]] },
      { q: '你平时会定期看账户、调整仓位吗？', o: [['基本不看', 1], ['每月看一次', 2], ['乐意定期管理', 3]] },
      { q: '这笔钱是你的主要积蓄，还是闲钱？', o: [['主要积蓄', 1], ['一半一半', 2], ['闲钱为主', 3]] },
      { q: '你更信「跟着纪律买」，还是「靠自己感觉」？', o: [['更信自己感觉', 1], ['说不好', 2], ['认同纪律', 3]] },
    ];
    const qfBox = document.getElementById('quickfit');
    if (qfBox) {
      qfBox.innerHTML = QF.map((item, qi) =>
        '<div><div style="font-weight:600;margin-bottom:6px;">Q' + (qi + 1) + ' · ' + item.q + '</div><div style="display:flex;flex-wrap:wrap;gap:8px;">' +
        item.o.map((o) =>
          '<label style="cursor:pointer;border:1px solid var(--border);border-radius:8px;padding:6px 12px;font-size:13px;"><input type="radio" name="qf' + qi + '" value="' + o[1] + '"> ' + o[0] + '</label>'
        ).join('') + '</div></div>'
      ).join('');
      document.getElementById('qf-run').onclick = () => {
        let sum = 0, done = 0;
        QF.forEach((_, qi) => { const el = document.querySelector('input[name="qf' + qi + '"]:checked'); if (el) { sum += +el.value; done++; } });
        if (done < 5) { alert('请把 5 题都答完哦'); return; }
        const res = document.getElementById('qf-result');
        let v = '', href = '', why = '';
        if (sum <= 7) { v = 'Standard 稳健'; href = '/songguo-invest/strategies/#standard'; why = '你这笔钱偏急用、回撤承受力也克制——标准版防守打底 + 少量进攻，按月调仓、少操心。'; }
        else if (sum <= 12) { v = 'Pro 增强'; href = '/songguo-invest/strategies/#pro'; why = '你能接受中等回撤、也愿意每月看一次——Pro 版攻守均衡、回撤砍半，是多数人的甜点位。'; }
        else { v = 'Max 进取'; href = '/songguo-invest/strategies/#max'; why = '你扛得住大回撤、用的是闲钱、还认纪律——Max 版进攻加杠杆 + 期权对冲，只给这一类人。'; }
        res.style.display = 'block';
        res.innerHTML = '<b>你的适配版本：' + v + '</b>　' + why + '<div style="margin-top:10px;"><a href="' + href + '" class="btn btn-gold">去看看 ' + v + ' →</a></div>';
      };
    }
  </script>
</Layout>

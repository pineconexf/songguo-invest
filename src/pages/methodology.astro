---
import Layout from '../layouts/Layout.astro';

const assets = [
  {
    index: '01',
    name: '防守组合',
    en: 'Defensive',
    tag: '压舱石',
    color: '#4A7C59',
    desc: '「债券 + 黄金 + 红利/QDII」低相关拼图组合。ETF（场内）与基金（场外）是同一组合的两个壳，成分几乎一样——二选一即可，同时持有纯属稀释。',
    detail: '回撤 5-6%，年化 10% 上下，覆盖 2015/2018/2022 三次股灾。作用：让组合在市场大跌时还能稳住。',
    href: '/songguo-invest/strategies/etf/',
  },
  {
    index: '02',
    name: '进攻选股',
    en: 'Offensive',
    tag: '收益引擎',
    color: '#a03a28',
    desc: '量化价值选股（V35）：FCF/EV Top4 + 帕伯莱红旗审查（删票满仓集中）。三类资产里收益最高、回撤也最大。',
    detail: '14 年（2012-2026）全周期回测年化 20%+。作用：承担风险换取超额收益，是组合的引擎。',
    href: '/songguo-invest/backtest/',
  },
  {
    index: '03',
    name: '宏观择时',
    en: 'Timing',
    tag: '指数保险',
    color: '#d9a441',
    desc: 'Shibor 流动性信号 × 中证500：宽松时持有、收紧时空仓，固定 5bp 阈值，严格滞后一周执行（无前视）。',
    detail: '大部分时间空仓躲跌，信号确认后在场。作用：给组合上一道保险，普跌段少亏就是赚。',
    href: '/songguo-invest/macro/',
  },
];

const versions = [
  {
    key: 'S',
    name: 'Standard 版',
    color: '#4A7C59',
    desc: '三类资产独立运作：防守打底、进攻增厚、择时保护。按月调仓，无需盯盘。',
    metric: '防守 9-10% 年化 · 回撤 5-6%',
    path: '适合大多数人',
  },
  {
    key: 'P',
    name: 'Pro 版',
    color: '#c87f2e',
    desc: '用网格扫描 222 个组合选出最优配比：防守 60% + 进攻 40%，相关性 0.33 弱相关。',
    metric: '组合 15.40% 年化 · 回撤 -6.19%',
    path: '想要更高收益风险比',
  },
  {
    key: 'M',
    name: 'Max 版',
    color: '#a03a28',
    desc: '只给进攻腿加杠杆 + 防守腿用期权对冲（宏观 V2）。整体加杠杆 Calmar 反降，路径已用数据验证。',
    metric: 'V32×宏观V2：40.24% / -30.8%',
    path: '风险承受力极强',
  },
];
---
<Layout
  title="体系架构"
  description="松果投资实验室总纲 — 三类资产（防守组合/进攻选股/宏观择时）+ 三版本演进（Standard/Pro/Max），每个版本都有真实回测数据支撑。"
>
  <!-- Hero -->
  <section class="hero" style="padding: 56px 48px;">
    <div class="hero-inner">
      <span class="eyebrow">Framework · 体系总纲</span>
      <h1>
        三类资产，<span class="gold">三个版本</span><br />一个完整的投资体系
      </h1>
      <p class="hero-lead">
        松果体系 = 三类资产（防守/进攻/择时）的分工协作 + 三版本（S/P/M）的演进路径。
        每一层独立可验证，每个版本都有真实回测数据支撑——不靠感觉，靠体系。
      </p>
    </div>
  </section>

  <!-- 三类资产 -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Three Assets</div>
      <h2 class="section-title">三类资产，各司其职</h2>
      <p class="section-sub">
        资产分工是体系的底层逻辑：谁负责稳、谁负责赚、谁负责躲——互不越位。
      </p>
    </div>
    <div class="link-cards" style="grid-template-columns: repeat(3, 1fr);">
      {
        assets.map((a) => (
          <a href={a.href} class="link-card">
            <div class="master-school" style={`color: ${a.color};`}>Asset {a.index} · {a.en}</div>
            <h3>{a.name} <span style="font-size:12px; color:var(--text-3); font-weight:400;">· {a.tag}</span></h3>
            <p>{a.desc}</p>
            <div style="font-size:13px; color:var(--text-2); margin-top:10px; border-left:2px solid var(--gold-500); padding-left:10px;">{a.detail}</div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- 三版本演进 -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Three Versions</div>
      <h2 class="section-title">三版本演进：从稳健到进取</h2>
      <p class="section-sub">
        同一个体系，三个档位——像手机一样，先选型号，再看配置。每个版本都是数据选出来的，不是拍脑袋。
      </p>
    </div>
    <div class="link-cards" style="grid-template-columns: repeat(3, 1fr);">
      {
        versions.map((v) => (
          <a href="/songguo-invest/strategies/" class="link-card" style="position: relative;">
            <div style="position:absolute; top:14px; right:16px; width:40px; height:40px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:19px; font-weight:800; color:#fff; background: linear-gradient(135deg, ${v.color}, ${v.color}cc);">{v.key}</div>
            <div class="master-school" style={`color: ${v.color};`}>{v.name}</div>
            <h3 style="margin-top: 6px;">{v.desc}</h3>
            <p style="margin-top: 10px;"><b>{v.metric}</b></p>
            <div class="master-desc" style="font-size: 13px; margin-top: 10px;">{v.path} →</div>
          </a>
        ))
      }
    </div>
    <div class="callout" style="margin-top: 20px;">
      <b>演进逻辑</b>：S（三类资产独立）→ P（数据找最优组合）→ M（进攻加杠杆、防守用期权）。
      每一步都是在上一版基础上做加法，回测数据逐版验证——不是换一套说法，是同一体系的三档配置。
    </div>
  </section>

  <!-- 决策链（四层参考） -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Decision Chain</div>
      <h2 class="section-title">投资的完整决策链</h2>
      <p class="section-sub">
        三类资产内部，仍是一条完整的决策链：先看大势（择时）→ 再挑标的（选股/拼图）→ 最后管风险（组合）。
      </p>
    </div>
    <div class="layer-stack">
      <div class="layer" style="cursor: default;">
        <span class="layer-index">01</span>
        <span class="layer-name">看大势</span>
        <span class="layer-desc">宏观择时：Shibor 流动性信号，决定当前进攻还是防守、在场还是空仓。</span>
        <span class="layer-tag">择时</span>
      </div>
      <div class="layer" style="cursor: default;">
        <span class="layer-index">02</span>
        <span class="layer-name">挑标的</span>
        <span class="layer-desc">进攻腿：量化价值选股（V35）；防守腿：四拼图组合（债/金/红利/QDII）。</span>
        <span class="layer-tag">选股+拼图</span>
      </div>
      <div class="layer" style="cursor: default;">
        <span class="layer-index">03</span>
        <span class="layer-name">管风险</span>
        <span class="layer-desc">组合层：版本选择（S/P/M）、再平衡纪律、回测测试逐月核实。</span>
        <span class="layer-tag">组合</span>
      </div>
    </div>
  </section>

  <!-- 回测测试入口 -->
  <section class="card" style="background: linear-gradient(160deg, var(--navy-900), var(--navy-700)); color: #fff; border: 1px solid rgba(200,162,75,0.2);">
    <div class="section-kicker" style="color: var(--gold-300);">回测测试</div>
    <h2 class="section-title" style="color: #fff; border: none; padding: 0; margin: 12px 0;">体系不是口号，是逐月可查的数据</h2>
    <p class="section-sub" style="color: rgba(255,255,255,0.8); margin: 0 0 24px; max-width: 640px;">
      三类资产 + Pro 组合的 125 个月度明细：每月收益、累计净值、滚动回撤全公开。
      想看 2018 年 3 月怎么跌的——逐月翻。
    </p>
    <div style="display:flex; gap:12px; flex-wrap:wrap;">
      <a href="/songguo-invest/strategies/monthly/" class="btn btn-gold">查看月度明细 →</a>
      <a href="/songguo-invest/strategies/" class="btn btn-ghost" style="background: rgba(255,255,255,0.1); color: #fff;">策略与版本</a>
    </div>
  </section>

  <style is:global>
    .link-card .master-school { font-size: 12px; font-weight: 700; letter-spacing: 0.4px; margin-bottom: 6px; }
  </style>
</Layout>

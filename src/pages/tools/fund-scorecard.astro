---
import Layout from '../../layouts/Layout.astro';

// 基金打分卡 V4（2026-10-02 重构）
// 合并：旧「基金体检卡 V3」+「ETF 五维」+「ETF 组合配置器」→ 单只基金深度体检
// 旧 V3 页保留在 fund-scorecard-v3-legacy.astro，可回退对照。
//
// 三轴信息架构（用户要什么，就给什么）：
//   1. 值不值得买    → 松果总分 + 6/7 维拆解 + 同类分位
//   2. 过往怎么样    → 多周期收益/回撤/波动/Sharpe/Calmar
//   3. 买的是什么    → 被动看指数成分股；主动看基准与经理
//   4. 适合谁买      → 类型分组 + 风险档次 + 适配人群
//
// 评分体系（对齐官方口径，上海证券 2023 方法明确：被动基金不做传统评级，
// 本页为「松果内部购买决策分」，非监管/机构评级）：
//   被动 6 维：同类排位25 / 回撤控制20 / 收益稳定性20 / 费率15 / 规模稳定10 / 持仓透明度10
//   主动 7 维：长期业绩20 / 回撤15 / 风险回报效率15 / 超额稳定性15 / 择时10 / 经理15 / 费率规模10
//
// A 值（年化超额收益）、T 值（择时能力=t 统计量均值）只对**主动**有意义，
// 已从技术说明提升为第 4、5 维的正式输入。
//
// 数据：本地全市场 29,992 只场外 + 2,966 只场内，离线计算，规则公开可复算。
// 不构成投资建议。
---

<Layout
  title="基金打分卡"
  description="输入基金名称或代码，30 秒看懂一只基金：同类排位、多周期回撤、超额收益稳定性、择时能力、经理能力、具体持仓股票、适合谁买。全市场 3 万只基金，数据公开可复算。"
>
  <style is:global>
  .fs-linkbtn { background:none; border:1px solid var(--gold); color:var(--gold);
    border-radius:6px; padding:2px 8px; font-size:12px; cursor:pointer; }
  .fs-linkbtn:hover { background:var(--gold); color:#fff; }
  </style>

  <section class="hero" style="padding: 48px 48px 28px;">
    <div class="hero-inner">
      <span class="eyebrow">Free Tool · 基金打分卡 V4</span>
      <h1>
        买基金前，<br /><span class="gold">先把这只基金拆开看一遍</span>
      </h1>
      <p class="hero-lead">
        输入基金名称或代码，得到一份完整的购买决策报告：<b>同类排位</b>、<b>多周期回撤</b>、
        <b>超额收益稳定性</b>、<b>择时能力</b>、<b>基金经理能力</b>、<b>具体持仓哪几只股票</b>、
        <b>适合什么风险承受力的人买</b>。<br />
        全市场 <b>29,992</b> 只场外基金 + <b>2,966</b> 只场内基金，离线计算，规则公开可复算。
      </p>
    </div>
  </section>

  <!-- 三工具合并后的定位说明：先体检，再比较，最后配组合 -->
  <section class="card" style="max-width: 980px; margin: 0 auto 16px;">
    <div class="section-head">
      <div class="section-kicker">工具怎么用</div>
      <h2 class="section-title">三步闭环：体检 → 比较 → 配置</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px;">
      <div style="border:1px solid var(--border);border-radius:10px;padding:14px;background:var(--card);">
        <div style="font-weight:700;color:var(--navy-700);margin-bottom:4px;">① 单只体检<span style="font-weight:400;color:var(--navy-400);">（本页）</span></div>
        <div style="font-size:13px;color:var(--navy-600);line-height:1.7;">
          输入代码或名字 → 6/7 维拆解、持仓下钻、适配人群判断。旧「基金体检卡 V3」「ETF 五维诊断」已并入本页。
        </div>
      </div>
      <div style="border:1px solid var(--border);border-radius:10px;padding:14px;background:var(--card);">
        <div style="font-weight:700;color:var(--navy-700);margin-bottom:4px;">② 同类比较</div>
        <div style="font-size:13px;color:var(--navy-600);line-height:1.7;">
          同类分位已内置在每只基金的「同类排位」维度里：20 个可比组（资产大类 × 市场 × 策略），
          被动与主动分开排、A/C 份额不重复计权。
        </div>
      </div>
      <div style="border:1px solid var(--border);border-radius:10px;padding:14px;background:var(--card);">
        <div style="font-weight:700;color:var(--navy-700);margin-bottom:4px;">③ 组合配置</div>
        <div style="font-size:13px;color:var(--navy-600);line-height:1.7;">
          选好几只之后去
          <a href="/songguo-invest/tools/etf-allocator/" id="fs-nav-alloc" style="color:var(--gold);text-decoration:underline;">ETF 组合配置器</a>
          做权重与风险预算，那里有独立的历史回测口径。
        </div>
      </div>
    </div>
  </section>

  <!-- 同类榜单：横向比较入口 -->
  <section class="card" style="max-width: 980px; margin: 0 auto 16px;">
    <div class="section-head">
      <div class="section-kicker">横向比较</div>
      <h2 class="section-title">同类榜单</h2>
      <p class="section-sub">
        同类 = 资产大类 × 市场 × 策略。选一组，看这一组里排前面的都是谁。
      </p>
    </div>
    <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
      <select id="fs-rank-peer" style="flex:1;min-width:200px;padding:8px 10px;border:1px solid var(--border);border-radius:8px;background:var(--card);color:var(--foreground);font-size:14px;">
        <option value="">选择同类组…</option>
      </select>
      <select id="fs-rank-order" style="padding:8px 10px;border:1px solid var(--border);border-radius:8px;background:var(--card);color:var(--foreground);font-size:14px;">
        <option value="tt">按总分</option>
        <option value="pa">按同类排位</option>
        <option value="pm">按回撤控制</option>
        <option value="ps">按收益稳定性</option>
        <option value="pst">按超额稳定性</option>
        <option value="pt">按择时能力</option>
      </select>
      <span id="fs-rank-cnt" style="font-size:13px;color:var(--navy-500);"></span>
    </div>
    <div id="fs-rank-list" style="margin-top:12px;"></div>
    <p style="font-size:12px;color:var(--navy-400);margin-top:10px;line-height:1.7;">
      榜单需要逐只载入详情分片，点「看详情」即跳转。被动基金不参与「超额稳定性 / 择时能力」排名。
    </p>
  </section>

  <!-- ============ Step 1 搜索 ============ -->
  <section class="card" style="max-width: 980px; margin: 0 auto;">
    <div class="section-head">
      <div class="section-kicker">Step 1</div>
      <h2 class="section-title">输入基金名称或代码</h2>
      <p class="section-sub">
        支持 6 位代码（如 <code>110011</code> 易方达优质精选）、中文名称片段（如「沪深300 指数增强」）。
        记不住就输名字，直接从下拉里选。全部本地计算，不上传任何输入。
      </p>
    </div>

    <div style="display:flex; gap: var(--sp-3); align-items:center; flex-wrap:wrap; margin-bottom: var(--sp-3);">
      <div style="flex:1; min-width:240px; position:relative;">
        <input id="fs-q" type="text" maxlength="24" placeholder="基金名称 / 代码 / 公司，如：沪深300增强、110011、华夏成长"
          autocomplete="off"
          style="width:100%; box-sizing:border-box; padding:12px 14px; border:1px solid rgba(139,94,60,0.25); border-radius:10px; font-size:15px; background:var(--bg); color:var(--navy-900);" />
        <div id="fs-suggest" style="display:none; position:absolute; z-index:30; top:calc(100% + 4px); left:0; right:0; max-height:320px; overflow-y:auto; background:var(--bg); border:1px solid rgba(139,94,60,0.3); border-radius:10px; box-shadow:0 6px 18px rgba(74,46,26,0.15);"></div>
      </div>
      <button id="fs-run" class="btn btn-gold">体检 →</button>
    </div>

    <div id="fs-stats" style="display:flex; gap:var(--sp-4); flex-wrap:wrap; padding:10px 14px; border-radius:10px; background:rgba(74,124,89,0.06); font-size:13px; color:var(--navy-700);"></div>
  </section>

  <!-- ============ 结果区 ============ -->
  <div id="fs-result"></div>

  <!-- ============ 方法论 ============ -->
  <section class="card" style="max-width: 980px; margin: 32px auto;">
    <div class="section-head">
      <div class="section-kicker">方法论与口径</div>
      <h2 class="section-title">分数是怎么算出来的</h2>
    </div>
    <div id="fs-method" style="font-size:14px; line-height:1.85; color:var(--navy-700);"></div>
  </section>

  <script is:inline>
  // 注意：这里必须用 is:inline，不能用 define:vars。
  // define:vars 会让 Astro 把整个脚本当组件编译，内部的中划线 DOM id
  // （$('#fs-rank-peer') 之类）会被当成 JSX 标识符而报
  // "Identifiers in JSX cannot contain hyphens"。
  // 本脚本不需要服务端注入任何变量，纯客户端跑，用 is:inline 最直接。
  // ============================================================
  // 基金打分卡 V4 前端
  // 数据源：/songguo-invest/data/fund_scorecard.json（离线计算产物）
  // ============================================================
  const BASE = '/songguo-invest/data/';
  let DB = null, HOLD = null, IDX = null;

  const $ = s => document.querySelector(s);
  const el = (t, a = {}, kids = []) => {
    const n = document.createElement(t);
    for (const [k, v] of Object.entries(a)) {
      if (k === 'html') n.innerHTML = v;
      else if (k === 'text') n.textContent = v;
      else if (k.startsWith('on')) n.addEventListener(k.slice(2), v);
      else n.setAttribute(k, v);
    }
    for (const k of [].concat(kids)) if (k) n.appendChild(typeof k === 'string' ? document.createTextNode(k) : k);
    return n;
  };
  const nz = v => (v === null || v === undefined || Number.isNaN(v) || v === '') ? null : v;
  const pct = (v, d = 1) => v === null ? '—' : (v > 0 ? '+' : '') + v.toFixed(d) + '%';
  const num = (v, d = 2) => v === null ? '—' : v.toFixed(d);

  const TYPE_LABEL = { '被动': '被动指数型', '主动': '主动管理型' };

  // ---------------------------------------------------------------- 评分解释
  const PASSIVE_DIMS = [
    ['同类排位', '25%', '与同类基金比，长期年化和回撤排在什么位置'],
    ['回撤控制', '20%', '历史最大回撤有多深，1/3/5 年各阶段最深亏多少'],
    ['收益稳定性', '20%', '多周期收益是否稳定，1/3/5 年方向是否一致'],
    ['费率', '15%', '管理费+托管费，长期复利下的确定性拖累'],
    ['规模稳定', '10%', '发行规模与净值连续性，过小有清盘风险'],
    ['持仓透明度', '10%', '指数成分股是否可得，买不买得明明白白'],
  ];
  const ACTIVE_DIMS = [
    ['长期业绩', '20%', '年化收益 + 同类排位'],
    ['回撤控制', '15%', '最大回撤与各周期回撤深度'],
    ['风险回报效率', '15%', 'Sharpe / Calmar，每单位波动换回多少收益'],
    ['超额收益稳定性', '15%', 'A 值：年化超额收益 + 超额 Sharpe + 同类分位'],
    ['择时能力', '10%', 'T 值：超额收益的 t 统计量均值，正负择时贡献'],
    ['基金经理', '15%', '任期、任职回报、相对基准超额、滚动胜率、回撤'],
    ['费率与规模', '10%', '综合费率与规模稳定性'],
  ];

  function grade(t) {
    if (t === null) return { g: '—', cls: 'na', txt: '数据不足，不打分' };
    if (t >= 80) return { g: 'A', cls: 'a', txt: '同类前列，值得优先看' };
    if (t >= 70) return { g: 'B', cls: 'b', txt: '同类中上，可以考虑' };
    if (t >= 60) return { g: 'C', cls: 'c', txt: '同类中等，需看自己需求' };
    if (t >= 45) return { g: 'D', cls: 'd', txt: '同类偏弱，建议谨慎' };
    return { g: 'E', cls: 'e', txt: '同类落后，不建议优先' };
  }

  function advice(f) {
    const pg = f.pg || '', tp = f.tp;
    const out = [];
    if (pg.includes('货币')) return '现金管理工具，不适合作为长期配置，看收益率就行。';
    if (pg.includes('固收') || pg.includes('债券')) {
      const an = nz(f.an);
      if (an !== null && an < 1) return '低波固收，适合压舱石，注意久期风险和规模萎缩导致的清盘。';
      return '固收类，看的是确定性和回撤控制，别只盯着收益率。';
    }
    if (pg.includes('商品')) return '商品类，与股债相关度低，适合做组合对冲，注意它本身波动不小。';
    if (pg.includes('宽基')) {
      if (tp === '被动') return '宽基底仓，长期定投最省心的选择，跟住市场就别频繁换。';
      return '宽基底仓，主动增强版，超额能不能持续是关键，看 A 值和超额 Sharpe。';
    }
    if (pg.includes('行业') || pg.includes('窄基') || pg.includes('主题')) {
      if (tp === '被动') return '窄基/主题基金，波动天然大于宽基，单只别超过组合的 15%，先想清楚能不能扛住 30% 回撤。';
      return '窄基/主题基金，主动管理难度更高，重点看经理任职时间和超额稳定性。';
    }
    if (pg.includes('港股') || pg.includes('海外')) return '跨市场基金，注意汇率和当地市场风险，仓位别超配。';
    out.push(tp === '被动' ? '被动指数产品，长期持有成本最低。' : '主动管理产品，超额收益的可持续性是核心。');
    return out.join('');
  }

  // ---------------------------------------------------------------- 渲染
  function dimBar(name, w, val, hint) {
    const v = nz(val);
    const pctw = v === null ? 0 : Math.max(4, Math.min(100, v));
    const col = v === null ? '#999' : v >= 80 ? '#4A7C59' : v >= 65 ? '#8B5E3C' : v >= 50 ? '#D9A441' : '#B4553A';
    return `<tr>
      <td style="padding:8px 10px; font-weight:600; white-space:nowrap;">${name}<span style="font-weight:400;color:var(--navy-500);font-size:12px;"> ${w}</span></td>
      <td style="padding:8px 10px; width:52%;">
        <div style="background:rgba(139,94,60,0.10); border-radius:5px; height:8px; position:relative; overflow:hidden;">
          <div style="width:${pctw}%; height:100%; background:${col}; border-radius:5px;"></div>
        </div>
        <div style="font-size:11px; color:var(--navy-500); margin-top:3px; line-height:1.4;">${hint || ''}</div>
      </td>
      <td style="padding:8px 10px; text-align:right; font-variant-numeric:tabular-nums; font-weight:700; color:${col}; white-space:nowrap;">${v === null ? '—' : v.toFixed(1)}</td>
    </tr>`;
  }

  function renderResult(f) {
    const R = $('#fs-result');
    R.innerHTML = '';
    const g = grade(nz(f.tt));
    const isP = f.tp === '被动';
    const dims = isP ? PASSIVE_DIMS : ACTIVE_DIMS;
    const dm = f.dm || {}, wt = f.wt || {};
    const hintFor = {
      pa: '同类年化分位：越高说明同类里赚得多',
      pm: '同类回撤分位：越高说明跌得比同类轻',
      ps: '同类 Sharpe 分位',
      pst: '多周期收益方向一致性分位',
      pf: '费率分位：越高越便宜',
      pal: '超额收益分位：主动基金最核心的一项',
      pt: '择时能力分位：正负超额择时贡献',
    };
  // 展示名 → 评分引擎内部键（引擎用简称，页面用全称）
  const DIMKEY = {
    '超额收益稳定性': '超额稳定性',
    '同类排位': '同类排位', '回撤控制': '回撤控制', '收益稳定性': '收益稳定性',
    '费率': '费率', '规模稳定': '规模稳定', '持仓透明度': '持仓透明度',
    '长期业绩': '长期业绩', '风险回报效率': '风险回报效率',
    '择时能力': '择时能力', '基金经理': '基金经理', '费率与规模': '费率与规模',
  };
  // 经理履历一行摘要。子项是数值对象，直接拼会渲染成 [object Object]，
  // 所以这里把关键几项拼成人话：任职年化、超额、胜率、最深回撤。
  function mgrSummary(sb) {
    if (!sb || typeof sb !== 'object') return '';
    const bits = [];
    if (sb.tenure_ann !== undefined && sb.tenure_ann !== null)
      bits.push('任职期年化 ' + num(sb.tenure_ann, 2) + '%');
    if (sb.excess_ann !== undefined && sb.excess_ann !== null)
      bits.push('超额 ' + num(sb.excess_ann, 2) + '%/年');
    if (sb.win_rate !== undefined && sb.win_rate !== null)
      bits.push('跑赢基准的年份 ' + sb.win_rate + '%');
    if (sb.tenure_mdd !== undefined && sb.tenure_mdd !== null)
      bits.push('任职期最深回撤 ' + num(sb.tenure_mdd, 1) + '%');
    return bits.length ? ' · ' + bits.join(' · ') : '';
  }

  const hintDim = {
      '同类排位': f.hpp === false
        ? '这只基金暂时归不出可靠同类组，无同类分位；总分只由绝对指标维度给出'
        : '同类年化 + 回撤 + Sharpe 综合分位',
      '回撤控制': '最大回撤 + 1/3/5 年各阶段',
      '收益稳定性': '1/3/5 年收益 + 波动 + Sharpe',
      '费率': '管理费 + 托管费',
      '规模稳定': '发行规模（非当前AUM）+ 净值连续性',
      '持仓透明度': '指数成分股可得性',
      '长期业绩': '年化收益 + 同类排位',
      '风险回报效率': 'Sharpe + Calmar',
      '超额稳定性': `A 值 ${pct(nz(f.a), 2)}/年 · 同类分位 ${nz(f.pal) !== null ? f.pal.toFixed(0) + '%' : '—'}`,
      '择时能力': `T 值 ${num(nz(f.tr), 2)} · 同类分位 ${nz(f.pt) !== null ? f.pt.toFixed(0) + '%' : '—'}`,
      '基金经理': f.mg
        ? `${f.mg.n || ''} 任职 ${num(nz(f.mg.ty), 1)} 年`
        : '经理履历未取到，或任职不足 1.5 年样本太短，本维度不计分',
      '费率与规模': `同类费率分位 ${pct(nz(f.pf), 0)} · 含发行规模与净值连续性`,
    };

    const box = el('div', { class: 'card', style: 'max-width:980px;margin:28px auto;padding:0;overflow:hidden;' });

    // ===== 头部：结论 =====
    const head = el('div', { style: 'padding:28px 32px;background:linear-gradient(135deg,rgba(139,94,60,0.08),rgba(217,164,65,0.06));border-bottom:1px solid var(--border);' });
    head.innerHTML = `
      <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:24px;flex-wrap:wrap;">
        <div style="flex:1;min-width:280px;">
          <div style="font-size:12px;color:var(--navy-500);margin-bottom:6px;">
            ${TYPE_LABEL[f.tp] || f.tp || '—'} · ${f.pg || '未分类'}${f.it ? ' · ' + f.it : ''}
          </div>
          <h2 style="font-size:26px;margin:0 0 4px;line-height:1.3;">${f.n || ''}</h2>
          <div style="font-size:13px;color:var(--navy-600);">
            ${f.c || ''}${f.co ? ' · ' + f.co : ''}${f.fd ? ' · 成立 ' + f.fd : ''}
          </div>
        </div>
        <div style="text-align:center;min-width:150px;">
          <div style="font-size:11px;color:var(--navy-500);letter-spacing:1px;">松果内部购买决策分</div>

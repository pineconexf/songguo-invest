  function statusNote(s) {
    const m = {
      'short_sample': '净值不足 244 个交易日（约 1 年），样本太短，暂不出数。',
      'no_nav': '净值数据尚未下载到位。',
      'bench_mismatch': '基金基准与自身净值序列拟合度偏低（R² 未达门槛），可能基准解析有偏差，暂不出数以免给出错误超额。',
      'missing_index': '基准所需的指数行情数据缺失。',
      'no_benchmark': '该基金未披露业绩比较基准。',
    };
    return m[s] || '数据不足。';
  }

  // ---------------------------------------------------------------- 搜索
  let SUG = [];
  function buildIndex() {
    // 索引（fund_scorecard_idx.json）已含场内+场外全市场，且自带 shard 路由字段。
    const seen = new Set();
    SUG = [];
    for (const f of DB.funds) {
      if (seen.has(f.c)) continue;
      seen.add(f.c);
      SUG.push(f);
    }
  }

  function search(q) {
    q = q.trim().toLowerCase();
    if (!q) return [];
    const out = [];
    for (const f of SUG) {
      const c = (f.c || '').toLowerCase(), n = (f.n || '').toLowerCase(), co = (f.co || '').toLowerCase();
      let sc = 0;
      if (c === q) sc = 100;
      else if (c.startsWith(q)) sc = 90;
      else if (c.includes(q)) sc = 70;
      else if (n.includes(q)) sc = 60;
      else if (co.includes(q) && n.includes(q)) sc = 50;
      else if (co.includes(q)) sc = 30;
      else if (f.pg && f.pg.toLowerCase().includes(q)) sc = 25;
      if (sc > 0) out.push({ ...f, sc });
    }
    out.sort((a, b) => b.sc - a.sc);
    // 份额去重：同一基金 A/C 只保留一个，避免刷屏
    const seen = new Set(), ded = [];
    for (const f of out) {
      const base = (f.n || '').replace(/[-－][A-Ea-e]$/, '').trim();
      const k = base + '|' + (f.co || '');
      if (seen.has(k)) continue;
      seen.add(k); ded.push(f);
    }
    return ded.slice(0, 40);
  }

  let si = -1, curSug = [];
  function showSug(list) {
    curSug = list;
    const box = $('#fs-suggest');
    if (!list.length) { box.style.display = 'none'; si = -1; return; }
    box.innerHTML = list.map((f, i) => `<div data-i="${i}" style="padding:8px 12px;cursor:pointer;border-bottom:1px solid rgba(139,94,60,0.08);font-size:13px;">
      <span style="font-weight:600;">${f.n || ''}</span>
      <span style="color:var(--navy-500);font-size:12px;"> ${f.c}</span>
      <span style="color:var(--navy-500);font-size:11px;"> · ${f.tp || ''} · ${f.pg || ''}</span>
    </div>`).join('');
    box.style.display = 'block';
    si = -1;
    box.querySelectorAll('[data-i]').forEach(d => d.addEventListener('click', () => {
      const f = list[+d.dataset.i];
      $('#fs-q').value = f.c;
      box.style.display = 'none';
      doRun(f.c);
    }));
  }

  // ---- 详情懒加载 ----
  // 分片号由构建端（Python hashlib.md5）算好写进 fund_scorecard_idx.json 的 shard 字段。
  // **不要在前端重算 md5**：两套实现的字节序/编码稍有差异就会算到别的片，
  // 表现为「有的基金点开是空白」，很难查。
  const SHARDS = {};        // 已加载分片: shardId → {code → fund}
  const SHARD_URL = {};     // shardId → 文件名

  async function ensureShard(shardId) {
    if (SHARDS[shardId]) return SHARDS[shardId];
    if (shardId === undefined || shardId === null) return null;
    // 注意：shardId 是 md5 首字符（如 'c'），**不是数组下标**。
    // 早先写成 SHARD_LIST[shardId] 拿数组下标，'c' 越界 → 所有详情都加载失败。
    const url = SHARD_URL[shardId];
    if (!url) return null;
    const r = await fetch(BASE + url);
    if (!r.ok) return null;
    const j = await r.json();
    const map = {};
    for (const x of j.funds) map[x.c] = x;
    SHARDS[shardId] = map;
    return map;
  }

  // ---------- 同类榜单 ----------
  // 同一组的基金散落在 16 个分片里，所以要按组把涉及的分片全拉起来。
  // 组内基金数上限 2 万，只按前 200 只渲染，避免一次画太多 DOM。
  async function loadPeerFunds(peer) {
    const metas = DB.funds.filter(x => x.pg === peer);
    const need = Array.from(new Set(metas.map(x => x.s)));
    await Promise.all(need.map(ensureShard));
    const out = [];
    for (const mt of metas) {
      const m = SHARDS[mt.s];
      if (m && m[mt.c]) out.push(m[mt.c]);
    }
    return out;
  }

  const ORD_LABEL = {
    tt: '总分', pa: '同类排位', pm: '回撤控制', ps: '收益稳定性',
    pst: '超额稳定性', pt: '择时能力',
  };

  async function renderRank() {
    const peer = $('#fs-rank-peer').value;
    const order = $('#fs-rank-order').value;
    const box = $('#fs-rank-list');
    if (!peer) { box.innerHTML = ''; $('#fs-rank-cnt').textContent = ''; return; }
    box.innerHTML = '<div style="color:var(--navy-500);font-size:13px;padding:12px 0;">正在载入该组数据…</div>';
    const rows = await loadPeerFunds(peer);
    // 份额去重：同一只基金的 A/C/E 份额净值、分位、持仓完全一致，
    // 同组同时上榜会虚增组内数量，也会让「同类排位」看着虚高。
    // 保留有总分的那个份额（通常 A 类规模最大、成立最早）。
    const byBase = new Map();
    for (const r of rows) {
      const b = (r.n || '').replace(/[-－][A-Ea-e]$/, '').trim() + '|' + (r.co || '');
      const cur = byBase.get(b);
      if (!cur) { byBase.set(b, r); continue; }
      const curHas = cur.tt !== null && cur.tt !== undefined;
      const newHas = r.tt !== null && r.tt !== undefined;
      if (newHas && !curHas) byBase.set(b, r);
    }
    const uniq = Array.from(byBase.values());
    const ok = uniq.filter(r => r.tt !== null && r.tt !== undefined);
    ok.sort((a, b) => (b[order] ?? -1e9) - (a[order] ?? -1e9));
    $('#fs-rank-cnt').textContent =
      `该组 ${uniq.length} 只（原始 ${rows.length} 只，已去重 A/C 份额）· 已出分 ${ok.length} 只`;
    const top = ok.slice(0, 200);
    box.innerHTML = `
      <div style="overflow-x:auto;">
      <table style="width:100%;border-collapse:collapse;font-size:13px;">
        <thead><tr style="text-align:left;border-bottom:1px solid var(--border);color:var(--navy-500);">
          <th style="padding:6px 8px;">#</th><th style="padding:6px 8px;">基金</th>
          <th style="padding:6px 8px;">类型</th>
          <th style="padding:6px 8px;">总分</th>
          <th style="padding:6px 8px;">${order === 'tt' ? '同类排名' : (ORD_LABEL[order] || order)}</th>
          <th style="padding:6px 8px;">近1年</th><th style="padding:6px 8px;">最大回撤</th>
          <th style="padding:6px 8px;"></th>
        </tr></thead>
        <tbody>${top.map((r, i) => `
          <tr style="border-bottom:1px solid var(--border);">
            <td style="padding:6px 8px;color:var(--navy-400);">${i + 1}</td>
            <td style="padding:6px 8px;">${r.n || '—'}<div style="color:var(--navy-400);font-size:11px;">${r.c}</div></td>
            <td style="padding:6px 8px;color:var(--navy-500);">${r.tp || '—'}</td>
            <td style="padding:6px 8px;font-weight:700;color:var(--gold);">${r.tt === null || r.tt === undefined ? '—' : Number(r.tt).toFixed(1)}</td>
            <td style="padding:6px 8px;color:var(--navy-500);">${order === 'tt' ? (i + 1) : (nz(r[order]) === null ? '—' : Number(r[order]).toFixed(1))}</td>
            <td style="padding:6px 8px;">${pct(nz(r.r1), 1)}</td>
            <td style="padding:6px 8px;">${pct(nz(r.md), 1)}</td>
            <td style="padding:6px 8px;"><button class="fs-linkbtn"
              onclick="window.__fsRun('${r.c}')">看详情</button></td>
          </tr>`).join('')}</tbody>
      </table></div>
      ${ok.length > 200 ? '<div style="font-size:12px;color:var(--navy-400);padding-top:8px;">仅显示前 200 只，请用上方搜索框查具体基金。</div>' : ''}`;
  }



  // ---- 组合候选集：打通到「ETF 组合配置器」 ----
  // 候选存 localStorage 而不是只放 URL：URL 长度有限，且用户往往是
  // 一边看榜单一边攒几只，最后一次性送进配置器。
  const CAND_KEY = 'songguo_fund_candidates';
  function getCands() {
    try { return JSON.parse(localStorage.getItem(CAND_KEY) || '[]'); }
    catch { return []; }
  }
  function setCands(a) {
    try { localStorage.setItem(CAND_KEY, JSON.stringify(a.slice(-12))); } catch { /* 隐私模式忽略 */ }
  }
  window.__fsAdd = function (code) {
    const a = getCands();
    if (a.includes(code)) {
      setCands(a.filter((x) => x !== code));
      flash('已从候选中移除');
    } else {
      a.push(code);
      setCands(a);
      flash('已加入候选（' + a.length + ' 只）');
    }
  };
  window.__fsGoAlloc = function () {
    const a = getCands();
    if (!a.length) { flash('还没有候选，先在榜单里点「加入组合」'); return; }
    location.href = '/songguo-invest/tools/etf-allocator/?add=' + a.join(',');
  };
  function flash(msg) {
    const t = document.getElementById('fs-addtip');
    if (t) t.textContent = msg;
  }

  async function doRun(code) {
    const meta = (DB.funds || []).find(x => x.c === code);
    if (!meta) {
      $('#fs-result').innerHTML = `<div class="card" style="max-width:980px;margin:24px auto;padding:20px;color:#B4553A;">
        没找到代码 ${code} 对应的基金。试试从下拉里点选，或换个关键词。</div>`;
      return;
    }
    $('#fs-result').innerHTML = `<div class="card" style="max-width:980px;margin:24px auto;padding:20px;color:var(--navy-600);">
      正在载入 ${meta.n || code} 的详细数据…</div>`;
    const m = await ensureShard(meta.s);
    const f = m ? m[code] : null;
    if (!f) {
      $('#fs-result').innerHTML = `<div class="card" style="max-width:980px;margin:24px auto;padding:20px;color:#B4553A;">
        ${code} 的详细数据分片加载失败，请刷新页面重试。</div>`;
      return;
    }
    renderResult(f);
    window.scrollTo({ top: $('#fs-result').offsetTop - 20, behavior: 'smooth' });
  }

  // ---------------------------------------------------------------- 方法论区
  function renderMethod() {
    $('#fs-method').innerHTML = `
      <p style="margin:0 0 14px;"><b>被动 6 维（权重公开）</b>：同类排位 25% / 回撤控制 20% / 收益稳定性 20% /
      费率 15% / 规模稳定 10% / 持仓透明度 10%。</p>
      <p style="margin:0 0 14px;"><b>主动 7 维（权重公开）</b>：长期业绩 20% / 回撤控制 15% / 风险回报效率 15% /
      超额收益稳定性 15% / 择时能力 10% / 基金经理 15% / 费率与规模 10%。</p>
      <p style="margin:0 0 14px;"><b>为什么被动和主动要分开评。</b>上海证券 2023 年《基金评价方法》明确指出，
      被动基金不做传统评级 —— 它的业绩基本由跟踪指数决定，评级经理能力没有意义。
      所以被动基金<b>不评「经理选股能力」</b>，而评「同类排位、回撤控制、收益稳定性、费率、规模、持仓透明度」，
      这是买 ETF/联接基金真正会关心的东西。主动基金才谈超额、择时、经理。</p>
      <p style="margin:0 0 14px;"><b>A 值 / T 值怎么来的。</b>对每只基金<b>自己的复合基准</b>（如
      「沪深300×50% + 中债×30% + 活期存款×20%」按披露权重合成）做日频回归：
      A 值 = 回归截距 × 年化，即年化超额收益；T 值 = 滚动回归 t 统计量的均值，衡量超额收益里有多少来自择时。
      基准必须用<b>全收益指数</b>（已按中证 {原码}CNY01.CSI 规则补齐 509 个全收益指数），
      否则分红漏算会系统性低估超额 —— 实测沪深300价格年化 7.00%、全收益 9.03%，差 2.02 个百分点。</p>
      <p style="margin:0 0 14px;"><b>出门控，不出错数。</b>净值不足 244 个交易日、基准无法解析、
      或基准拟合 R² 未达门槛（权益 0.30 / 债券货币 0.08）时，A/T 一律显示「暂不可计算」并说明原因，
      <b>绝不填 0 充数</b>。缺失维度按剩余权重归一化，同时在数据完整度里扣分显示。</p>
      <p style="margin:0;"><b>同类分位去重。</b>同一基金的 A/C/E 等份额净值不同但本质是同一只产品，
      同类排名按份额族去重，避免一只基金占多个席位拉高或压低分位。</p>`;
  }

  // ---------------------------------------------------------------- 启动
  async function boot() {
    renderMethod();
    try {
      const [r1, r2] = await Promise.all([
        fetch(BASE + 'fund_scorecard_idx.json'),
        fetch(BASE + 'fund_holdings.json'),
      ]);
      DB = await r1.json();
      HOLD = await r2.json().catch(() => ({}));
      const mf = await fetch(BASE + 'fund_shards.json').then(r => r.json()).catch(() => null);
      if (mf && mf.shards) {
        for (const fn of mf.shards) {
          // fund_shard_c.json → key 'c'
          const m = /fund_shard_([0-9a-f])\.json$/.exec(fn);
          if (m) SHARD_URL[m[1]] = fn;
        }
      }
      // 导航里的配置器链接：已有候选时自动带上 ?add= 参数
      const navAlloc = document.getElementById('fs-nav-alloc');
      if (navAlloc) {
        const pre = getCands();
        if (pre.length) navAlloc.setAttribute('href', '/songguo-invest/tools/etf-allocator/?add=' + pre.join(','));
      }
      buildIndex();
      const ok = DB.n_scored !== undefined ? DB.n_scored
                : DB.funds.filter(f => f.tt !== null && f.tt !== undefined).length;
      const pax = DB.funds.filter(f => f.pg && (f.pg.includes('港股') || f.pg.includes('海外'))).length;

      // 同类组下拉：按基金数降序，只列 ≥30 只的组（太小的组分位不可靠）
      const pgCount = {};
      for (const f of DB.funds) {
        if (f.pg) pgCount[f.pg] = (pgCount[f.pg] || 0) + 1;
      }
      const sel = $('#fs-rank-peer');
      for (const [k, v] of Object.entries(pgCount).sort((a, b) => b[1] - a[1])) {
        if (v < 30) continue;
        const o = document.createElement('option');
        o.value = k; o.textContent = `${k}（${v.toLocaleString()} 只）`;
        sel.appendChild(o);
      }
      $('#fs-rank-peer').addEventListener('change', renderRank);
      $('#fs-rank-order').addEventListener('change', renderRank);
      window.__fsRun = doRun;
      $('#fs-stats').innerHTML = `<span>全市场 <b>${(DB.n_funds || DB.funds.length).toLocaleString()}</b> 只基金</span>
        <span>已出分 <b>${ok.toLocaleString()}</b> 只</span>
        <span>可下钻持仓 <b>${(DB.n_holdings || 0).toLocaleString()}</b> 只</span>
        <span>跨市场基金 <b>${pax.toLocaleString()}</b> 只</span>
        <span>数据构建 ${DB.built || '—'}</span>`;
    } catch (e) {
      $('#fs-stats').innerHTML = `<span style="color:#B4553A;">数据加载失败：${e.message}</span>`;
    }

    const inp = $('#fs-q');
    inp.addEventListener('input', () => { if (DB) showSug(search(inp.value)); });
    inp.addEventListener('focus', () => { if (DB && inp.value.trim()) showSug(search(inp.value)); });
    inp.addEventListener('keydown', e => {
      if (e.key === 'Enter') {
        e.preventDefault();
        if (si >= 0 && curSug[si]) { $('#fs-q').value = curSug[si].c; $('#fs-suggest').style.display = 'none'; doRun(curSug[si].c); }
        else doRun(inp.value.trim());
      } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (!curSug.length) return;
        si = e.key === 'ArrowDown' ? Math.min(si + 1, curSug.length - 1) : Math.max(si - 1, 0);
        $('#fs-suggest').querySelectorAll('[data-i]').forEach((d, i) => {
          d.style.background = i === si ? 'rgba(217,164,65,0.15)' : 'transparent';
        });
      } else if (e.key === 'Escape') { $('#fs-suggest').style.display = 'none'; }
    });
    document.addEventListener('click', e => {
      if (!e.target.closest('#fs-q') && !e.target.closest('#fs-suggest')) $('#fs-suggest').style.display = 'none';
    });
    $('#fs-run').addEventListener('click', () => {
      const v = inp.value.trim();
      if (!v) { inp.focus(); return; }
      doRun(v);
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
  </script>
</Layout>
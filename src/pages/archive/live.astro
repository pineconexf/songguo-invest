---
import Layout from '../../layouts/Layout.astro';
import live from '../../data/live_records.json';

const periods = live.periods;
---
<Layout
  title="实盘档案"
  description="松果实盘运行档案 — 每次建仓/调仓/策略升级的完整逻辑：预判依据、宏观因素、个股选择、投前投后、组合细节。"
>
  <!-- Hero -->
  <section class="hero" style="padding: 48px 40px;">
    <div class="hero-inner">
      <span class="eyebrow">Live Archive · 实盘档案</span>
      <h1>
        <span class="gold">每一次操作</span>的逻辑<br />都有记录
      </h1>
      <p class="hero-lead">
        实盘与模拟盘每次建仓、调仓、策略升级的完整档案：预判逻辑、宏观因素、个股选择、投前投后数据对比、组合管理细节。
        往后每一期持续追加，全部可追溯。
      </p>
    </div>
  </section>

  {
    periods.map((period) => (
      <section class="card">
        <div class="section-head">
          <div class="section-kicker">{period.period}</div>
          <h2 class="section-title">{period.title}</h2>
          <p class="section-sub">{period.summary}</p>
        </div>

        <!-- 账户快照 -->
        <div class="metric-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom: 24px;">
          <div class="metric-card">
            <div class="label">期初总资产</div>
            <div class="value">¥{period.account.initial.toLocaleString()}</div>
            <div class="sub">V25 启动</div>
          </div>
          <div class="metric-card">
            <div class="label">期末总资产</div>
            <div class="value gold">¥{period.account.final.toLocaleString()}</div>
            <div class="sub">V32 杠杆版</div>
          </div>
          <div class="metric-card">
            <div class="label">起始策略</div>
            <div class="value" style="font-size: 18px;">{period.account.strategy_start}</div>
            <div class="sub">纯多头 Top5</div>
          </div>
          <div class="metric-card">
            <div class="label">期末策略</div>
            <div class="value" style="font-size: 18px;">{period.account.strategy_end}</div>
            <div class="sub">1.5x 融资杠杆</div>
          </div>
        </div>

        <!-- 事件时间线 -->
        <div class="steps">
          {
            period.events.map((ev, i) => (
              <div class="step">
                <div class="num">{i + 1}</div>
                <div class="body" style="flex:1;">
                  <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:4px;">
                    <span style="font-size:12px; color:var(--gold-600); font-weight:700; letter-spacing:0.5px;">{ev.date}</span>
                    <span style="font-size:11px; padding:2px 10px; border-radius:999px; background:var(--gold-100); color:var(--gold-600); font-weight:600;">{ev.type}</span>
                    <h3 style="margin:0; font-size:15.5px; color:var(--navy-800);">{ev.title}</h3>
                  </div>
                  <p style="font-size:13.5px; color:var(--text-2); margin:6px 0;"><b>逻辑：</b>{ev.logic}</p>
                  {
                    ev.macro && (
                      <p style="font-size:13px; color:var(--text-2); margin:4px 0; background:var(--surface-alt); border-radius:6px; padding:6px 10px;">
                        🧭 <b>宏观因素：</b>{ev.macro}
                      </p>
                    )
                  }
                  {
                    ev.details && ev.details.holdings && (
                      <div style="margin-top:8px;">
                        <p style="font-size:12.5px; color:var(--text-3); margin-bottom:6px;">持仓明细：</p>
                        <div class="table-wrap">
                          <table class="data-table">
                            <thead><tr><th>代码</th><th>名称</th><th>股数</th><th>价格</th><th>权重</th></tr></thead>
                            <tbody>
                              {
                                ev.details.holdings.map((h: any) => (
                                  <tr>
                                    <td>{h.code}</td>
                                    <td>{h.name}</td>
                                    <td>{h.shares}</td>
                                    <td>{h.price}</td>
                                    <td>{h.weight}</td>
                                  </tr>
                                ))
                              }
                            </tbody>
                          </table>
                        </div>
                      </div>
                    )
                  }
                  {
                    ev.details && ev.details.trades && (
                      <div style="margin-top:8px;">
                        <p style="font-size:12.5px; color:var(--text-3); margin-bottom:6px;">交易明细：</p>
                        <div class="table-wrap">
                          <table class="data-table">
                            <thead><tr><th>操作</th><th>代码</th><th>名称</th><th>股数</th><th>说明</th></tr></thead>
                            <tbody>
                              {
                                ev.details.trades.map((t: any, ti: number) => (
                                  <tr key={ti}>
                                    <td class:list={t.op === '买入' ? 'pos' : 'neg'}>{t.op}</td>
                                    <td>{t.code}</td>
                                    <td>{t.name}</td>
                                    <td>{t.shares}</td>
                                    <td style="text-align:left; font-size:12.5px;">{t.reason ?? t.price ?? ''}</td>
                                  </tr>
                                ))
                              }
                            </tbody>
                          </table>
                        </div>
                      </div>
                    )
                  }
                  {
                    ev.details && (ev.details.action || ev.details.total_asset || ev.details.leverage || ev.details.margin_ratio || ev.details.note) && (
                      <div style="margin-top:8px; font-size:13px; color:var(--text-2);">
                        {ev.details.action && <p style="margin:2px 0;">⚙️ {ev.details.action}</p>}
                        {ev.details.total_asset && <p style="margin:2px 0;">💼 总资产：{ev.details.total_asset}</p>}
                        {ev.details.leverage && <p style="margin:2px 0;">⚖️ 杠杆：{ev.details.leverage}</p>}
                        {ev.details.margin_ratio && <p style="margin:2px 0;">🛡️ 维保：{ev.details.margin_ratio}</p>}
                        {ev.details.note && <p style="margin:2px 0;">📝 {ev.details.note}</p>}
                      </div>
                    )
                  }
                  {
                    ev.note && (
                      <p style="font-size:12.5px; color:#7a2e2e; background:var(--red-bg); border-radius:6px; padding:6px 10px; margin-top:6px;">⚠️ {ev.note}</p>
                    )
                  }
                </div>
              </div>
            ))
          }
        </div>

        <!-- 下期动作 -->
        <div class="callout" style="margin-top: 16px;">
          <b>下期动作</b>：{period.next_action}
        </div>
      </section>
    ))
  }

  <div class="callout">
    <b>档案机制</b>：每期实盘/模拟盘记录按月整理入库（live_records.json），自动同步至网站。预判逻辑、宏观因素、个股选择、投前投后、组合细节五要素逐项记录，往后每一期持续追加。
  </div>
</Layout>

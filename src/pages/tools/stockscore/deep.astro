---
import Layout from '../../../layouts/Layout.astro';

// 个股打分卡 V3 · 深度（旧入口，2026-10-21 改为跳转）
//
// 坑（2026-10-21）：模块化重构后，深度正文被拆进质地/价格/势能/风险四个分页，
// 原来的 /deep/ 单页（六段全文 + 独立口播版）与新结构重复，
// 保留它会出现「两套深度页、同一份数据、两个 URL」——收藏/分享必然走形。
// 所以这里不再自己渲染，改成跳到总览页；旧链接（外部分享、公众号）不会 404。
---
<Layout
  title="个股打分卡 V3 · 深度"
  description="深度分析已按质地、价格、势能、风险四个分页拆分，每页带对应评分卡支撑数据与事实证据。"
>
  <section style="padding: 52px 48px 40px;">
    <div class="hero-inner">
      <span class="eyebrow">Free Tool · 个股打分卡 V3</span>
      <h1>深度分析已按四个分页拆分</h1>
      <p class="hero-lead">
        业务结构与差异化壁垒在<b>质地</b>，数字检验与估值与预期在<b>价格</b>，
        市场空间在<b>势能</b>，风险与安全、跨段矛盾与复核意见在<b>风险</b>。
        每页都带对应的评分卡支撑数据与可溯源事实。
      </p>
      <div class="callout" style="margin-top: var(--sp-4);">
        正在跳转到总览页…若未自动跳转，<a href="/tools/stockscore/">点此进入</a>。
      </div>
    </div>
  </section>
</Layout>

<script>
  // 保留 query（?code=），跳到总览页
  // 坑（2026-10-21）：不能用绝对路径 '/tools/stockscore/'——
  // GitHub Pages 线上 base 是 /songguo-invest（子路径），
  // 绝对路径会 404。本地 serve_dist 剥掉前缀后反而"能用"，本地测不出来。
  (function () {
    var p = location.pathname.replace(/\/+$/, '');
    var m = p.match(/^(.*\/stockscore)\/deep$/);
    var base = m ? m[1] : p.replace(/\/deep$/, '');
    location.replace(base + '/' + (location.search || ''));
  })();
</script>

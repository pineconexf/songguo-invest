        $('fs-conclusion-flag-label').style.color = role.flagColor;
        $('fs-conclusion-stock').innerHTML = stockPct !== null ? num(stockPct) + '%' : '—';
        $('fs-conclusion-vol').innerHTML = volTxt !== null ? num(volTxt) + '%' : '—';
        $('fs-conclusion-ret').innerHTML = pct(w.syl_1n);

        // 固收+警示（V3 新增）：固收+ 股票仓位 >20% 红条提示
        const conclusionWarnEl = $('fs-conclusion-warn');
        if (role.role.includes('固收+') && stockPct !== null && stockPct > 20) {
          conclusionWarnEl.style.display = '';
          conclusionWarnEl.innerHTML = `⚠️ <b>股票仓位 ${num(stockPct)}% 偏高</b>——超过 20% 的固收+ 基金，实际波动会比"固收"标签暗示的更大。请把它当权益类对待，按股票仓位而非合同类型评估风险。`;
        } else {
          conclusionWarnEl.style.display = 'none';
        }

        // 保存结果供复制使用
        _lastResult = {
          code, name: w.fS_name, role: role.role,
          stockPct, vol: r1y ? r1y.vol : null,
          r1y: w.syl_1n ? parseFloat(w.syl_1n) : null,
          totalScore: sc.total, grade: sc.grade, weight: role.weight,
          xvalWarn: xvalWarn || '表里一致，无明显警示',
        };
        $('fs-copy').onclick = () => copyText(buildCopyText(_lastResult), $('fs-copy'));

        ['card-conclusion', 'card-nav', 'card-position', 'card-role', 'card-xval'].forEach((id) => $(id).style.display = '');
        status(`✔ ${w.fS_name} 体检完成`, 'ok');
      } catch (e) {
        status('❌ ' + e.message + '。请核对代码（可在天天基金搜索确认），或稍后重试。', 'warn');
      }
    }

    function status(msg, type) {
      const el = $('fs-status');
      el.style.display = '';
      el.style.background = type === 'warn' ? 'rgba(179,84,62,0.08)' : 'rgba(74,124,89,0.08)';
      el.style.color = type === 'warn' ? 'var(--red)' : 'var(--green)';
      el.textContent = msg;
    }

    $('fs-run')?.addEventListener('click', run);
    $('fs-code')?.addEventListener('keydown', (e) => { if (e.key === 'Enter') run(); });

    // V3.1 联动：从排名页跳转带 ?code= 参数 → 预填并自动体检
    const urlCode = new URLSearchParams(location.search).get('code');
    if (urlCode && /^\d{6}$/.test(urlCode)) {
      $('fs-code').value = urlCode;
      run();
    }
  </script>

<style>
  /* 长文字表格（特色卡）：允许换行，消除横向滚动条 */
  .wrap-cells th,
  .wrap-cells td {
    white-space: normal;
    text-align: left;
    line-height: 1.6;
  }
</style>
</Layout>
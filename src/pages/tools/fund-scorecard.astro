---
import Layout from '../../layouts/Layout.astro';

// 基金打分卡（规则型五维）：收益 / 回撤 / 费率 / 规模 / 经理年限
// 方法论对标松果生活投资策略「选品五标准」：同类夏普横向比、历史回撤、规模(百亿是收益的敌人)、管理人框架稳定、费率
// 数据不足时用规则打分：用户输入基金五维参数，工具按松果口径给分+档位
const dims = [
  { key: 'ret', label: '收益', weight: 30, desc: '近 1 年收益率（%）' },
  { key: 'mdd', label: '回撤', weight: 25, desc: '近 1 年最大回撤（%，填正数）' },
  { key: 'fee', label: '费率', weight: 15, desc: '管理费率（%）' },
  { key: 'size', label: '规模', weight: 15, desc: '基金规模（亿元）' },
  { key: 'mgr', label: '经理年限', weight: 15, desc: '现任经理任职年限（年）' },
];
---
<Layout
  title="基金打分卡"
  description="松果基金打分卡 — 收益/回撤/费率/规模/经理年限五维规则打分，帮你在候选基金里筛出优质标的。免费工具，不构成投资建议。"
>
  <section class="hero" style="padding: 56px 48px;">
    <div class="hero-inner">
      <span class="eyebrow">Free Tool · 基金壳选品</span>
      <h1>
        别问哪只涨得多，<br /><span class="gold">问它负责什么、扛不扛得住</span>
      </h1>
      <p class="hero-lead">
        收益只是一面。回撤、费率、规模、经理——五维打分，30 秒给候选基金一张体检卡。
        评分逻辑对标松果生活投资策略选品五标准，纯规则、可解释、不黑箱。
      </p>
    </div>
  </section>

  <section class="card" style="max-width: 860px; margin: 0 auto;">
    <div class="section-head">
      <div class="section-kicker">Scorecard · 五维打分</div>
      <h2 class="section-title">输入基金参数</h2>
      <p class="section-sub">参数来自基金 App/天天基金/晨星等公开数据。打分规则固定公开，结果可复算。</p>
    </div>

    <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); margin-bottom: var(--sp-4);">
      <label class="valuator-field">
        <span>基金代码 / 名称（可选）</span>
        <input id="fs-code" type="text" placeholder="如 002351 易方达裕祥回报" />
      </label>
      <label class="valuator-field">
        <span>近 1 年收益率（%）</span>
        <input id="fs-ret" type="number" step="0.1" min="-100" placeholder="如 12.5" />
      </label>
      <label class="valuator-field">
        <span>近 1 年最大回撤（%，填正数）</span>
        <input id="fs-mdd" type="number" step="0.1" min="0" placeholder="如 8.5" />
      </label>
      <label class="valuator-field">
        <span>管理费率（%）</span>
        <input id="fs-fee" type="number" step="0.05" min="0" placeholder="如 0.8" />
      </label>
      <label class="valuator-field">
        <span>基金规模（亿元）</span>
        <input id="fs-size" type="number" step="1" min="0" placeholder="如 85" />
      </label>
      <label class="valuator-field">
        <span>现任经理任职年限（年）</span>
        <input id="fs-mgr" type="number" step="0.5" min="0" placeholder="如 6" />
      </label>
    </div>

    <button id="fs-run" class="btn btn-gold" style="width:100%;">开始打分 →</button>

    <div id="fs-result" style="display:none; margin-top: var(--sp-5); border-top: 1px solid rgba(139,94,60,0.15); padding-top: var(--sp-4);">
      <div style="display:flex; align-items:center; gap: var(--sp-4); flex-wrap: wrap;">
        <div style="text-align:center;">
          <div id="fs-score" class="value gold" style="font-size:44px;">--</div>
          <div style="font-size:13px; color: var(--navy-600);">综合评分（0-100）</div>
        </div>
        <div>
          <div id="fs-grade" class="slogan" style="font-size:22px; margin:0;">--</div>
          <div id="fs-oneword" style="font-size:14px; color: var(--navy-600); margin-top:4px;">--</div>
        </div>
      </div>
      <div id="fs-bars" style="margin-top: var(--sp-4); display:grid; gap: var(--sp-2);"></div>
      <div class="callout" style="margin-top: var(--sp-4);">
        <b>规则说明</b>：收益 30%（近1年 ≥20% 满分）、回撤 25%（MDD ≤5% 满分）、费率 15%（管理费 ≤0.5% 满分）、
        规模 15%（20-100 亿最舒适——百亿是收益的敌人，太小有清盘风险）、经理年限 15%（≥7 年满分，策略稳定性代理）。
        本工具为方法论演示，<b>不构成投资建议</b>，不打分任何具体基金的投资价值。
      </div>
    </div>
  </section>

  <div class="callout" style="max-width: 860px; margin: var(--sp-4) auto 0;">
    <b>五维口径</b>：
    <b>收益</b>——近 1 年绝对收益（同类横向比更准，可代入同类中位数对照）；
    <b>回撤</b>——极端年扛不扛得住，拿得住才能长期赚；
    <b>费率</b>——申赎+管理费侵蚀复利，指数/债基应 &lt;0.5%；
    <b>规模</b>——百亿是收益的敌人，20-100 亿最舒适；
    <b>经理年限</b>——≥3 年硬过滤对冲风格漂移，策略透明优先。
        完整方法论见 <a href="/songguo-invest/portfolio/">组合管理</a>。
      </div>

      <!-- 竞品对比：晨星评级 / 天天基金评分 vs 松果（真实调研 2026-08） -->
      <section class="card" style="max-width: 860px; margin: var(--sp-4) auto 0;">
        <div class="section-head">
          <div class="section-kicker">基准对比 · 同类工具</div>
          <h2 class="section-title">和市面上的"基金评分"比，差在哪？</h2>
          <p class="section-sub">对比基于各家公开功能（2026-08 调研）：星级只告诉你结果，松果把每个分为什么这么给摊开给你看。</p>
        </div>
        <div class="table-wrap">
          <table class="data-table">
            <thead><tr><th></th><th>晨星评级</th><th>天天基金评分</th><th style="background: rgba(217,164,65,0.08);">松果基金打分卡</th></tr></thead>
            <tbody>
              <tr><td><b>给你什么</b></td><td>1-5 星评级（同类相对）</td><td>综合评分 + 排名</td><td style="background: rgba(217,164,65,0.08);"><b>五维逐项打分 + 档位结论</b>（可入池/候选/谨慎/不达标）</td></tr>
              <tr><td><b>维度透明度</b></td><td>权重不公开，黑箱排名</td><td>维度不公开，黑箱排名</td><td style="background: rgba(217,164,65,0.08);"><b>五维公开固定</b>：收益30 回撤25 费率15 规模15 经理15，权重写在页面</td></tr>
              <tr><td><b>结论明确度</b></td><td>给星级，不说"适不适合你"</td><td>给分数，不说"该不该入池"</td><td style="background: rgba(217,164,65,0.08);"><b>给档位 + 短板提示</b>：哪一维拖后腿一眼可见</td></tr>
              <tr><td><b>适合谁</b></td><td>看榜单选基的普通用户</td><td>看排名选基的用户</td><td style="background: rgba(217,164,65,0.08);"><b>想按自己的标准筛基金、要可复算依据的人</b></td></tr>
            </tbody>
          </table>
        </div>
        <div style="font-size: 12px; color: var(--text-3); margin-top: 8px;">
          一句话：晨星/天天卖「星级/分数」，松果卖「<b>公开权重 + 可复算五维</b>」——为什么得这个分，你一眼能验证。
        </div>
      </section>

      <script>
    function run() {
      const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
      const ret = parseFloat($('fs-ret').value);
      const mdd = parseFloat($('fs-mdd').value);
      const fee = parseFloat($('fs-fee').value);
      const size = parseFloat($('fs-size').value);
      const mgr = parseFloat($('fs-mgr').value);
      const miss: string[] = [];
      if (!(ret >= -100)) miss.push('近1年收益'); if (!(mdd >= 0)) miss.push('最大回撤');
      if (!(fee >= 0)) miss.push('管理费率'); if (!(size >= 0)) miss.push('规模'); if (!(mgr >= 0)) miss.push('经理年限');
      if (miss.length) { alert('请填写：' + miss.join('、')); return; }

      // —— 五维打分 ——
      // 收益（30）：≥20% 满分；每低 2.5pp 减 5 分；负收益 0
      let sRet = 30;
      if (ret < 20) sRet = Math.max(0, 30 - Math.ceil((20 - ret) / 2.5) * 5);
      if (ret < 0) sRet = 0;
      // 回撤（25）：MDD ≤5% 满分；每多 3pp 减 5 分
      let sMdd = 25;
      if (mdd > 5) sMdd = Math.max(0, 25 - Math.ceil((mdd - 5) / 3) * 5);
      if (mdd > 30) sMdd = 0;
      // 费率（15）：≤0.5% 满分；0.8% 12；1.0% 10；1.2% 8；1.5% 5；更高 3
      let sFee = 3;
      if (fee <= 0.5) sFee = 15; else if (fee <= 0.8) sFee = 12; else if (fee <= 1.0) sFee = 10;
      else if (fee <= 1.2) sFee = 8; else if (fee <= 1.5) sFee = 5;
      // 规模（15）：20-100 亿满分；2-20 或 100-300 亿 10；<2 或 300-500 亿 5；>500 亿 2
      let sSize = 2;
      if (size >= 20 && size <= 100) sSize = 15;
      else if ((size >= 2 && size < 20) || (size > 100 && size <= 300)) sSize = 10;
      else if ((size < 2 && size > 0) || (size > 300 && size <= 500)) sSize = 5;
      else if (size <= 0) sSize = 0;
      // 经理年限（15）：≥7 年满分；5-7 12；3-5 8；1-3 4；<1 1
      let sMgr = 1;
      if (mgr >= 7) sMgr = 15; else if (mgr >= 5) sMgr = 12; else if (mgr >= 3) sMgr = 8; else if (mgr >= 1) sMgr = 4;

      const total = sRet + sMdd + sFee + sSize + sMgr;
      let grade = '不达标', word = '多项低于松果口径门槛，建议换候选或等参数改善';
      if (total >= 80) { grade = '优质（可入池）'; word = '五维均衡达标，可放进组合拼图候选池做同类横向比较'; }
      else if (total >= 65) { grade = '良好（候选）'; word = '整体合格，重点看短板维度能否接受'; }
      else if (total >= 50) { grade = '一般（谨慎）'; word = '有明显短板（回撤/费率/规模），仅适合特定角色'; }

      ($('fs-score') as HTMLElement).textContent = String(total);
      ($('fs-grade') as HTMLElement).textContent = grade;
      ($('fs-oneword') as HTMLElement).textContent = word;
      ($('fs-result') as HTMLElement).style.display = 'block';

      const bars = [
        { name: '收益（近1年）', val: sRet, max: 30, hint: `${ret >= 0 ? '+' : ''}${ret}% · ${ret >= 20 ? '优秀' : ret >= 10 ? '良好' : ret >= 0 ? '一般' : '亏损'}` },
        { name: '回撤（近1年）', val: sMdd, max: 25, hint: `MDD -${mdd}% · ${mdd <= 5 ? '控制优秀' : mdd <= 10 ? '可接受' : mdd <= 20 ? '偏大' : '过大'}` },
        { name: '费率（管理费）', val: sFee, max: 15, hint: `${fee}% · ${fee <= 0.5 ? '低成本' : fee <= 1.2 ? '适中' : '偏高'}` },
        { name: '规模', val: sSize, max: 15, hint: `${size} 亿 · ${size >= 20 && size <= 100 ? '舒适区' : size > 100 ? '偏大（收益敌人）' : size > 0 ? '偏小（清盘风险）' : '未成立'}` },
        { name: '经理年限', val: sMgr, max: 15, hint: `${mgr} 年 · ${mgr >= 5 ? '经验丰富' : mgr >= 3 ? '合格' : '偏短'}` },
      ];
      ($('fs-bars') as HTMLElement).innerHTML = bars.map((b) => `
        <div>
          <div style="display:flex; justify-content:space-between; font-size:13px; color:var(--navy-700); margin-bottom:4px;">
            <span>${b.name} <span style="color:var(--navy-600);">${b.hint}</span></span>
            <span style="font-weight:700; color:var(--gold-600);">${b.val}/${b.max} 分</span>
          </div>
          <div style="height:8px; background:rgba(139,94,60,0.12); border-radius:4px; overflow:hidden;">
            <div style="width:${b.val / b.max * 100}%; height:100%; background:linear-gradient(90deg, var(--gold-500), var(--gold-400)); border-radius:4px;"></div>
          </div>
        </div>`).join('');
    }
    document.getElementById('fs-run')?.addEventListener('click', run);
  </script>
</Layout>

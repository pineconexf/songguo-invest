---
import Layout from '../../layouts/Layout.astro';

// ETF 五维查询与排名（V1.0，2026-10-01）
// 数据：public/data/etf_score5d.json ← build_score5d.py ← etf_unified.json ← tushare
// 五维：跟踪纯度20 / 跟踪误差20 / 费率20 / 流动性20 / 规模稳健20
//
// 三条不可妥协的前端规则（与数据层一致）：
//   1. 缺维显示「—」，绝不用 0 代替。null ≠ 0，这是数据诚实问题不是显示问题。
//   2. 只有五维齐全才给总分，缺维不给总分（2,017 只）。主榜因此只有 271 只，
//      页面必须明说「为什么榜单这么短」，否则用户会以为数据不全。
//   3. 跟踪纯度与跟踪误差 r=0.64（同一件事的两种测法），必须并列展示。
//
// 为什么只有 271/2288 可打分：跟踪纯度与跟踪误差依赖 benchmark→指数映射，
// 而映射只覆盖到 703 只。这是数据边界，不是筛选条件 —— 页面如实说明。
---

<Layout
  title="ETF 五维查询"
  description="松果 ETF 五维评分 — 跟踪纯度 / 跟踪误差 / 费率 / 流动性 / 规模稳健，全市场场内 ETF 查询与排名。规则公开、口径写明、缺维如实显示为「—」。免费工具，不构成投资建议。"
>
  <section class="hero" style="padding: 52px 48px;">
    <div class="hero-inner">
      <span class="eyebrow">Free Tool · ETF 五维查询 V1.0</span>
      <h1>
        挑 ETF 不该看谁涨得多，<br /><span class="gold">该看它跟得紧不紧、扛不扛得住</span>
      </h1>
      <p class="hero-lead">
        全市场 <b id="hd-total">—</b> 只场内 ETF，五维打分：<b>跟踪纯度</b>、<b>跟踪误差</b>、
        <b>费率</b>、<b>流动性</b>、<b>规模稳健</b>，各 20 分。
        规则写死在本页、原始值全部可查；<b>数据缺失一律显示「—」，不用 0 顶替</b>。
      </p>
    </div>
  </section>

  <!-- ============ 口径先讲清 ============ -->
  <section class="card" style="max-width: 1080px; margin: 0 auto;">
    <div class="section-head">
      <div class="section-kicker">先讲口径</div>
      <h2 class="section-title">榜单为什么这么短</h2>
      <p class="section-sub" style="font-size:13px; line-height:1.85;">
        存续 <b id="hd-live">—</b> 只（清盘 678 只默认排除）。其中<b>五维齐全、可以打总分的只有 <span id="hd-score">—</span> 只</b>，
        因为「跟踪纯度」和「跟踪误差」两维必须先知道这只 ETF 跟踪哪只指数——
        我们能把 benchmark 映射到指数代码的只有 703 只，映射不上的两只指数维就是空的。
        <br /><b>我们不用 0 分填补。</b>把「没数据」写成 0，等于告诉用户「这只很差」，
        而真相是「这只我们还没算出来」——两者完全不同。所以缺维的 <span id="hd-nodim">—</span> 只只给单维速查，不进总分榜。
      </p>
    </div>
    <div class="table-wrap">
      <table class="data-table wrap-cells">
        <thead><tr><th>维度</th><th>权重</th><th>算的是什么</th><th>打分区间</th></tr></thead>
        <tbody id="dim-body"></tbody>
      </table>
    </div>
    <div style="font-size:12.5px; color:var(--navy-600); margin-top: var(--sp-3); line-height:1.8;">
      数据截至 <b id="hd-date">—</b> ｜ 来源：tushare（fund_basic / fund_nav / fund_daily / index_daily / index_basic）
      ｜ 跟踪误差仅对<b>纯单指数基准</b>计算——混合基准（如「沪深300×50%+中债×50%」）的 ETF 只承担部分权益，
      拿它对单一权益指数比会系统性高估偏离，属无效比较。
    </div>
  </section>

  <!-- ============ 查询与筛选 ============ -->
  <section class="card" style="max-width: 1080px; margin: var(--sp-5) auto 0;">
    <div class="section-head">
      <div class="section-kicker">查询与筛选</div>
      <h2 class="section-title">输代码或名称，直接看五维拆解</h2>
    </div>

    <div style="display:flex; gap: var(--sp-3); align-items:center; flex-wrap:wrap; margin-bottom: var(--sp-3);">
      <div style="flex:1; min-width:240px; position:relative;">
        <input id="q" type="text" placeholder="基金代码或名称（如 510300 / 沪深300 / 芯片）" autocomplete="off"
          style="width:100%; box-sizing:border-box; padding:11px 14px; border:1px solid rgba(139,94,60,0.25); border-radius:10px; font-size:15px; background:var(--bg); color:var(--navy-900);" />
        <div id="sug" style="display:none; position:absolute; z-index:30; top:calc(100% + 4px); left:0; right:0; max-height:300px; overflow-y:auto; background:var(--bg); border:1px solid rgba(139,94,60,0.3); border-radius:10px; box-shadow:0 6px 18px rgba(74,46,26,0.15);"></div>
      </div>
      <label style="font-size:13px; color:var(--navy-700); display:flex; align-items:center; gap:6px;">
        <input type="checkbox" id="f-full" style="width:15px; height:15px;" />
        只看五维齐全（可比）
      </label>
      <label style="font-size:13px; color:var(--navy-700); display:flex; align-items:center; gap:6px;">
        <input type="checkbox" id="f-delist" style="width:15px; height:15px;" />
        含已清盘
      </label>
    </div>

    <div id="filters" style="display:grid; grid-template-columns: repeat(auto-fit, minmax(170px,1fr)); gap: var(--sp-3); margin-bottom: var(--sp-3);"></div>

    <div style="display:flex; gap: var(--sp-2); flex-wrap:wrap; margin-bottom: var(--sp-3);">
      <select id="f-theme" style="padding:8px 12px; border-radius:8px; border:1px solid rgba(139,94,60,0.25); background:var(--bg); color:var(--navy-900); font-size:13px;">
        <option value="">全部主题</option>
      </select>
      <select id="f-asset" style="padding:8px 12px; border-radius:8px; border:1px solid rgba(139,94,60,0.25); background:var(--bg); color:var(--navy-900); font-size:13px;">
        <option value="">全部资产类别</option>
      </select>
      <select id="f-bench" style="padding:8px 12px; border-radius:8px; border:1px solid rgba(139,94,60,0.25); background:var(--bg); color:var(--navy-900); font-size:13px;">
        <option value="">全部基准类型</option>
      </select>
      <button id="reset" class="btn btn-outline" style="font-size:13px; padding:8px 14px;">重置</button>
    </div>

    <div id="count" style="font-size:13px; color:var(--navy-600); margin-bottom: var(--sp-2);">—</div>
    <div class="table-wrap">
      <table class="data-table" style="font-size:13px;">
        <thead>
          <tr>
            <th data-sort="ts_code">代码</th>
            <th data-sort="name">名称</th>
            <th data-sort="theme_tag">主题</th>
            <th data-sort="purity" class="sv">跟踪纯度</th>
            <th data-sort="te_ann" class="sv">跟踪误差</th>
            <th data-sort="fee" class="sv">费率</th>
            <th data-sort="amt" class="sv">日均成交</th>
            <th data-sort="issue" class="sv">发行规模</th>
            <th data-sort="total">总分</th>
          </tr>
        </thead>
        <tbody id="tbody"></tbody>
      </table>
    </div>
    <div id="more" style="text-align:center; margin-top: var(--sp-3);"></div>
  </section>

  <!-- ============ 单只详情 ============ -->
  <section class="card" id="detail" style="max-width: 1080px; margin: var(--sp-5) auto 0; display:none;">
    <div class="section-head">
      <div class="section-kicker">单只详情</div>
      <h2 class="section-title" id="d-title">—</h2>
      <p class="section-sub" id="d-sub">—</p>
    </div>
    <div id="d-body"></div>
  </section>

  <section class="callout" style="max-width: 1080px; margin: var(--sp-4) auto;">
    <b>口径、局限与合规</b><br />
    · <b>跟踪误差</b>是在价格指数上算的（多数 ETF 的官方基准其实是含分红再投的全收益指数），
    因此这里的 TE 会比官方披露值<b>系统性偏高一点</b>，这是已知偏差，我们选择如实呈现而不是调数字去对齐。<br />
    · <b>规模稳健</b>用的是发行时规模，<b>不是当前 AUM</b>——这是五维里口径最弱的一维，只作参考不作结论。<br />
    · <b>跟踪纯度</b>衡量的是净值涨跌有多少能被跟踪指数解释，不等于真实持仓穿透（我们没有逐只持仓与权重数据）。<br />
    · 本工具为方法论演示，<b>不构成投资建议</b>，不评估任何基金的投资价值。
  </section>

<script>
  // base 兼容：云端 '/'，GitHub Pages '/songguo-invest/'
  var BASE = location.pathname.replace(/tools\/etf-score5d\/.*$/, '');
  var DIMS = [
    { k: 'purity', nm: '跟踪纯度', w: 20, unit: '%', lo: 80, hi: 99.5, dir: 1 },
    { k: 'te_ann', nm: '跟踪误差', w: 20, unit: '%', lo: 0.5, hi: 8.0, dir: -1 },
    { k: 'fee', nm: '费率', w: 20, unit: '%', lo: 0.20, hi: 1.00, dir: -1 },
    { k: 'amt', nm: '流动性', w: 20, unit: '百万元', lo: 5, hi: 500, dir: 1 },
    { k: 'issue', nm: '规模稳健', w: 20, unit: '亿元', lo: 1, hi: 50, dir: 1 }
  ];
  var $ = function (id) { return document.getElementById(id); };
  var DATA = null, FUNDS = [], ROWS = [], sortK = 'total', sortD = -1, shown = 60;
  var MISS = '—';   // 缺失一律显示破折号，绝不显示 0

  function n2(v, d) { return (v === null || v === undefined || isNaN(v)) ? MISS : Number(v).toFixed(d === undefined ? 2 : d); }
  function esc(s) { return String(s === null || s === undefined ? '' : s).replace(/[&<>"]/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]; }); }

  fetch(BASE + 'data/etf_score5d.json')
    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function (d) {
      DATA = d; FUNDS = d.funds;
      renderMeta(); buildDims(); buildFilters(); buildSelects(); render();
      // 联动：?code=510300 直接展开。必须放在数据载入之后 ——
      // 原先挂在脚本末尾同步执行，此时 FUNDS 还是空数组，点了没反应。
      var uc = new URLSearchParams(location.search).get('code');
      if (uc) {
        $('q').value = uc;
        var h = FUNDS.filter(function (f) { return f.ts_code === uc || f.code === uc; })[0];
        if (h) detail(h.ts_code);
        else $('count').innerHTML += ' ｜ 未找到代码 ' + esc(uc);
      }
    })
    .catch(function (e) {
      $('count').innerHTML = '<span style="color:var(--red)">数据加载失败（' + esc(e.message) +
        '）。评分数据约 1.3MB，首次加载需要几秒，请刷新重试。</span>';
    });

  function renderMeta() {
    var m = DATA.meta;
    $('hd-total').textContent = m.total.toLocaleString();
    $('hd-live').textContent = m.live.toLocaleString();
    $('hd-score').textContent = m.scorable;
    $('hd-nodim').textContent = (m.live - m.scorable).toLocaleString();
    $('hd-date').textContent = m.built;
    var rows = DIMS.map(function (d) {
      var note = m.dimension_notes[d.nm] || '';
      return '<tr><td><b>' + d.nm + '</b></td><td>' + d.w + '</td>' +
        '<td style="font-size:12.5px;">' + esc(note) + '</td>' +
        '<td style="font-size:12.5px;">' + (d.dir === 1 ? n2(d.lo, 2) + ' → ' + n2(d.hi, 2) : n2(d.hi, 2) + ' → ' + n2(d.lo, 2)) +
        '（满分在' + (d.dir === 1 ? '高' : '低') + '端）</td></tr>';
    }).join('');
    $('dim-body').innerHTML = rows;
  }

  function buildDims() {
    $('filters').innerHTML = DIMS.map(function (d, i) {
      var op = d.dir === 1 ? '≥' : '≤';
      return '<div><label style="font-size:12px; color:var(--navy-600); display:block; margin-bottom:4px;">' +
        d.nm + ' ' + op + ' <b class="fv" data-i="' + i + '" style="color:var(--gold);">不限</b>' +
        (d.unit === '百万元' ? '百万' : d.unit) + '</label>' +
        '<input class="fr" data-i="' + i + '" type="range" min="' + d.lo + '" max="' + d.hi +
        '" step="0.1" value="' + (d.dir === 1 ? d.lo : d.hi) + '" data-off="1" style="width:100%;" /></div>';
    }).join('');
    // 注意 value 必须放在最宽松端：滑块初值若落在中点，等于页面一进来
    // 就套了一层隐形筛选（实测把 2,288 只砍到 208 只），标签却写「不限」。
  }

  function buildSelects() {
    var uniq = function (key) {
      var m = {};
      FUNDS.forEach(function (f) { if (f[key]) m[f[key]] = 1; });
      return Object.keys(m).sort();
    };
    [['f-theme', 'theme_tag', '全部主题'], ['f-asset', 'asset_class', '全部资产类别'],
     ['f-bench', 'bench_type', '全部基准类型']].forEach(function (t) {
      var el = $(t[0]);
      uniq(t[1]).forEach(function (v) {
        var o = document.createElement('option');
        o.value = v; o.textContent = v; el.appendChild(o);
      });
      el.addEventListener('change', function () { shown = 60; render(); });
    });
  }

  function rawOf(f) {
    return { purity: f.raw.purity, te_ann: f.raw.te_ann, fee: f.raw.fee,
             amt: f.raw.amt_60d_avg, issue: f.raw.issue_amount };
  }

  function pass(f) {
    if (!$('f-delist').checked && f.is_delisted) return false;
    if ($('f-full').checked && f.n_dims < 5) return false;
    var t = $('f-theme').value, a = $('f-asset').value, b = $('f-bench').value;
    if (t && f.theme_tag !== t) return false;
    if (a && f.asset_class !== a) return false;
    if (b && f.bench_type !== b) return false;
    var r = rawOf(f);
    for (var i = 0; i < DIMS.length; i++) {
      var d = DIMS[i], v = r[d.k];
      if (v === null || v === undefined) continue;      // 缺值不参与筛选，也不算不通过
      var box = $('filters').querySelector('.fr[data-i="' + i + '"]');
      if (box.dataset.off === '1') continue;            // 用户没拖过 → 不参与筛选
      var th = +box.value;
      if (d.dir === 1 && v < th) return false;
      if (d.dir === -1 && v > th) return false;
    }
    return true;
  }

  // 滑块阈值 → 只有用户拖过才启用（data-off=1 时不参与筛选）
  function buildFilters() {
    $('filters').querySelectorAll('.fr').forEach(function (el) {
      var out = $('filters').querySelector('.fv[data-i="' + el.dataset.i + '"]');
      el.addEventListener('input', function () {
        el.dataset.off = '0';
        out.textContent = n2(+el.value, 2);
        shown = 60; render();
      });
    });
  }

  function render() {
    ROWS = FUNDS.filter(pass);
    ROWS.sort(function (x, y) {
      var g = function (f) {
        if (sortK === 'total') return f.total_score;
        if (sortK === 'amt') return f.raw.amt_60d_avg;
        if (sortK === 'issue') return f.raw.issue_amount;
        return rawOf(f)[sortK];
      };
      var a = g(x), b = g(y);
      if (a === null || a === undefined) return 1;     // 缺失恒排末尾
      if (b === null || b === undefined) return -1;
      if (a === b) return 0;
      return (a - b) * sortD;
    });

    var scored = ROWS.filter(function (f) { return f.total_score !== null; }).length;
    $('count').innerHTML = '筛出 <b>' + ROWS.length.toLocaleString() + '</b> 只 ｜ 其中 <b>' + scored +
      '</b> 只五维齐全有总分，' + (ROWS.length - scored).toLocaleString() + ' 只只有部分维度（无总分）';

    var slice = ROWS.slice(0, shown);
    $('tbody').innerHTML = slice.map(function (f) {
      var r = rawOf(f), s = f.scores;
      var cls = f.total_score === null ? 'color:var(--navy-600);'
        : f.total_score >= 75 ? 'color:var(--green); font-weight:700;'
        : f.total_score >= 60 ? 'color:var(--gold); font-weight:700;' : '';
      var grade = f.grade ? ' ' + f.grade : '';
      return '<tr style="cursor:pointer;" data-c="' + esc(f.ts_code) + '">' +
        '<td style="font-family:monospace;">' + esc(f.ts_code) + '</td>' +
        '<td>' + esc(f.name || MISS) + (f.is_delisted ? ' <span style="font-size:10px;color:var(--navy-600);">清盘</span>' : '') + '</td>' +
        '<td style="font-size:12px;">' + esc(f.theme_tag || MISS) + '</td>' +
        '<td class="sv">' + (r.purity === null ? MISS : n2(r.purity, 2) + '%') + '</td>' +
        '<td class="sv">' + (r.te_ann === null ? MISS : n2(r.te_ann, 2) + '%') + '</td>' +
        '<td class="sv">' + (r.fee === null ? MISS : n2(r.fee, 2) + '%') + '</td>' +
        '<td class="sv">' + (r.amt === null ? MISS : n2(r.amt / 100, 0) + ' 百万') + '</td>' +
        '<td class="sv">' + (r.issue === null ? MISS : n2(r.issue, 1) + ' 亿') + '</td>' +
        '<td class="' + cls + '">' + (f.total_score === null ? '<span title="缺维度，不给总分">' + MISS + '</span>' : n2(f.total_score, 1) + grade) + '</td>' +
        '</tr>';
    }).join('') || '<tr><td colspan="9" style="color:var(--navy-600);">无匹配结果</td></tr>';

    $('tbody').querySelectorAll('tr[data-c]').forEach(function (tr) {
      tr.addEventListener('click', function () { detail(tr.dataset.c); });
    });

    $('more').innerHTML = ROWS.length > shown
      ? '<button id="mbtn" class="btn btn-outline" style="font-size:13px;">再显示 60 只（剩余 ' +
        (ROWS.length - shown).toLocaleString() + '）</button>' : '';
    var mb = $('mbtn');
    if (mb) mb.addEventListener('click', function () { shown += 60; render(); });
  }

  function detail(code) {
    var f = FUNDS.filter(function (x) { return x.ts_code === code; })[0];
    if (!f) return;
    var r = rawOf(f), m = DATA.meta;
    $('d-title').textContent = (f.name || code) + '（' + code + '）';
    $('d-sub').innerHTML = (f.theme_tag || '未分类') + ' ｜ ' + (f.asset_class || '—') +
      ' ｜ 基准类型 ' + (f.bench_type || '—') +
      (f.index_codes ? ' ｜ 跟踪指数 ' + esc(f.index_codes) : ' ｜ <span style="color:var(--orange);">未匹配到跟踪指数 → 纯度与误差两维为空</span>') +
      (f.list_date ? ' ｜ 上市 ' + esc(String(f.list_date)) : '');

    var bars = DIMS.map(function (d) {
      var sc = f.scores[d.k], v = r[d.k];
      var has = sc !== null && sc !== undefined;
      var w = has ? sc : 0;
      var col = has ? (sc >= 70 ? 'var(--green)' : sc >= 40 ? 'var(--gold)' : 'var(--red)') : 'var(--navy-600)';
      var vtxt = v === null ? MISS
        : d.k === 'amt' ? n2(v / 100, 0) + ' 百万元'
        : d.k === 'issue' ? n2(v, 1) + ' 亿'
        : n2(v, 2) + '%';
      return '<div style="margin-bottom:11px;">' +
        '<div style="display:flex; justify-content:space-between; font-size:12.5px; margin-bottom:3px;">' +
        '<span style="color:var(--navy-700);">' + d.nm + ' <span style="color:var(--navy-600);font-size:11px;">（' + d.w + '分）</span></span>' +
        '<span><b style="color:var(--navy-900);">' + (has ? n2(sc, 0) : MISS) + '</b>' +
        '<span style="color:var(--navy-600); font-size:11.5px;"> ｜ ' + vtxt + '</span></span></div>' +
        '<div style="height:7px; background:rgba(139,94,60,0.10); border-radius:4px; overflow:hidden;">' +
        '<div style="height:100%; width:' + w + '%; background:' + col + ';"></div></div>' +
        (has ? '' : '<div style="font-size:11px; color:var(--navy-600); margin-top:2px;">数据缺失 —— 不打分，不按 0 分计入总分</div>') +
        '</div>';
    }).join('');

    var head = f.total_score === null
      ? '<div style="padding:12px 14px; border-radius:8px; background:rgba(217,164,65,0.10); color:var(--navy-700); font-size:13.5px; margin-bottom:14px;">' +
        '只有 <b>' + f.n_dims + '/5</b> 个维度有数据，<b>不给总分</b>。缺维不等于差，只等于我们还没算出来。</div>'
      : '<div style="display:flex; align-items:center; gap:16px; margin-bottom:14px;">' +
        '<div style="font-size:38px; font-weight:700; color:var(--gold);">' + n2(f.total_score, 1) + '</div>' +
        '<div><div style="font-size:17px; font-weight:700; color:var(--navy-900);">' + esc(f.grade) + '</div>' +
        '<div style="font-size:12px; color:var(--navy-600);">五维齐全 · 可与其他同类比较</div></div></div>';

    var cmp = (f.scores.purity !== null && f.scores.te_ann !== null)
      ? '<div style="font-size:12px; color:var(--navy-600); margin-top:10px; line-height:1.7; margin-top:14px; padding-top:10px; border-top:1px dashed rgba(139,94,60,0.2);">' +
        '跟踪纯度 ' + n2(r.purity, 2) + '% 与跟踪误差 ' + n2(r.te_ann, 2) + '% 高度相关（r≈0.64）——' +
        '它们是同一件事的两种测法：前者看<b>方向是否一致</b>，后者看<b>偏离幅度多大</b>，所以要一起看。</div>'
      : '';

    $('d-body').innerHTML = head + bars + cmp;
    $('detail').style.display = '';
    $('detail').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  // ---- 联想 ----
  var sugItems = [], sugIdx = -1;
  function hideSug() { sugIdx = -1; var d = $('sug'); d.style.display = 'none'; d.innerHTML = ''; }
  function buildSug(q) {
    q = q.trim().toLowerCase(); if (!q) return [];
    var out = [];
    for (var i = 0; i < FUNDS.length && out.length < 20; i++) {
      var f = FUNDS[i];
      if (f.is_delisted && !$('f-delist').checked) continue;
      if (f.ts_code.indexOf(q) === 0 || (f.code && String(f.code).indexOf(q) === 0) ||
          (f.name && f.name.toLowerCase().indexOf(q) >= 0) ||
          (f.theme_tag && f.theme_tag.toLowerCase().indexOf(q) >= 0)) {
        out.push(f);
      }
    }
    return out;
  }
  function renderSug() {
    var d = $('sug');
    if (!sugItems.length) { hideSug(); return; }
    d.innerHTML = sugItems.map(function (f, i) {
      return '<div class="sg' + (i === sugIdx ? ' on' : '') + '" data-i="' + i + '" ' +
        'style="padding:9px 14px;font-size:13.5px;cursor:pointer;display:flex;gap:10px;align-items:baseline;border-bottom:1px solid rgba(139,94,60,0.08);">' +
        '<b style="color:var(--navy-900);font-family:monospace;min-width:70px;">' + esc(f.ts_code) + '</b>' +
        '<span style="flex:1;color:var(--navy-700);">' + esc(f.name || '') + '</span>' +
        '<span style="font-size:11.5px;color:var(--gold);">' + esc(f.theme_tag || '') + '</span></div>';
    }).join('');
    d.style.display = '';
    d.querySelectorAll('.sg').forEach(function (el) {
      el.addEventListener('mousedown', function (e) { e.preventDefault(); pick(sugItems[+el.dataset.i]); });
    });
  }
  function pick(f) { if (!f) return; $('q').value = f.ts_code; hideSug(); detail(f.ts_code); }
  function sugKey(e) {
    if (!sugItems.length || $('sug').style.display === 'none') return;
    if (e.key === 'ArrowDown') { e.preventDefault(); sugIdx = (sugIdx + 1) % sugItems.length; renderSug(); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); sugIdx = (sugIdx <= 0 ? sugItems.length - 1 : sugIdx - 1); renderSug(); }
    else if (e.key === 'Escape') hideSug();
  }
  $('q').addEventListener('input', function () {
    sugItems = buildSug($('q').value); sugIdx = sugItems.length ? 0 : -1; renderSug();
  });
  $('q').addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      if (sugItems.length && sugIdx >= 0 && $('sug').style.display !== 'none') { e.preventDefault(); pick(sugItems[sugIdx]); return; }
      hideSug();
      var q = $('q').value.trim();
      if (q) { var hit = FUNDS.filter(function (f) { return f.ts_code === q || f.code === q; })[0]; if (hit) detail(hit.ts_code); }
    }
    sugKey(e);
  });
  $('q').addEventListener('blur', function () { setTimeout(hideSug, 150); });

  $('f-full').addEventListener('change', function () { shown = 60; render(); });
  $('f-delist').addEventListener('change', function () { shown = 60; render(); });
  $('reset').addEventListener('click', function () {
    $('q').value = ''; $('f-full').checked = false; $('f-delist').checked = false;
    $('f-theme').value = ''; $('f-asset').value = ''; $('f-bench').value = '';
    $('filters').querySelectorAll('.fr').forEach(function (el) {
      var d = DIMS[+el.dataset.i];
      el.value = d.dir === 1 ? d.lo : d.hi;
      el.dataset.off = '1';
    });
    $('filters').querySelectorAll('.fv').forEach(function (el) { el.textContent = '不限'; });
    shown = 60; render();
  });
  document.querySelectorAll('th[data-sort]').forEach(function (th) {
    th.style.cursor = 'pointer';
    th.addEventListener('click', function () {
      var k = th.dataset.sort;
      if (sortK === k) sortD = -sortD; else { sortK = k; sortD = -1; }
      shown = 60; render();
    });
  });

  // ?code= 联动已移入数据载入回调（见 fetch().then）
</script>

<style>
  .wrap-cells th, .wrap-cells td { white-space: normal; text-align: left; line-height: 1.6; }
  th[data-sort]:hover { color: var(--gold); }
  th.sv, td.sv { text-align: right; font-family: monospace; font-size: 12px; }
  .sg.on { background: rgba(217,164,65,0.10); }
  tbody tr[data-c]:hover { background: rgba(217,164,65,0.06); }
</style>
</Layout>

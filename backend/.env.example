# 松果个股体检 API — 环境变量样例
# 真实值严禁提交进仓库。
#
# 生产（华纳云）：由 systemd 注入
#   /etc/systemd/system/stockcheck-api.service 里 EnvironmentFile=/root/stockcheck-api/api.env
#   该文件 chmod 600，内容形如 DEEPSEEK_API_KEY=sk-...
#   轮换密钥：改 api.env → systemctl restart stockcheck-api
#
# 本地开发：把本文件复制为 .env 并填真值
#   cp .env.example .env
#   （.env 已在 .gitignore 中，不会被提交；load_ds_key() 环境变量优先、.env 兜底）

DEEPSEEK_API_KEY=sk-your-key-here

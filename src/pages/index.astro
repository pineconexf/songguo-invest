---
import Layout from '../layouts/Layout.astro';
import Chart from '../components/Chart.astro';
import strategy from '../data/strategy.json';

const v31 = strategy.meta.v31;
const hs300 = strategy.meta.hs300;
const GOLD = '#d9a441';
const GRAY = '#a39684';

const navMonths = strategy.nav.months.map((ym: string) => `${ym.slice(0, 4)}-${ym.slice(4)}`);

const navOption = {
  tooltip: {
    trigger: 'axis',
    valueFormatter: (v: number | null) => (v == null ? '-' : `${(v as number).toFixed(2)} 倍`),
  },
  legend: { data: ['V31 基金版', '沪深300'], top: 0, textStyle: { color: '#555' } },
  grid: { left: 56, right: 20, top: 42, bottom: 52 },
  xAxis: {
    type: 'category',
    data: navMonths,
    boundaryGap: false,
    axisLabel: { interval: 23, color: '#8a7a66' },
  },
  yAxis: {
    type: 'value',
    name: '净值（倍数）',
    nameTextStyle: { color: '#8a7a66' },
    scale: true,
    axisLabel: { color: '#8a7a66' },
    splitLine: { lineStyle: { color: '#f0e8d9' } },
  },
  dataZoom: [
    { type: 'inside', start: 0, end: 100 },
    { type: 'slider', height: 16, bottom: 8, start: 0, end: 100 },
  ],
  series: [
    {
      name: 'V31 基金版',
      type: 'line',
      data: strategy.nav.v31,
      smooth: true,
      symbol: 'none',
      lineStyle: { width: 2.5, color: GOLD },
      areaStyle: { opacity: 0.08, color: GOLD },
    },
    {
      name: '沪深300',
      type: 'line',
      data: strategy.nav.hs300,
      smooth: true,
      symbol: 'none',
      lineStyle: { width: 1.5, color: GRAY, type: 'dashed' },
    },
  ],
};
---
<!--
  V4 首页 · 浏览路径设计（2026-08-25）
  理念来源：《别让AI直接做网站：先让它设计浏览路径》（AI之炼金术士）
  滚动剧本：每屏只解决一个信任问题
    第1幕 钩子     → 你是谁？凭什么让我停下？        （痛点 + 中心承诺 + 真实数字锚点）
    第2幕 证据     → 数字是真的吗？                  （数据墙 + 172个月脚印，真实资产证据位）
    第3幕 方法     → 怎么做到的？                    （四层体系，可解释非黑箱）
    第4幕 反对意见 → 是不是拟合出来的？              （审计记录逐步点亮，公开自己的黑历史）
    第5幕 行动     → 然后呢？我能带走什么？          （免费工具 + 公众号引流 + 合规）
  动效纪律：去掉动画有信息损失才保留；叙事动画宁慢勿快。
  真实资产在证据位，全站数据为真实回测，不引入任何生成图。
-->
<Layout
  title="首页"
  description="松果投资体系 — 14年真实回测验证的A股投资体系。年化+24.30%，同期沪深300仅+3.97%。全部数据含成本口径、经审计、可复现。"
>

  <!-- ============ 第1幕 · 钩子：你是谁，凭什么让我停下 ============ -->
  <section class="hero" id="hook">
    <div class="hero-inner">
      <span class="eyebrow reveal">14 年 · 172 个月 · A股真实回测</span>
      <h1 class="reveal">
        散户总亏钱，<br /><span class="gold">不是不努力，是没有体系</span>
      </h1>
      <p class="hero-lead reveal">
        我们把专业机构的投资逻辑——宏观择时、行业筛选、个股定价、组合风控——
        做成了普通人能照做的四层体系，然后用 <b>14 年真实回测</b>验证给你看。
      </p>
      <div class="trust-sigil reveal">
        <span class="sigil-num" data-count="22.6" data-decimals="1" data-suffix="倍">22.6倍</span>
        <span class="sigil-label">14 年累计收益，含成本口径，全部可复现</span>
      </div>
      <div class="hero-actions reveal">
        <a href="#evidence" class="btn btn-gold">看证据 ↓</a>
        <a href="/philosophy/" class="btn btn-ghost">先了解理念</a>
      </div>
    </div>
  </section>

  <!-- ============ 第2幕 · 证据：数字是真的吗 ============ -->
  <section class="card" id="evidence">
    <div class="section-head">
      <div class="section-kicker">Evidence · 真实证据</div>
      <h2 class="section-title">14 年，172 个月，每一笔都算过成本</h2>
      <p class="section-sub">
        这些不是宣传数字，是逐月回测、含佣金与印花税摩擦后的结果。
        每个数字都可以在我们的数据档案里逐月查到。
      </p>
    </div>
    <div class="metric-grid">
      <div class="metric-card reveal">
        <div class="label">14 年年化收益率</div>
        <div class="value gold" data-count="24.30" data-prefix="+" data-suffix="%" data-decimals="2">+24.30%</div>
        <div class="sub">同期沪深300：+3.97%</div>
      </div>
      <div class="metric-card reveal">
        <div class="label">最大回撤</div>
        <div class="value red" data-count="-22.66" data-suffix="%" data-decimals="2">-22.66%</div>
        <div class="sub">沪深300 同期 -40.56%</div>
      </div>
      <div class="metric-card reveal">
        <div class="label">风险调整收益（Calmar）</div>
        <div class="value green" data-count="1.07" data-decimals="2">1.07</div>
        <div class="sub">年化 ÷ 最大回撤</div>
      </div>
      <div class="metric-card reveal">
        <div class="label">14 年累计收益</div>
        <div class="value gold" data-count="2159.6" data-prefix="+" data-suffix="%" data-decimals="1">+2159.6%</div>
        <div class="sub">约 22.6 倍（含成本口径）</div>
      </div>
    </div>
  </section>

  <section class="card reveal">
    <div class="section-head">
      <div class="section-kicker">Track Record · 脚印</div>
      <h2 class="section-title">这不是一个数字，是 172 个月的脚印</h2>
      <p class="section-sub">
        起点 1.00，金色为策略净值，灰色虚线为同期沪深300。
        每一格都是真实的一个月——含股灾、含熔断、含 2018 年阴跌。
        数据为历史回测，不构成投资建议。
      </p>
    </div>
    <Chart option={navOption} height="440px" />
  </section>

  <!-- ============ 第3幕 · 方法：怎么做到的 ============ -->
  <section class="card reveal">
    <div class="section-head">
      <div class="section-kicker">Method · 可解释的方法</div>
      <h2 class="section-title">不是黑箱。每一步都讲得清。</h2>
      <p class="section-sub">
        松果投资体系不是单一策略，而是从宏观到个股的完整决策链——每一层独立可验证，层间协同形成闭环。
      </p>
    </div>
    <div class="layer-stack">
      <a href="/macro/" class="layer">
        <span class="layer-index">01</span>
        <span class="layer-name">宏观层</span>
        <span class="layer-desc">宏观时钟六轴评分，判断大势方向，决定仓位进攻或防守</span>
        <span class="layer-tag">V1 常规版</span>
      </a>
      <a href="/methodology/" class="layer">
        <span class="layer-index">02</span>
        <span class="layer-name">行业层</span>
        <span class="layer-desc">行业因子筛选，识别景气赛道，避开衰退行业</span>
        <span class="layer-tag">行业轮动</span>
      </a>
      <a href="/backtest/" class="layer">
        <span class="layer-index">03</span>
        <span class="layer-name">个股层</span>
        <span class="layer-desc">11 步筛选好公司 + 双因子找便宜 + 空仓保险躲股灾</span>
        <span class="layer-tag">V31 基金版</span>
      </a>
      <a href="/portfolio/" class="layer">
        <span class="layer-index">04</span>
        <span class="layer-name">组合层</span>
        <span class="layer-desc">双版本组合：宏观×个股融合，进攻防守节奏错开</span>
        <span class="layer-tag">单策略</span>
      </a>
    </div>
  </section>

  <!-- ============ 第4幕 · 反对意见：是不是拟合出来的 ============ -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Audit · 我们公开自己的黑历史</div>
      <h2 class="doubt-title">你可能会怀疑：回测是不是拟合出来的？</h2>
      <p class="section-sub">
        合理。所以我们把审计过程全部公开——<b>包括我们自己抓出来的错</b>。
        每条逐步点亮，读完你就知道这套数据经得起查。
      </p>
    </div>
    <div class="steps">
      <div class="step steps-step">
        <div class="num">1</div>
        <div class="body">
          <h3>含成本口径</h3>
          <p>佣金万 2.5 + 印花税 0.05% + 空仓月债券/黄金 ETF 切换成本，全部计入。成本每年约侵蚀 1.1-2.5 个百分点，真实摩擦不藏。</p>
        </div>
      </div>
      <div class="step steps-step">
        <div class="num">2</div>
        <div class="body">
          <h3>无未来函数</h3>
          <p>信号判定严格滞后一个月对齐。2026 年 8 月独立审计曾发现旧版本含前视偏差（年化虚高至 40%+），已全体系重算——本站数据是<b>自曝问题后修正</b>的口径。</p>
        </div>
      </div>
      <div class="step steps-step">
        <div class="num">3</div>
        <div class="body">
          <h3>数据修复</h3>
          <p>审计中发现 6 个报告期底层数据量纲损坏（估值倍数被缩放 1 万倍），已修复并重跑，后续版本均为修复后数据。</p>
        </div>
      </div>
      <div class="step steps-step">
        <div class="num">4</div>
        <div class="body">
          <h3>保守方向原则</h3>
          <p>所有口径分歧（月份断档、空仓月归属等）一律按保守方向处理，<b>宁可低估收益，不虚增</b>。</p>
        </div>
      </div>
    </div>
    <div style="margin-top: var(--sp-4);">
      <a href="/backtest/" class="btn btn-ghost">查看完整审计与逐月数据 →</a>
    </div>
  </section>

  <!-- ============ 第5幕 · 行动：你能带走什么 ============ -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Action · 你能带走什么</div>
      <h2 class="section-title">体系是公开的。工具是免费的。</h2>
      <p class="section-sub">
        我们不收订阅费、不卖课程。你带走三样东西：判断大势的工具、验证策略的数据、以及一套不用拍脑袋的方法。
      </p>
    </div>
    <div class="link-cards">
      <a href="/macro/" class="link-card action-card">
        <h3><span class="gold">宏观时钟</span> · 现在该攻还是守</h3>
        <p>六轴宏观评分，告诉你当前市场的进攻/防守信号——先看方向，再谈个股。</p>
      </a>
      <a href="/backtest/" class="link-card action-card">
        <h3><span class="gold">策略数据</span> · 172 个月逐月可查</h3>
        <p>净值、年度收益、回撤、审计记录，全部公开可复现。不玩幸存者偏差。</p>
      </a>
      <a href="/archive/" class="link-card action-card">
        <h3><span class="gold">历史档案</span> · 809 周信号 + 124 月选股</h3>
        <p>每一次宏观判断、每一月选股记录都在这里，投前投后对比看得见。</p>
      </a>
    </div>
    <div class="callout" style="margin-top: var(--sp-5);">
      <b>每周一篇深度文章</b>：关注公众号「松果商业笔记」，把体系拆成每周一篇讲给你听。
      观点用本站数据佐证，不荐股、不喊单。
    </div>
  </section>

  <div class="callout">
    <b>免责声明</b>：本站全部数据为历史回测结果（含成本口径），不代表未来收益，
    不构成任何投资建议，亦不构成对任何证券或产品的推荐。投资有风险，入市需谨慎。
  </div>

  <script>
    import '../scripts/charts.ts';
    import '../scripts/scroll-narrative.ts';
  </script>
</Layout>

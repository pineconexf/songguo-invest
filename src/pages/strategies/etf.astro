---
import Layout from '../../layouts/Layout.astro';
import Chart from '../../components/Chart.astro';
import lifeEtf from '../../data/life_etf.json';

const navOption = {
  grid: { left: 50, right: 16, top: 20, bottom: 40 },
  tooltip: { trigger: 'axis' },
  xAxis: {
    type: 'category',
    data: lifeEtf.labels,
    axisLabel: { fontSize: 10, interval: 17, color: '#8b5e3c' },
    axisLine: { lineStyle: { color: 'rgba(139,94,60,0.25)' } },
  },
  yAxis: {
    type: 'value',
    name: '净值',
    nameTextStyle: { fontSize: 10, color: '#8b5e3c' },
    scale: true,
    splitLine: { lineStyle: { color: 'rgba(139,94,60,0.10)' } },
    axisLabel: { fontSize: 10, color: '#8b5e3c' },
  },
  series: [
    {
      name: '全ETF组合净值',
      type: 'line',
      data: lifeEtf.nav,
      showSymbol: false,
      lineStyle: { width: 2, color: '#d9a441' },
      areaStyle: { color: 'rgba(217,164,65,0.12)' },
    },
  ],
};
---
<Layout
  title="纯ETF组合"
  description="松果纯ETF组合策略 — 债券+黄金+红利+QDII 四拼图低相关组合，2014 起 12.7 年回测，年化 10.10%，最大回撤 -6.15%。"
>
  <!-- Hero -->
  <section class="hero" style="padding: 56px 48px;">
    <div class="hero-inner">
      <span class="eyebrow">Strategy 03 · 生活投资</span>
      <h1>
        纯 ETF 组合<br /><span class="gold">四拼图 · 低相关 · 扛住三次股灾</span>
      </h1>
      <p class="hero-lead">
        债券 25% + 黄金 30% + 红利 10% + QDII 35%——每块拼图负责一个角色，
        <b>低相关分散</b>，回撤优先。2014 年起 12.7 年真实回测，唯一覆盖
        2015 / 2018 / 2022 三次大熊市的版本。
      </p>
    </div>
  </section>

  <!-- 概念定义 -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Concept</div>
      <h2 class="section-title">什么是「组合拼图」</h2>
      <p class="section-sub">
        核心认知转变：从「这只产品过去涨了多少」→「它在组合里负责什么」。每块拼图只承担一个角色，
        拼图之间相关性越低，组合回撤越小——黄金与所有资产相关性≈0，是最好的分散器。
      </p>
    </div>
    <div class="metric-grid" style="grid-template-columns: repeat(4, 1fr); margin-bottom: 0;">
      <div class="metric-card">
        <div class="label">角色 01 · 压舱石</div>
        <div class="value" style="font-size: 20px;">债券</div>
        <div class="sub">国债ETF 511010 · 年化 3.3% · MDD -4.0%</div>
      </div>
      <div class="metric-card">
        <div class="label">角色 02 · 分散王</div>
        <div class="value" style="font-size: 20px;">黄金</div>
        <div class="sub">黄金ETF 159934 · 年化 11.2% · 与A股≈0相关</div>
      </div>
      <div class="metric-card">
        <div class="label">角色 03 · 股息流</div>
        <div class="value" style="font-size: 20px;">红利</div>
        <div class="sub">上证红利ETF 510880 · 年化 7.9%</div>
      </div>
      <div class="metric-card">
        <div class="label">角色 04 · 另一条路</div>
        <div class="value" style="font-size: 20px;">QDII</div>
        <div class="sub">标普500ETF 513500 · 年化 13.4% · 相关 0.01-0.20</div>
      </div>
    </div>
  </section>

  <!-- 回测数据 -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Backtest · 2014-2026</div>
      <h2 class="section-title">回测数据（含成本口径）</h2>
      <p class="section-sub">主口径 2014-01 起 12.7 年，全程真实净值回测。</p>
    </div>
    <div class="metric-grid" style="grid-template-columns: repeat(4, 1fr);">
      <div class="metric-card">
        <div class="label">年化收益</div>
        <div class="value">+10.10%</div>
      </div>
      <div class="metric-card">
        <div class="label">最大回撤</div>
        <div class="value" style="color: #a03a28;">-6.15%</div>
      </div>
      <div class="metric-card">
        <div class="label">夏普比率</div>
        <div class="value">1.21</div>
      </div>
      <div class="metric-card">
        <div class="label">卡玛比率</div>
        <div class="value">1.64</div>
      </div>
    </div>
    <Chart option={navOption} height="300px" />
    <div class="callout" style="margin-top: 8px;">
      <b>压力测试</b>：2015 股灾 +3.4%、2018 熊市 +1.2%、2022 熊市 -0.5%——三次大熊市全部扛住，最差连续 3 月仅 -5.1%（2020-01~03）。
    </div>
  </section>

  <!-- 操作纪律 -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Operation</div>
      <h2 class="section-title">操作方法</h2>
    </div>
    <table class="data-table">
      <thead>
        <tr><th>项目</th><th>规则</th></tr>
      </thead>
      <tbody>
        <tr><td>入场工具</td><td>场内 ETF（511010 / 159934 / 510880 / 513500），T+0 进出，成本敏感者首选</td></tr>
        <tr><td>调仓频率</td><td>季度审视 + 半年再平衡（约 30% 仓位换手）</td></tr>
        <tr><td>再平衡阈值</td><td>偏离目标权重 ±10% 才调，不频繁折腾</td></tr>
        <tr><td>适用人群</td><td>能看盘、要 T+0 进出、在意交易成本的投资者</td></tr>
      </tbody>
    </table>
    <div class="callout warn" style="margin-top: 20px;">
      <b>数据边界（诚实标注）</b>：2019-2026 是公募/ETF 黄金窗口，年化 10%+ 含窗口红利，未来预期应打折（落 7-9% 更现实）。
      红利拼图在 2015 股灾回撤 -33.9%（上证红利质量一般）；若换红利低波质量，窗口缩至 7.7 年。QDII 有历史限购记录。
    </div>
  </section>

  <script>
    import '../../scripts/charts.ts';
  </script>
</Layout>

---
import Layout from '../layouts/Layout.astro';

// 核心四工具：每个策略栏目只有一个入口（2026-10-03 精简）
const coreTools = [
  {
    strategy: 'defense',
    name: '基金打分卡',
    desc: '场外主动基金专用：收益/回撤/费率/规模/经理年限五维规则打分（经理维度对 ETF 不适用）。',
    status: 'live', statusLabel: '已上线', cta: '免费使用',
    href: '/songguo-invest/tools/fund-scorecard/',
  },
  {
    strategy: 'offense',
    name: '个股打分卡',
    desc: '六维打分（盈利质量22/成长18/估值20/财务健康15/资金动能13/概念景气12），全市场同日横截面分位，缺失维度如实 N/A 不填 0，每个分数带置信度。',
    status: 'live', statusLabel: '已上线', cta: '免费使用',
    href: '/songguo-invest/tools/stockscore/',
  },
  {
    strategy: 'timing',
    name: '宏观信号查询',
    desc: '查询当前 Shibor 流动性信号：宽松（进攻）还是收紧（防守），809 周历史一键回溯。',
    status: 'live', statusLabel: '已上线', cta: '免费使用',
    href: '/songguo-invest/tools/macro-signal/',
  },
  {
    strategy: 'all',
    name: '每日资讯解读',
    desc: '每日市场全景 + 松果信号速查 + 政策产业关注，帮你在信息洪流中抓住关键信号。每交易日更新。',
    status: 'live', statusLabel: '已上线', cta: '免费使用',
    href: '/songguo-invest/tools/daily-insight/',
  },
];

// 进阶工具：不占主网格，收进底部折叠区（页面与 URL 保留）
const extraTools = [
  { name: '个股体检', desc: 'V35 五维评分 + AI 综合报告', href: '/songguo-invest/tools/stockcheck/' },
  { name: '估值计算器', desc: 'PE/PB/ROE/股息率三维画像', href: '/songguo-invest/tools/valuator/' },
  { name: 'ETF 组合配置', desc: '四拼图权重 → 份额计算', href: '/songguo-invest/tools/etf-allocator/' },
  { name: 'ETF 五维查询', desc: '全市场场内 ETF 五维打分', href: '/songguo-invest/tools/etf-score5d/' },
  { name: '基金排名', desc: '基金池横向排名对照', href: '/songguo-invest/tools/fund-ranking/' },
  { name: '行业研究报告', desc: '六维行业研究框架提纲', href: '/songguo-invest/tools/industry-report/' },
  { name: '行业对比工具', desc: '跨行业估值/增速/资金对比', href: '/songguo-invest/tools/industry-compare/' },
  { name: '复利计算器', desc: '年化 × 年限复利账', href: '/songguo-invest/tools/compound/' },
  { name: '回测验证工具', desc: '双策略 Calmar / 夏普对比', href: '/songguo-invest/tools/backtest-compare/' },
];

const groups = [
  { key: 'defense', label: '防守组合', desc: 'ETF 壳 / 基金壳 二选一配套（债+金+红利/QDII）' },
  { key: 'offense', label: '进攻选股', desc: '量化价值选股（V35 体系）配套' },
  { key: 'timing', label: '宏观择时', desc: 'Shibor 信号 × 中证500 择时配套' },
  { key: 'all', label: '全策略通用', desc: '资讯与研究支持' },
];
---
<Layout
  title="工具服务"
  description="松果投资工具 — 基金打分卡、个股打分卡、宏观信号查询、每日资讯解读，每个策略维度一个工具，把投资方法论变成可用的工具。"
>
  <!-- Hero -->
  <section class="hero" style="padding: 56px 48px;">
    <div class="hero-inner">
      <span class="eyebrow">Tools · 工具</span>
      <h1>
        把投资方法论，<br />变成<span class="gold">可用的工具</span>
      </h1>
      <p class="hero-lead">
              松果体系不仅是理念，更是工具：基金打分、个股打分、宏观信号、每日解读——
              让专业级的分析能力，普通人也能上手。
            </p>
    </div>
  </section>

  <!-- 工具网格 -->
  <section class="card">
    <div class="section-head">
          <div class="section-kicker">Tool Suite</div>
          <h2 class="section-title">四个工具，一套决策链路</h2>
          <p class="section-sub">
            防守怎么配、进攻买什么、宏观什么信号、今天发生了什么——每个策略维度，一个工具就够。全部免费，无需注册。
          </p>
        </div>
        {
          groups.map((g) => {
            const t = coreTools.find((x) => x.strategy === g.key);
            if (!t) return null;
            return (
              <div style="margin-bottom: 28px;">
                <h3 style="font-size: 17px; font-weight: 700; color: var(--navy-800); margin: 0 0 2px;">{g.label}</h3>
                <div style="font-size: 12.5px; color: var(--text-3); margin-bottom: 12px;">{g.desc}</div>
                <div class="tool-grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));">
                  <div class="tool-card">
                    <h3>{t.name}</h3>
                    <p>{t.desc}</p>
                    <div style="display:flex; align-items:center; justify-content:space-between; margin-top:8px;">
                      <span class:list={['tool-status', t.status]}>{t.statusLabel}</span>
                      <a href={t.href} style="font-size:13px; font-weight:600; color:var(--gold-600); text-decoration:none;">{t.cta} →</a>
                    </div>
                  </div>
                </div>
              </div>
            );
          })
        }

        <details style="margin-top: 8px; border-top: 1px solid var(--border); padding-top: 20px;">
          <summary style="cursor:pointer; font-size:14px; font-weight:600; color:var(--navy-700);">
            更多进阶工具（{extraTools.length}）
          </summary>
          <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap:10px 24px; margin-top:16px;">
            {
              extraTools.map((t) => (
                <a href={t.href} style="display:flex; justify-content:space-between; gap:12px; padding:9px 0; border-bottom:1px solid var(--border); text-decoration:none; color:inherit;">
                  <span style="font-size:14px; font-weight:600; color:var(--navy-800);">{t.name}</span>
                  <span style="font-size:12.5px; color:var(--text-3); text-align:right;">{t.desc} →</span>
                </a>
              ))
            }
          </div>
        </details>
      </section>

  <!-- 公众号引流 -->
  <section class="card" style="text-align:center; padding: 48px; background: linear-gradient(160deg, var(--navy-900), var(--navy-700)); color:#fff; border: 1px solid rgba(200,162,75,0.2);">
    <div class="section-kicker" style="color: var(--gold-300);">Follow Us</div>
    <h2 class="section-title" style="color:#fff; border:none; padding:0; margin:12px 0;">订阅「松果商业笔记」</h2>
    <p class="section-sub" style="color: rgba(255,255,255,0.8); margin: 0 auto 28px; max-width: 520px;">
      每日资讯解读、行业研究报告、策略月报——第一时间送达。
      公众号/知乎/雪球/百家号同步更新。
    </p>
    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <a href="/songguo-invest/about/" class="btn btn-gold">了解更多 →</a>
      <span class="btn btn-ghost" style="pointer-events: none;">公众号：松果商业笔记</span>
    </div>
  </section>

  <div class="callout">
    <b>合规声明</b>：所有工具输出均为数据分析与研究方法论展示，不构成投资建议。
    任何工具结果都不应作为买卖决策的唯一依据。投资有风险，入市需谨慎。
  </div>
</Layout>

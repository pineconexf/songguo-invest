---
import Layout from '../../layouts/Layout.astro';

// 回测验证工具 · 策略对比计算器
// 输入两个策略的年化/MDD/时长（可选年化波动率算夏普），对比 Calmar、夏普、同本金终值
// 参照锚：V35（32.96%/-22.66%，Calmar 1.45）、V36（42.62%/-33.65%，Calmar 1.27）、HS300（3.97%/-40.56%，Calmar 0.10）
// 口径：Calmar = 年化 / |MDD|；夏普（简化）= (年化 - 无风险 2%) / 年化波动率
const bench = [
  { name: 'V35 基础版（含成本）', ar: 32.96, mdd: 22.66, calmar: 1.45, note: '14 年回测 2012.04-2026.07，红旗审查' },
  { name: 'V36 杠杆版（1.5x）', ar: 42.62, mdd: 33.65, calmar: 1.27, note: '仅研究参考，杠杆放大亏损' },
  { name: '沪深300 基准', ar: 3.97, mdd: 40.56, calmar: 0.10, note: '同期买入持有' },
];
---
<Layout
  title="回测验证工具"
  description="松果回测验证工具 — 双策略对比计算器：年化/回撤/时长 → Calmar、夏普、终值对比。免费工具，不构成投资建议。"
>
  <section class="hero" style="padding: 56px 48px;">
    <div class="hero-inner">
      <span class="eyebrow">Free Tool · 策略验证</span>
      <h1>
        收益会说谎，<br /><span class="gold">风险调整后才是真相</span>
      </h1>
      <p class="hero-lead">
        年化 30% 但回撤 60% 的策略，和年化 15% 回撤 8% 的策略，谁更值得拿？
        输入两个策略的年化/回撤/时长，让 Calmar 与夏普说话。
      </p>
    </div>
  </section>

  <section class="card" style="max-width: 860px; margin: 0 auto;">
    <div class="section-head">
      <div class="section-kicker">Compare · 双策略对比</div>
      <h2 class="section-title">输入两个策略的参数</h2>
      <p class="section-sub">年化收益率与最大回撤为必填；回测时长与年化波动率可填（波动率用于算夏普）。</p>
    </div>

    <div class="table-wrap" style="margin-bottom: var(--sp-4);">
      <table class="data-table">
        <thead><tr><th></th><th>策略 A</th><th>策略 B</th></tr></thead>
        <tbody>
          <tr>
            <td>策略名称（可选）</td>
            <td><input id="bc-name-a" type="text" placeholder="如 我的策略" style="width:100%; padding:8px 10px; border:1px solid rgba(139,94,60,0.25); border-radius:8px;" /></td>
            <td><input id="bc-name-b" type="text" placeholder="如 松果V35" style="width:100%; padding:8px 10px; border:1px solid rgba(139,94,60,0.25); border-radius:8px;" /></td>
          </tr>
          <tr>
            <td>年化收益率（%）</td>
            <td><input id="bc-ar-a" type="number" step="0.1" min="-50" placeholder="如 24.3" style="width:100%; padding:8px 10px; border:1px solid rgba(139,94,60,0.25); border-radius:8px;" /></td>
            <td><input id="bc-ar-b" type="number" step="0.1" min="-50" placeholder="如 15" style="width:100%; padding:8px 10px; border:1px solid rgba(139,94,60,0.25); border-radius:8px;" /></td>
          </tr>
          <tr>
            <td>最大回撤（%，填正数）</td>
            <td><input id="bc-mdd-a" type="number" step="0.1" min="0" placeholder="如 22.66" style="width:100%; padding:8px 10px; border:1px solid rgba(139,94,60,0.25); border-radius:8px;" /></td>
            <td><input id="bc-mdd-b" type="number" step="0.1" min="0" placeholder="如 8" style="width:100%; padding:8px 10px; border:1px solid rgba(139,94,60,0.25); border-radius:8px;" /></td>
          </tr>
          <tr>
            <td>回测时长（年，可选）</td>
            <td><input id="bc-year-a" type="number" step="0.5" min="0.5" placeholder="如 14" style="width:100%; padding:8px 10px; border:1px solid rgba(139,94,60,0.25); border-radius:8px;" /></td>
            <td><input id="bc-year-b" type="number" step="0.5" min="0.5" placeholder="如 10" style="width:100%; padding:8px 10px; border:1px solid rgba(139,94,60,0.25); border-radius:8px;" /></td>
          </tr>
          <tr>
            <td>年化波动率（%，可选，算夏普）</td>
            <td><input id="bc-vol-a" type="number" step="0.5" min="0" placeholder="如 18" style="width:100%; padding:8px 10px; border:1px solid rgba(139,94,60,0.25); border-radius:8px;" /></td>
            <td><input id="bc-vol-b" type="number" step="0.5" min="0" placeholder="如 10" style="width:100%; padding:8px 10px; border:1px solid rgba(139,94,60,0.25); border-radius:8px;" /></td>
          </tr>
        </tbody>
      </table>
    </div>

    <button id="bc-run" class="btn btn-gold" style="width:100%;">开始对比 →</button>

    <div id="bc-result" style="display:none; margin-top: var(--sp-5); border-top: 1px solid rgba(139,94,60,0.15); padding-top: var(--sp-4);">
      <div class="table-wrap">
        <table class="data-table">
          <thead><tr><th>指标</th><th>策略 A</th><th>策略 B</th><th>参照：V35</th></tr></thead>
          <tbody id="bc-rows"></tbody>
        </table>
      </div>
      <div id="bc-verdict" class="callout" style="margin-top: var(--sp-4);">--</div>
    </div>
  </section>

  <section class="card" style="max-width: 860px; margin: var(--sp-5) auto 0;">
    <div class="section-head">
      <div class="section-kicker">Benchmarks · 松果参照锚</div>
      <h2 class="section-title">拿你的策略跟松果体系比</h2>
      <p class="section-sub">松果策略为 14 年真实回测（2012.04-2026.07，172 个月，含成本口径：佣金万2.5+印花税0.05%）。</p>
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>策略</th><th>年化</th><th>最大回撤</th><th>Calmar</th><th>说明</th></tr></thead>
        <tbody>
          {
            bench.map((b) => (
              <tr>
                <td>{b.name}</td>
                <td class="pos">+{b.ar}%</td>
                <td class="neg">-{b.mdd}%</td>
                <td>{b.calmar}</td>
                <td style="color: var(--navy-600); font-size: 13px;">{b.note}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="callout warn" style="margin-top: var(--sp-4);">
      <b>看懂 Calmar</b>：每承受 1% 回撤换来多少年化。Calmar &gt; 1 属于"风险调整后合格"（V35 = 1.45）；
      沪深300 只有 0.10——高收益容易，低回撤高收益才是体系。历史回测不代表未来收益。
    </div>
  </section>

  <div class="callout" style="max-width: 860px; margin: var(--sp-4) auto 0;">
      <b>口径</b>：Calmar = 年化 / |MDD|；夏普（简化）= (年化 − 无风险利率 2%) / 年化波动率（需填波动率）。
      本工具为方法论演示，<b>不构成投资建议</b>。投资有风险，入市需谨慎。
    </div>

    <!-- 自身特色卡（常规做法 vs 松果，不点名） -->
    <section class="card" style="max-width: 860px; margin: var(--sp-5) auto 0;">
      <div class="section-head">
        <div class="section-kicker">基准对比 · 同类工具</div>
        <h2 class="section-title">和市面上的"回测工具"对比，我们的特色是什么</h2>
        <p class="section-sub">专业回测工具给你强大的计算引擎和一条曲线，剩下的判断还是你自己的。松果把这件事拆开做：<b>门槛降到 4 个数字、结论直接给出、还带体系参照锚</b>。</p>
      </div>
      <div class="table-wrap">
        <table class="data-table wrap-cells">
          <thead><tr><th></th><th>常规做法</th><th class="songguo-col">松果回测验证</th></tr></thead>
          <tbody>
            <tr><td><b>输入门槛</b></td><td>要会编程或会写策略，学习成本高</td><td class="songguo-col"><b>填 4 个数字即出结论</b>：年化、最大回撤、时长、波动率——不写一行代码</td></tr>
            <tr><td><b>给你什么</b></td><td>一条回测曲线，好坏自己看</td><td class="songguo-col"><b>风险调整后直接分胜负</b>：Calmar / 夏普 / 终值三个口径，谁优谁劣 30 秒见分晓</td></tr>
            <tr><td><b>参照系</b></td><td>只有你的策略孤零零一条线</td><td class="songguo-col"><b>内置松果 V35 体系参照锚</b>：你的策略放到 14 年实盘口径旁边比，高下立判</td></tr>
            <tr><td><b>口径透明</b></td><td>指标怎么算的不展示</td><td class="songguo-col"><b>公式写在页面上</b>：每个指标怎么算的、无风险利率取多少，全部可见可复算</td></tr>
            <tr><td><b>适合谁</b></td><td>量化研究员、有策略经验的进阶用户</td><td class="songguo-col"><b>想知道"我这个比率靠不靠谱"的任何人</b></td></tr>
          </tbody>
        </table>
      </div>
    </section>

  <script>
    function run() {
      const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
      const nameA = ($('bc-name-a').value || '策略 A').trim();
      const nameB = ($('bc-name-b').value || '策略 B').trim();
      const arA = parseFloat($('bc-ar-a').value), mddA = parseFloat($('bc-mdd-a').value);
      const arB = parseFloat($('bc-ar-b').value), mddB = parseFloat($('bc-mdd-b').value);
      const yA = parseFloat($('bc-year-a').value), yB = parseFloat($('bc-year-b').value);
      const vA = parseFloat($('bc-vol-a').value), vB = parseFloat($('bc-vol-b').value);
      const miss: string[] = [];
      if (!(arA >= -50)) miss.push('A 年化'); if (!(mddA >= 0)) miss.push('A 回撤');
      if (!(arB >= -50)) miss.push('B 年化'); if (!(mddB >= 0)) miss.push('B 回撤');
      if (miss.length) { alert('请填写：' + miss.join('、')); return; }

      const calc = (ar: number, mdd: number, years: number, vol: number) => {
        const calmar = mdd > 0 ? ar / mdd : 0;
        const sharpe = vol > 0 ? (ar - 2) / vol : null; // 无风险 2%
        const n = years > 0 ? years : 10;
        const final10 = Math.pow(1 + ar / 100, n) * 100000;
        return { calmar, sharpe, final10, n };
      };
      const a = calc(arA, mddA, yA, vA), b = calc(arB, mddB, yB, vB);
      const fmtNum = (v: number, d = 2) => v.toFixed(d);
      const fmtWan = (v: number) => (v / 10000).toFixed(1) + ' 万';
      const bold = (v: string, cond: boolean) => cond ? `<b style="color:var(--green);">${v}</b>` : v;

      const rows: Array<[string, string, string, string]> = [
        ['年化收益率', `+${arA}%`, `+${arB}%`, '+32.96%'],
        ['最大回撤', `-${mddA}%`, `-${mddB}%`, '-22.66%'],
        ['Calmar（年化/回撤）', fmtNum(a.calmar), fmtNum(b.calmar), '1.07'],
      ];
      let html = rows.map((r, i) => {
        if (i === 2) return `<tr><td>${r[0]}</td><td>${bold(r[1], a.calmar > b.calmar)}</td><td>${bold(r[2], b.calmar > a.calmar)}</td><td>${r[3]}</td></tr>`;
        return `<tr><td>${r[0]}</td><td>${r[1]}</td><td>${r[2]}</td><td>${r[3]}</td></tr>`;
      }).join('');
      if (a.sharpe !== null || b.sharpe !== null) {
        html += `<tr><td>夏普（简化，无风险2%）</td><td>${a.sharpe !== null ? fmtNum(a.sharpe) : '—'}</td><td>${b.sharpe !== null ? fmtNum(b.sharpe) : '—'}</td><td>—</td></tr>`;
      }
      html += `<tr><td>10 万本金 × ${a.n} 年复利终值</td><td>${fmtWan(a.final10)}</td><td>${fmtWan(b.final10)}</td><td>—</td></tr>`;
      ($('bc-rows') as HTMLElement).innerHTML = html;

      // 结论
      const lines: string[] = [];
      if (a.calmar > b.calmar) {
        lines.push(`<b>${nameA}</b> 的 Calmar（${fmtNum(a.calmar)}）高于 <b>${nameB}</b>（${fmtNum(b.calmar)}）——每承受 1% 回撤换来的年化更多，风险调整后更优。`);
      } else if (b.calmar > a.calmar) {
        lines.push(`<b>${nameB}</b> 的 Calmar（${fmtNum(b.calmar)}）高于 <b>${nameA}</b>（${fmtNum(a.calmar)}）——每承受 1% 回撤换来的年化更多，风险调整后更优。`);
      } else {
        lines.push('两者 Calmar 相同——风险调整后性价比打平，看谁更符合你的资金属性（回撤容忍度）。');
      }
      if (a.calmar >= 1.45 && b.calmar < 1.45) lines.push(`<b>${nameA}</b> 的 Calmar 达到松果 V35 水平（1.45），风险调整后达标。`);
      else if (b.calmar >= 1.45 && a.calmar < 1.45) lines.push(`<b>${nameB}</b> 的 Calmar 达到松果 V35 水平（1.45），风险调整后达标。`);
      else if (a.calmar < 1.45 && b.calmar < 1.45) lines.push('两者均未达 V35 的 Calmar（1.45）——注意回撤控制是体系的胜负手。');
      else lines.push('两者均达到 V35 的 Calmar（1.45）——回撤控制都合格。');
      if (a.sharpe !== null && b.sharpe !== null) {
        lines.push(`夏普：${nameA} ${fmtNum(a.sharpe)} vs ${nameB} ${fmtNum(b.sharpe)}（每单位波动获得的超额收益）。`);
      }
      lines.push('<span style="color:var(--navy-600); font-size:13px;">输入参数为你自填的历史/假设数据，对比结果仅用于方法论演示，不构成投资建议。</span>');
      ($('bc-verdict') as HTMLElement).innerHTML = '<b>对比结论</b>：' + lines.join(' ');
      ($('bc-result') as HTMLElement).style.display = 'block';
    }
    document.getElementById('bc-run')?.addEventListener('click', run);
  </script>

<style>
  /* 长文字表格（特色卡）：允许换行，消除横向滚动条 */
  .wrap-cells th,
  .wrap-cells td {
    white-space: normal;
    text-align: left;
    line-height: 1.6;
  }
</style>
</Layout>

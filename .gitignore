# 依赖
node_modules/

# 构建产物（部署由 GitHub Actions 构建，不入库）
dist/
.astro/

# 日志
*.log
npm-debug.log*

# 系统文件
.DS_Store
Thumbs.db

# 本地环境
.env
.env.*
screenshots/_profile_*
screenshots/*.png
screenshots/

# 本地模拟产物（serve-local.sh 生成，不入库）
_local_sim/

# V4 验收临时 profile
screenshots/v4/_profile*
backend/.env
backend/venv/
backend/__pycache__/

# 例外：样例文件要入库（真实 .env 仍然忽略）
!backend/.env.example

# 后端临时产物（打分卡验证/演示/调试输出，不入库）
backend/_v3_out/
backend/_verify_out/
backend/_validate_out/
backend/*.log
backend/.venv/
backend/scripts/__pycache__/

# 部署暂存目录（deploy.sh 用，2026-10-18）
.deploy_tmp/

# 打分卡运行期缓存（15MB 级，服务端生成，不入库）
backend/data/universe_cache.json
backend/data/narrative/
backend/data/board_snapshots/
backend/data/collect_boards.log
_tmp/

# 打分卡三层运行期缓存（2026-10-20：可再生，不入库）
backend/data/deep/
backend/data/summary/
backend/data/research/
backend/data/industry/
# 注意：backend/data/industry_taxonomy.json 是静态分类表，需要入库，勿被上面规则误伤
!backend/data/industry_taxonomy.json

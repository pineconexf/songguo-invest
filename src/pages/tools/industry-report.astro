---
import Layout from '../../layouts/Layout.astro';
import industry from '../../data/research_industry.json';

const fw = industry.framework;
const hot = industry.hot_sectors;
const ev = industry.events;
const warn = industry.warnings;
const mrep = industry.monthly_report;
// 雷达期号从 source 动态提取（雷达产线独立更新）
const radarMatch = (industry.source || '').match(/第\s*(\d+)\s*期/);
const radarIssue = radarMatch ? `第 ${radarMatch[1]} 期` : '最新一期';
---
<Layout
  title="行业研究报告"
  description="松果行业研究报告 — 六维研究框架（景气度/竞争格局/估值水位/政策催化/资金流向/风险边界），最近行业报告与月度要点。免费工具，不构成投资建议。"
>
  <section class="hero" style="padding: 56px 48px;">
    <div class="hero-inner">
      <span class="eyebrow">Research · 行业研究</span>
      <h1>
        一个行业，<br /><span class="gold">六个维度</span>看懂
      </h1>
      <p class="hero-lead">
        景气度、竞争格局、估值水位、政策催化、资金流向、风险边界——
        松果行业研究六维框架，让行业分析有章可循，不靠感觉。
      </p>
    </div>
  </section>

  <!-- 六维框架 -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Framework · 六维框架</div>
      <h2 class="section-title">{fw.name}</h2>
      <p class="section-sub">每一维都问一个核心问题、锚定一类数据——研究行业时逐维填空，不遗漏关键视角。</p>
    </div>
    <div class="metric-grid" style="grid-template-columns: repeat(3, 1fr);">
      {fw.dims.map((dim) => (
        <div class="metric-card" style="padding: 18px 16px; min-height: 120px;">
          <div class="label" style="font-size: 14px; color: var(--gold-700);">{dim.key}</div>
          <div style="font-size: 13px; color: var(--navy-800); margin: 8px 0 6px; line-height: 1.6;">{dim.q}</div>
          <div style="font-size: 12px; color: var(--text-3); line-height: 1.5;">锚定：{dim.data}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- 热点赛道 -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Radar · 本周行业雷达（{radarIssue}）</div>
      <h2 class="section-title">本周高热度赛道 TOP 5</h2>
      <p class="section-sub">来源：{industry.source}</p>
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>#</th><th>赛道</th><th>热度来源</th><th>触发逻辑</th></tr></thead>
        <tbody>
          {hot.map((h) => (
            <tr>
              <td>{h.rank}</td>
              <td><b>{h.name}</b></td>
              <td><span class="tool-type">{h.heat}</span></td>
              <td style="color: var(--navy-600);">{h.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- 触发事件 -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Events · 触发事件</div>
      <h2 class="section-title">本周触发事件（{ev.length} 条）</h2>
    </div>
    <div class="steps">
      {ev.map((e, i) => (
        <div class="step">
          <div class="num">{i + 1}</div>
          <div class="body">
            <h3>{e.title}</h3>
            <p>{e.detail}</p>
            <p style="font-size: 12.5px; color: var(--text-3); margin-top: 6px;">
              <b>性质</b>：{e.nature} ｜ <b>市场映射</b>：{e.mapping}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 月度要点 -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Monthly · 策略月报（{mrep.period}）</div>
      <h2 class="section-title">{mrep.period}市场与体系表现</h2>
      <p class="section-sub">{mrep.market}</p>
    </div>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th>资产/策略</th><th>当月</th><th>YTD</th><th>历史最大回撤</th><th>定位</th></tr></thead>
        <tbody>
          {mrep.assets.map((a) => (
            <tr>
              <td>{a.name}</td>
              <td class={a.jul.startsWith('+') ? 'pos' : 'neg'}>{a.jul}</td>
              <td class={a.ytd.startsWith('+') ? 'pos' : 'neg'}>{a.ytd}</td>
              <td class="neg">{a.mdd}</td>
              <td style="color: var(--navy-600);">{a.role}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="callout" style="margin-top: 14px;">
      <b>超额</b>：{mrep.excess}
    </div>
    <div class="callout warn" style="margin-top: 8px;">
      <b>信号</b>：{mrep.signal}
    </div>
    <div class="steps" style="margin-top: 14px;">
      {mrep.actions.map((a, i) => (
        <div class="step"><div class="num">{i + 1}</div><div class="body"><p style="margin:0;">{a}</p></div></div>
      ))}
    </div>
  </section>

  <!-- 报告生成器 -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Generator · 行业快报生成</div>
      <h2 class="section-title">行业研究报告生成器</h2>
      <p class="section-sub">输入行业名称，实时抓取该行业板块的真实行情、估值、资金流与龙头成分股，按六维框架生成一份可免费查看的行业研究报告。</p>
    </div>
    <div style="display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-bottom: var(--sp-4);">
      <input id="ir-industry" type="text" placeholder="输入行业，如：医疗研发外包 / 创新药 / 半导体 / 物流" style="flex: 1; min-width: 260px; padding: 12px 14px; border: 1px solid rgba(139,94,60,0.25); border-radius: 10px; font-size: 15px; background: var(--bg); color: var(--navy-900);" />
      <button id="ir-run" class="btn btn-gold">生成报告 →</button>
    </div>
    <div id="ir-hint" style="font-size: 12.5px; color: var(--text-3); margin-bottom: var(--sp-3);">
      数据来源于东方财富公开行情接口（实时板块级），生成时自动匹配行业板块。若无匹配，请换用更贴近板块的行业名。
    </div>
    <div id="ir-loading" style="display: none; padding: 20px; text-align: center; color: var(--text-3); font-size: 14px;">
      正在抓取真实行情数据…
    </div>
    <div id="ir-error" style="display: none; background: rgba(192,90,58,0.08); border: 1px solid rgba(192,90,58,0.3); border-radius: 10px; padding: 14px; font-size: 13.5px; color: #a03a28;"></div>
    <div id="ir-result" style="display: none;">
      <div id="ir-head" style="background: var(--surface-alt); border-radius: 10px; padding: 18px; margin-bottom: 12px;"></div>
      <div id="ir-outline" style="background: var(--surface-alt); border-radius: 10px; padding: 18px; line-height: 1.8; font-size: 14px;"></div>
      <div id="ir-gaps" style="margin-top: 12px; background: rgba(217,164,65,0.06); border: 1px solid rgba(217,164,65,0.25); border-radius: 10px; padding: 16px; font-size: 13.5px; line-height: 1.8;"></div>
    </div>
  </section>

  <!-- 预警 -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Watch · 下周预警</div>
      <h2 class="section-title">下周需要盯的变量</h2>
    </div>
    <div class="steps">
      {warn.map((w, i) => (
        <div class="step"><div class="num">{i + 1}</div><div class="body"><p style="margin:0;">{w}</p></div></div>
      ))}
    </div>
  </section>

  <script>
    // 行业研究报告生成器 V2（2026-09-14）：实时抓取东财板块级真实数据 → 六维快报
    // 数据源：push2delay.eastmoney.com JSONP（浏览器 script 注入绕 CORS，同体检卡/体检API模式，禁 fetch）
    var EM = {
      sec: 'https://push2delay.eastmoney.com/api/qt/clist/get',
      fields: 'f12,f14,f3,f6,f8,f9,f20,f62,f104,f105'
    };

    function jsonp(url) {
      return new Promise(function (resolve, reject) {
        var cb = 'ir_' + Date.now() + '_' + Math.floor(Math.random() * 1e4);
        var s = document.createElement('script');
        var to = setTimeout(function () { done(); reject(new Error('数据源响应超时')); }, 12000);
        function done() { clearTimeout(to); delete window[cb]; s.remove(); }
        window[cb] = function (d) { done(); resolve(d); };
        s.src = url + (url.indexOf('?') >= 0 ? '&' : '?') + 'cb=' + cb;
        s.onerror = function () { done(); reject(new Error('数据源不可达')); };
        document.head.appendChild(s);
      });
    }

    function fetchSectors() { // 496个板块，每页100，5页
      var all = [];
      function page(n) {
        return jsonp(EM.sec + '?pn=' + n + '&pz=100&po=1&fid=f3&fs=m:90+t:2&fields=' + EM.fields).then(function (d) {
          var rows = (d.data && d.data.diff) || [];
          if (Array.isArray(rows)) { all = all.concat(rows); }
          else { for (var k in rows) { all.push(rows[k]); } }
          var total = d.data && d.data.total || 0;
          if (n * 100 < total && n < 6) { return page(n + 1); }
        });
      }
      return page(1).then(function () { return all; });
    }

    function matchSector(name, list) {
      var clean = name.replace(/[行业板块概念]$|[（(].*?[）)]$/g, '').trim();
      function has(ch) { return list.filter(function (x) { return x.f14 && x.f14.indexOf(ch) >= 0; }); }
      var m = has(clean);
      if (!m.length && clean !== name) { m = has(name); }
      m.sort(function (a, b) { return (b.f20 || 0) - (a.f20 || 0); });
      return m[0] || null;
    }

    function fetchLeaders(code) {
      return jsonp(EM.sec + '?pn=1&pz=10&po=1&fid=f20&fs=b:' + code + '&fields=f12,f14,f3,f9,f20').then(function (d) {
        var rows = (d.data && d.data.diff) || [];
        rows = Array.isArray(rows) ? rows : Object.keys(rows).map(function (k) { return rows[k]; });
        return { rows: rows, total: (d.data && d.data.total) || rows.length };
      });
    }

    // 东财原始值换算（全部真实数值，禁止估算）
    function pct(v) { return v == null ? '—' : (v / 100).toFixed(2) + '%'; }
    function yi(v) { return v == null ? '—' : (v / 1e8).toFixed(1) + '亿'; }
    function num(v) { return v == null ? '—' : (v / 100).toFixed(2); }
    function peStr(v) { return !v ? '—（亏损/无PE）' : (v / 100).toFixed(1); }

    function esc(s) { return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }

    function nowStr() {
      var d = new Date(), p = function (x) { return (x < 10 ? '0' : '') + x; };
      return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + ' ' + p(d.getHours()) + ':' + p(d.getMinutes());
    }

    function render(sec, lead, indName) {
      var leaders = lead.rows || [], nMembers = lead.total || leaders.length;
      var up = sec.f104 || 0, down = sec.f105 || 0, flat = (up + down === 0) ? '—' : ((up / (up + down) * 100).toFixed(0) + '%');
      var flow = sec.f62 == null ? null : sec.f62;
      var flowStr = yi(flow), flowGood = flow != null && flow > 0;
      var mom = (sec.f3 > 0 && flowGood && up > down) ? '偏强' : (sec.f3 < 0 && !flowGood && up < down) ? '偏弱' : '分化';
      var rows = leaders.map(function (s, i) {
        return '<tr><td style="padding:4px 8px;color:var(--text-3);">' + (i + 1) + '</td><td style="padding:4px 8px;font-weight:600;">' + esc(s.f14) +
          '<span style="color:var(--text-3);font-size:11px;"> ' + esc(s.f12) + '</span></td><td style="padding:4px 8px;">' + (s.f3 == null ? '—' : pct(s.f3)) +
          '</td><td style="padding:4px 8px;">' + peStr(s.f9) + '</td><td style="padding:4px 8px;">' + yi(s.f20) + '</td></tr>';
      }).join('');
      document.getElementById('ir-head').innerHTML =
        '<div style="display:flex;gap:10px;flex-wrap:wrap;align-items:baseline;">' +
        '<b style="font-size:17px;">「' + esc(indName) + '」→ 匹配板块：' + esc(sec.f14) + '（' + esc(sec.f12) + '）</b>' +
        '<span style="font-size:12px;color:var(--text-3);">生成时间 ' + nowStr() + ' · 数据源：东方财富公开行情（实时）</span></div>' +
        '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px;margin-top:12px;font-size:13px;">' +
        '<div><div style="color:var(--text-3);font-size:11.5px;">当日涨跌幅</div><b style="color:' + (sec.f3 >= 0 ? '#4A7C59' : '#a03a28') + ';">' + pct(sec.f3) + '</b></div>' +
        '<div><div style="color:var(--text-3);font-size:11.5px;">成交额</div><b>' + yi(sec.f6) + '</b></div>' +
        '<div><div style="color:var(--text-3);font-size:11.5px;">换手率</div><b>' + num(sec.f8) + '%</b></div>' +
        '<div><div style="color:var(--text-3);font-size:11.5px;">板块PE(TTM)</div><b>' + peStr(sec.f9) + '</b></div>' +
        '<div><div style="color:var(--text-3);font-size:11.5px;">板块总市值</div><b>' + yi(sec.f20) + '</b></div>' +
        '<div><div style="color:var(--text-3);font-size:11.5px;">主力净流入</div><b style="color:' + (flowGood ? '#4A7C59' : '#a03a28') + ';">' + flowStr + '</b></div>' +
        '<div><div style="color:var(--text-3);font-size:11.5px;">涨/跌家数</div><b>' + up + ' / ' + down + '</b></div></div>';
      document.getElementById('ir-outline').innerHTML =
        '<b style="font-size:15px;">六维快报（基于上方实时数据）</b>' +
        '<table style="width:100%;border-collapse:collapse;margin-top:10px;font-size:13px;">' +
        '<tr style="text-align:left;color:var(--text-3);font-size:12px;"><th style="padding:4px 8px;">维度</th><th style="padding:4px 8px;">数据/判断</th><th style="padding:4px 8px;">状态</th></tr>' +
        '<tr style="border-top:1px solid rgba(139,94,60,0.15);"><td style="padding:5px 8px;font-weight:700;">资金流向</td><td style="padding:5px 8px;">主力净流入 <b>' + flowStr + '</b>；涨家占比 ' + flat + '</td><td style="padding:5px 8px;">' + (flowGood ? '资金流入' : '资金流出') + '</td></tr>' +
        '<tr style="border-top:1px solid rgba(139,94,60,0.15);"><td style="padding:5px 8px;font-weight:700;">估值水位</td><td style="padding:5px 8px;">板块PE(TTM) <b>' + peStr(sec.f9) + '</b>（历史分位需另行回验）</td><td style="padding:5px 8px;">实时锚点</td></tr>' +
        '<tr style="border-top:1px solid rgba(139,94,60,0.15);"><td style="padding:5px 8px;font-weight:700;">竞争格局</td><td style="padding:5px 8px;">成分股共 ' + nMembers + ' 只；前十大龙头见下表</td><td style="padding:5px 8px;">实时锚点</td></tr>' +
        '<tr style="border-top:1px solid rgba(139,94,60,0.15);"><td style="padding:5px 8px;font-weight:700;">综合动能</td><td style="padding:5px 8px;">涨跌' + pct(sec.f3) + ' × 资金' + (flowGood ? '流入' : '流出') + ' × 广度' + flat + ' → <b>' + mom + '</b></td><td style="padding:5px 8px;">信号合成</td></tr>' +
        '<tr style="border-top:1px solid rgba(139,94,60,0.15);"><td style="padding:5px 8px;font-weight:700;">景气度</td><td style="padding:5px 8px;color:var(--text-3);">需订单/开工/价格一手数据 → 见缺口清单</td><td style="padding:5px 8px;color:var(--text-3);">待调研</td></tr>' +
        '<tr style="border-top:1px solid rgba(139,94,60,0.15);"><td style="padding:5px 8px;font-weight:700;">政策催化</td><td style="padding:5px 8px;color:var(--text-3);">参考本页「每周行业雷达」政策事件流</td><td style="padding:5px 8px;color:var(--text-3);">见雷达</td></tr>' +
        '<tr style="border-top:1px solid rgba(139,94,60,0.15);"><td style="padding:5px 8px;font-weight:700;">风险边界</td><td style="padding:5px 8px;color:var(--text-3);">逻辑破坏条件需人工研判，框架：政策退坡/需求证伪/估值透支</td><td style="padding:5px 8px;color:var(--text-3);">待研判</td></tr>' +
        '</table>' +
        '<b style="font-size:15px;display:block;margin-top:16px;">龙头成分股 TOP' + leaders.length + '（按总市值）</b>' +
        '<table style="width:100%;border-collapse:collapse;margin-top:8px;font-size:13px;text-align:left;">' +
        '<tr style="color:var(--text-3);font-size:12px;"><th style="padding:4px 8px;"></th><th style="padding:4px 8px;">公司</th><th style="padding:4px 8px;">当日</th><th style="padding:4px 8px;">PE(TTM)</th><th style="padding:4px 8px;">总市值</th></tr>' + rows + '</table>' +
        '<p style="margin-top:12px;color:var(--text-3);font-size:12px;">写作结构：产业全景 → 六维逐项 → 结论与风险 → 数据来源附录。完整深度报告见「松果商业笔记」行业研究系列。</p>';
      document.getElementById('ir-gaps').innerHTML = '<b style="color:var(--gold-700);">数据缺口清单（需调研补齐）</b>' +
        '<ul style="margin:8px 0 0 18px; padding:0;">' +
        '<li>「' + esc(indName) + '」最新行业规模与增速（口径：协会/统计局）</li>' +
        '<li>板块 PE/PB 近 5-10 年历史分位（口径：tushare 等长序列数据）</li>' +
        '<li>近 3 个月板块资金流趋势与成交占比</li>' +
        '<li>最新政策文件原文与落地时间表</li>' +
        '<li>产业链上中下游代表公司与传导关系</li></ul>';
    }

    var run = document.getElementById('ir-run');
    var input = document.getElementById('ir-industry');
    function show(id, on) { var el = document.getElementById(id); if (el) el.style.display = on ? 'block' : 'none'; }

    function fail(msg) {
      show('ir-loading', false);
      var el = document.getElementById('ir-error');
      el.textContent = '⚠️ ' + msg; show('ir-error', true);
    }

    function go() {
      var ind = (input.value || '').trim();
      if (!ind) { alert('请先输入行业名称'); return; }
      show('ir-error', false); show('ir-result', false); show('ir-loading', true);
      fetchSectors().then(function (list) {
        var sec = matchSector(ind, list);
        if (!sec) {
          show('ir-loading', false);
          var near = list.filter(function (x) { return x.f14 && (x.f14.indexOf(ind.slice(0, 2)) >= 0); }).slice(0, 6).map(function (x) { return x.f14; });
          fail('未匹配到含「' + ind + '」的行业板块' + (near.length ? '。相近板块：' + near.join('、') + '，请换名重试。' : '，请换用更贴近板块的行业名。'));
          return;
        }
        return fetchLeaders(sec.f12).then(function (lead) {
          show('ir-loading', false);
          render(sec, lead, ind);
          show('ir-result', true);
        });
      })['catch'](function (e) { fail((e && e.message) || '生成失败，请稍后重试'); });
    }

    run?.addEventListener('click', go);
    input?.addEventListener('keydown', (e) => { if (e.key === 'Enter') go(); });
  </script>

  <div class="callout">
    <b>数据说明</b>：行业雷达为每周生成（{industry.source}），全部事件来自公开政策/新闻检索，标注出处。
    完整六维报告由「松果商业笔记」公众号发布，此处同步目录与要点。
  </div>
  <div class="callout warn">
    ⚠️ <b>合规</b>：研究展示不构成投资建议。行业热度不等于买入信号，需结合估值与个人风险承受力。
  </div>
</Layout>

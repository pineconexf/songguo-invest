---
import Layout from '../layouts/Layout.astro';
import Chart from '../components/Chart.astro';
import strategy from '../data/strategy.json';

const v31 = strategy.meta.v31;
const hs300 = strategy.meta.hs300;
const GOLD = '#c8a24b';
const GRAY = '#9ca3af';

const navMonths = strategy.nav.months.map((ym: string) => `${ym.slice(0, 4)}-${ym.slice(4)}`);

const navOption = {
  tooltip: {
    trigger: 'axis',
    valueFormatter: (v: number | null) => (v == null ? '-' : `${(v as number).toFixed(2)} 倍`),
  },
  legend: { data: ['V31 基金版', '沪深300'], top: 0, textStyle: { color: '#555' } },
  grid: { left: 56, right: 20, top: 42, bottom: 52 },
  xAxis: {
    type: 'category',
    data: navMonths,
    boundaryGap: false,
    axisLabel: { interval: 23, color: '#888' },
  },
  yAxis: {
    type: 'value',
    name: '净值（倍数）',
    nameTextStyle: { color: '#888' },
    scale: true,
    axisLabel: { color: '#888' },
    splitLine: { lineStyle: { color: '#eef0f5' } },
  },
  dataZoom: [
    { type: 'inside', start: 0, end: 100 },
    { type: 'slider', height: 16, bottom: 8, start: 0, end: 100 },
  ],
  series: [
    {
      name: 'V31 基金版',
      type: 'line',
      data: strategy.nav.v31,
      smooth: true,
      symbol: 'none',
      lineStyle: { width: 2.5, color: GOLD },
      areaStyle: { opacity: 0.08, color: GOLD },
    },
    {
      name: '沪深300',
      type: 'line',
      data: strategy.nav.hs300,
      smooth: true,
      symbol: 'none',
      lineStyle: { width: 1.5, color: GRAY, type: 'dashed' },
    },
  ],
};
---
<Layout title="首页" description="松果投资体系 — 14年真实回测验证的A股价值投资方法论展示">
  <section class="hero">
    <h1>用 <span class="gold">14 年真实回测</span> 说话的价值投资体系</h1>
    <p>
      一套「好公司、便宜买、极端风险离场」的 A 股投资方法论：2012.04 - 2026.07 共 172 个月历史回测，
      年化收益率 <b>+24.3%</b>，同期沪深300 年化仅 +3.97%。数据为历史回测展示，不构成投资建议。
    </p>
    <span class="tagline">数据驱动 · 纪律执行 · 长期主义</span>
  </section>

  <section class="metric-grid">
    <div class="metric-card">
      <div class="label">14 年年化收益率</div>
      <div class="value gold">+24.30%</div>
      <div class="sub">同期沪深300：+3.97%</div>
    </div>
    <div class="metric-card">
      <div class="label">最大回撤</div>
      <div class="value red">-22.66%</div>
      <div class="sub">沪深300 同期 -40.56%</div>
    </div>
    <div class="metric-card">
      <div class="label">风险调整收益（Calmar）</div>
      <div class="value green">1.07</div>
      <div class="sub">年化 ÷ 最大回撤</div>
    </div>
    <div class="metric-card">
      <div class="label">14 年累计收益</div>
      <div class="value gold">+2159.6%</div>
      <div class="sub">约 22.6 倍（含成本口径）</div>
    </div>
  </section>

  <section class="card">
    <h2 class="section-title">14 年净值曲线（V31 基金版 vs 沪深300）</h2>
    <p class="section-sub">
      起点 1.00，金色为策略净值，灰色虚线为同期沪深300。两者累计收益相差约 20 倍——超额主要来自选股 alpha 与空仓保险。
    </p>
    <Chart option={navOption} height="440px" />
  </section>

  <section class="card">
    <h2 class="section-title">这套体系是什么</h2>
    <div class="link-cards">
      <a href="/methodology/" class="link-card">
        <h3><span class="gold">方法论</span> · 三步走</h3>
        <p>11 步筛选好公司 → 双因子找便宜 → 空仓保险躲股灾。小白也能看懂的投资逻辑。</p>
      </a>
      <a href="/backtest/" class="link-card">
        <h3><span class="gold">回测验证</span> · 数据透明</h3>
        <p>14 年逐月净值、年度收益、回撤全景，全部数据可复现、经审计、含成本。</p>
      </a>
      <a href="/ranking/" class="link-card">
        <h3><span class="gold">月度榜单</span> · 方法论展示</h3>
        <p>策略月度收益 vs 沪深300 逐月对比。展示方法论运行轨迹，不构成任何推荐。</p>
      </a>
    </div>
  </section>

  <section class="card">
    <h2 class="section-title">关于版本</h2>
    <p class="section-sub">
      同一套选股逻辑的两个执行版本：无杠杆的「基金版」面向稳健配置场景；含融资杠杆的「进阶版」面向能承受更高波动的专业场景。本页展示基金版，进阶版数据作为研究参考后续开放。
    </p>
    <table class="data-table">
      <thead>
        <tr>
          <th>版本</th>
          <th>杠杆</th>
          <th>年化</th>
          <th>最大回撤</th>
          <th>Calmar</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>V31 基金版（本页主展示）</td>
          <td>无</td>
          <td class="pos">+24.30%</td>
          <td class="neg">-22.66%</td>
          <td>1.07</td>
        </tr>
        <tr>
          <td>V32 进阶版（杠杆研究参考）</td>
          <td>1.5x 融资</td>
          <td class="pos">+34.71%</td>
          <td class="neg">-33.65%</td>
          <td>1.03</td>
        </tr>
      </tbody>
    </table>
  </section>

  <div class="callout">
    ⚠️ <b>免责声明</b>：本站全部数据为历史回测结果（含成本口径），非实盘业绩，不代表未来收益，不构成任何投资建议，亦不构成对任何证券或产品的推荐。投资有风险，入市需谨慎。
  </div>

  <script>
    import '../scripts/charts.ts';
  </script>
</Layout>

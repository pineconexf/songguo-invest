---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '松果投资体系 — 14年真实回测验证的 A 股价值投资方法论展示' } = Astro.props;
const current = Astro.url.pathname;

const navItems = [
  { href: '/', label: '首页' },
  { href: '/methodology/', label: '方法论' },
  { href: '/backtest/', label: '回测验证' },
  { href: '/ranking/', label: '月度榜单' },
  { href: '/about/', label: '合规声明' },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · 松果投资体系</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
  </head>
  <body>
    <header class="site-header">
      <nav class="nav container">
        <a href="/" class="brand">🐿️ <span class="gold">松果</span>投资体系</a>
        <div class="nav-links">
          {
            navItems.map((item) => (
              <a
                href={item.href}
                class:list={['nav-link', { active: current === item.href }]}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </nav>
    </header>

    <main class="container main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="disclaimer">
          本网站为投资方法论的历史回测研究展示，数据为 2012-2026 年 172 个月回测结果（含成本口径），
          历史表现不代表未来收益，不构成任何投资建议，亦不构成对任何产品的推荐。
        </p>
        <p>© 2026 松果商业笔记 · 数据驱动 · 纪律执行 · 长期主义</p>
      </div>
    </footer>
  </body>
</html>

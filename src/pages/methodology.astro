---
import Layout from '../layouts/Layout.astro';

const layers = [
  {
    index: '01',
    name: '宏观层',
    en: 'Macro',
    desc: '宏观时钟六轴评分体系，从流动性、增长、通胀、政策、估值、情绪六个维度刻画市场状态。',
    detail: '判断大势方向，决定仓位进攻或防守。V1 常规版：Shibor 信号 × 中证500，5bp 阈值样本外验证。',
    tag: '决定仓位',
  },
  {
    index: '02',
    name: '行业层',
    en: 'Industry',
    desc: '行业因子筛选体系，从景气度、估值、资金流、政策催化四个维度给行业打分。',
    detail: '识别景气赛道，避开衰退行业。行业轮动捕捉结构性机会，是宏观到个股的桥梁。',
    tag: '决定赛道',
  },
  {
    index: '03',
    name: '个股层',
    en: 'Stock',
    desc: '三步选股：11 步筛选好公司（ROE、现金流、护城河）→ 双因子找便宜（价值+质量）→ 空仓保险躲股灾。',
    detail: 'V31 基金版：Top4 选股 + FCF/EV 排名加权，14 年回测验证。',
    tag: '决定标的',
  },
  {
    index: '04',
    name: '组合层',
    en: 'Portfolio',
    desc: '宏观 V1 × 个股 V31 融合：宏观管仓位、个股管选股，节奏错开。',
    detail: '两个引擎一个进攻一个防守（相关性仅 0.35），管理回撤不靠预测、靠配置。',
    tag: '决定风险',
  },
];
---
<Layout
  title="四层体系"
  description="松果投资体系四层架构 — 宏观 → 行业 → 个股 → 组合，每一层独立可验证，层间协同形成闭环。"
>
  <!-- Hero -->
  <section class="hero" style="padding: 56px 48px;">
    <div class="hero-inner">
      <span class="eyebrow">Framework · 体系架构</span>
      <h1>
        四层架构，<span class="gold">一层不落</span><br />的投资决策链
      </h1>
      <p class="hero-lead">
        从宏观大势到个股选择，松果体系把投资决策拆成四个可独立验证的层次。
        每一层都有明确的输入、规则和输出——不靠感觉，靠体系。
      </p>
    </div>
  </section>

  <!-- 四层架构 -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Four Layers</div>
      <h2 class="section-title">从宏观到个股的完整决策链</h2>
      <p class="section-sub">
        四层不是孤立的模块，而是层层传导的决策链：宏观决定仓位 → 行业决定赛道 → 个股决定标的 → 组合决定风险。
      </p>
    </div>
    <div class="layer-stack">
      {
        layers.map((l) => (
          <div class="layer" style="cursor: default;">
            <span class="layer-index">{l.index}</span>
            <div style="flex:1;">
              <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                <span class="layer-name" style="min-width:auto;">{l.name}</span>
                <span style="font-size:12px; color:var(--text-3); letter-spacing:1px;">{l.en}</span>
              </div>
              <div class="layer-desc" style="margin-top:6px;">{l.desc}</div>
              <div style="font-size:13px; color:var(--text-2); margin-top:6px; border-left:2px solid var(--gold-500); padding-left:10px;">
                {l.detail}
              </div>
            </div>
            <span class="layer-tag">{l.tag}</span>
          </div>
        ))
      }
    </div>
  </section>

  <!-- 融合逻辑 -->
  <section class="card">
    <div class="section-head">
      <div class="section-kicker">Integration</div>
      <h2 class="section-title">四层如何协同</h2>
    </div>
    <div class="link-cards" style="grid-template-columns: repeat(3, 1fr);">
      <div class="link-card" style="cursor: default;">
        <h3><span class="gold">顶层设计</span></h3>
        <p>宏观时钟给出仓位信号：宽松→进攻、收紧→防守。先决定"做不做"，再决定"做什么"。</p>
      </div>
      <div class="link-card" style="cursor: default;">
        <h3><span class="gold">中层传导</span></h3>
        <p>行业因子在大势允许的范围内选赛道，把宏观判断落到具体行业，避免空转。</p>
      </div>
      <div class="link-card" style="cursor: default;">
        <h3><span class="gold">底层落地</span></h3>
        <p>个股筛选在选中赛道内挑标的，组合层把仓位、风险、回撤管理到可承受范围。</p>
      </div>
    </div>
    <div class="callout" style="margin-top: 24px;">
      <b>核心洞察</b>：宏观信号不能直接指挥个股仓位——利率收紧时好公司照样涨。
      正确做法是把钱分开、各跑各的：宏观管仓位，个股管选股，组合管风险。
    </div>
  </section>

  <!-- CTA -->
  <section class="card" style="text-align:center; padding: 48px;">
    <h2 class="section-title" style="border:none; padding:0; margin-bottom:12px;">每一层，都有数据验证</h2>
    <p class="section-sub" style="margin: 0 auto 24px; max-width: 560px;">
      不是纸上的理论框架，而是 14 年、172 个月、含成本的真实回测。
    </p>
    <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
      <a href="/backtest/" class="btn btn-gold">查看回测数据 →</a>
      <a href="/macro/" class="btn btn-ghost" style="background:var(--navy-800); color:#fff;">宏观研究</a>
    </div>
  </section>
</Layout>
